---
import { ArrowLeft, ChevronDown, CircleCheck } from "@lucide/astro";

interface Props {
	courseId: string;
	courseTitle: string;
	lessons: Array<{ id: string; title: string; href: string }>;
	currentId: string;
}

const { courseId, courseTitle, lessons, currentId } = Astro.props;
const progressStorageKey = `emtech:course-progress:${courseId}`;
const currentLesson = lessons.find(lesson => lesson.id === currentId);
const lessonListId = `course-lesson-list-${courseId}`;
---

<aside class="course-sidebar" data-course-progress-key={progressStorageKey}>
	<div class="sidebar-head">
		<a class="back-link" href={`/course/${courseId}/`}>
			<ArrowLeft size={15} stroke-width={1.8} aria-hidden="true" />
			<span class="back-label">Back to course overview</span>
			<span class="back-label-short">Back</span>
		</a>
		<button class="course-toggle" type="button" aria-expanded="false" aria-controls={lessonListId} data-course-sidebar-toggle>
			<span>{courseTitle}</span>
			<strong>{currentLesson?.title ?? "課程列表"}</strong>
			<ChevronDown size={16} stroke-width={1.8} aria-hidden="true" />
		</button>
	</div>
	<div class="course-list-panel" id={lessonListId} data-course-sidebar-panel>
		<nav aria-label="課程章節">
			{
				lessons.map((lesson, i) => {
					const isActive = lesson.id === currentId;
					const number = String(i + 1).padStart(2, "0");
					return (
						<a class:list={[{ active: isActive }]} href={lesson.href} data-lesson-id={lesson.id} aria-current={isActive ? "page" : undefined}>
							<span>{number}</span>
							{lesson.title}
							<CircleCheck size={15} stroke-width={1.8} aria-hidden="true" />
						</a>
					);
				})
			}
		</nav>
	</div>
</aside>

<script>
	import { setupPageLifecycle } from "@/scripts/pageLifecycle";

	setupPageLifecycle("course-sidebar", () => {
		const sidebar = document.querySelector<HTMLElement>("[data-course-progress-key]");
		if (!sidebar) return;

		const controller = new AbortController();
		const { signal } = controller;
		const progressKey = sidebar.dataset.courseProgressKey;
		const lessonLinks = Array.from(sidebar.querySelectorAll<HTMLAnchorElement>("[data-lesson-id]"));
		const courseToggle = sidebar.querySelector<HTMLButtonElement>("[data-course-sidebar-toggle]");
		const coursePanel = sidebar.querySelector<HTMLElement>("[data-course-sidebar-panel]");
		const collapsibleSidebar = window.matchMedia("(max-width: 76rem)");

		const parseProgress = (value: string | null) => {
			if (!value) return [];
			try {
				const parsed = JSON.parse(value);
				return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === "string") : [];
			} catch {
				return [];
			}
		};

		const renderProgress = (completed: string[]) => {
			const completedSet = new Set(completed);
			for (const link of lessonLinks) {
				link.classList.toggle("completed", completedSet.has(link.dataset.lessonId ?? ""));
			}
		};

		if (progressKey) {
			renderProgress(parseProgress(window.localStorage.getItem(progressKey)));
			window.addEventListener(
				"emtech:course-progress",
				event => {
					const detail = (event as CustomEvent<{ storageKey?: string; completed?: string[] }>).detail;
					if (detail?.storageKey === progressKey && Array.isArray(detail.completed)) renderProgress(detail.completed);
				},
				{ signal }
			);
		}

		if (courseToggle && coursePanel) {
			const setSidebarOpen = (isOpen: boolean) => {
				sidebar.classList.toggle("is-open", isOpen);
				courseToggle.setAttribute("aria-expanded", String(isOpen));
				const hidePanel = collapsibleSidebar.matches && !isOpen;
				coursePanel.toggleAttribute("inert", hidePanel);
				coursePanel.setAttribute("aria-hidden", String(hidePanel));
			};

			sidebar.classList.add("is-collapsible");
			setSidebarOpen(false);
			courseToggle.addEventListener("click", () => setSidebarOpen(!sidebar.classList.contains("is-open")), { signal });
			collapsibleSidebar.addEventListener("change", () => setSidebarOpen(sidebar.classList.contains("is-open")), { signal });
		}

		return () => controller.abort();
	});
</script>

<style>
	.course-sidebar {
		position: sticky;
		top: 4rem;
		align-self: start;
		padding: 1.75rem 1.5rem;
		background: var(--color-surface-glass-soft);
		border: 1px solid var(--color-border);
		border-top: none;
		height: calc(100dvh - 4rem);
		overflow-y: auto;
	}

	.sidebar-head {
		display: block;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	.course-toggle {
		display: none;
	}

	.back-label-short {
		display: none;
	}

	nav {
		display: grid;
	}

	nav a {
		display: grid;
		grid-template-columns: 1.75rem 1fr auto;
		align-items: center;
		gap: 0.5rem;
		min-height: 3rem;
		padding: 0.75rem 0;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-muted);
		border-top: 1px solid var(--color-border);
		line-height: 1.5;
	}

	nav a.active {
		color: var(--color-accent-strong);
	}

	nav a span {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	nav a svg {
		display: none;
		color: var(--color-accent-strong);
	}

	nav a.completed svg {
		display: block;
	}

	@media (max-width: 76rem) {
		.course-sidebar {
			position: sticky;
			top: 4rem;
			z-index: 10;
			height: auto;
			max-height: none;
			padding: 0;
			overflow: hidden;
			backdrop-filter: blur(1rem);
			width: calc(100% + 6rem);
			margin: 0 -3rem;
		}

		.sidebar-head {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			align-items: stretch;
			min-height: 3.75rem;
		}

		.back-link {
			justify-content: center;
			min-width: 4.25rem;
			margin: 0;
			padding-inline: 1rem;
			border-right: 1px solid var(--color-border);
		}

		.back-label {
			display: none;
		}

		.back-label-short {
			display: inline;
		}

		.course-toggle {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			align-content: center;
			align-items: center;
			gap: 0.2rem 0.75rem;
			min-width: 0;
			padding: 0.65rem 1rem;
			color: var(--color-ink);
			text-align: left;
			background: transparent;
			border: 0;
		}

		.course-toggle span {
			font-family: var(--font-mono);
			font-size: 0.7rem;
			font-weight: 800;
			letter-spacing: 0.08em;
			color: var(--color-muted);
			text-transform: uppercase;
			white-space: nowrap;
		}

		.course-toggle strong {
			overflow-wrap: anywhere;
			font-size: 0.95rem;
			line-height: 1.2;
		}

		.course-toggle svg {
			grid-row: 1 / span 2;
			grid-column: 2;
			color: var(--color-accent-strong);
			transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
		}

		.course-sidebar.is-open .course-toggle svg {
			transform: rotate(180deg);
		}

		.course-list-panel {
			max-height: 18rem;
			overflow-y: auto;
			border-top: 1px solid var(--color-border);
		}

		.course-sidebar.is-collapsible .course-list-panel {
			max-height: 0;
			overflow: hidden;
			border-top-color: transparent;
			transition:
				max-height 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
				border-color 180ms ease;
		}

		.course-sidebar.is-collapsible.is-open .course-list-panel {
			max-height: min(62dvh, 24rem);
			overflow-y: auto;
			border-top-color: var(--color-border);
		}

		nav {
			padding: 0 1rem 0.75rem;
		}
	}

	@media (max-width: 40rem) {
		.course-sidebar {
			padding: 0;
			width: calc(100% + 2rem);
			margin: 0 -1rem;
		}

		nav a {
			grid-template-columns: 1.5rem minmax(0, 1fr) auto;
		}
	}
</style>
