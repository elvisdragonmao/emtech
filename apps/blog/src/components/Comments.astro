---
import { LogOut, Send } from "@lucide/astro";
import { siGithub } from "simple-icons";
import SimpleIcon from "@/components/shared/SimpleIcon.astro";

interface Props {
	pagePath?: string;
}

const { pagePath = Astro.url.pathname } = Astro.props;
const commentApiBaseUrl = (import.meta.env.COMMENT_API_BASE_URL ?? import.meta.env.PUBLIC_COMMENT_API_BASE_URL ?? "https://api.emtech.cc").replace(/\/$/, "");
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY ?? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<section id="comments" class="comments" data-comments-root data-page-path={pagePath} data-api-base={commentApiBaseUrl} data-turnstile-site-key={turnstileSiteKey}>
	<div class="comments-heading">
		<div>
			<p class="eyebrow">留言</p>
			<h2>留言區</h2>
		</div>
		<a class="github-login" data-github-login href={`${commentApiBaseUrl}/api/auth/github/start?returnTo=${encodeURIComponent(`${pagePath}#comments`)}`}>
			<SimpleIcon icon={siGithub} size={16} />
			GitHub 登入
		</a>
	</div>

	<div class="auth-panel" data-auth-panel hidden>
		<span data-auth-name></span>
		<button type="button" data-logout>
			<LogOut size={14} stroke-width={1.8} aria-hidden="true" />
			登出
		</button>
	</div>

	<div class="notice" data-notice role="status" aria-live="polite" hidden></div>

	<div class="form-host" data-form-host>
		<form class="comment-form" data-comment-form>
			<input type="hidden" name="parentId" data-parent-id />
			<div class="replying" data-replying hidden>
				<span data-replying-label></span>
				<button type="button" data-cancel-reply>取消回覆</button>
			</div>
			<label data-identity-field>
				顯示名稱
				<input name="name" type="text" maxlength="80" autocomplete="name" placeholder="匿名" />
			</label>
			<label data-identity-field>
				電子郵件
				<input name="email" type="email" autocomplete="email" spellcheck="false" placeholder="只用於 Gravatar 頭像，不會公開" />
			</label>
			<label class="message">
				留言
				<textarea name="body" rows="5" maxlength="3000" required placeholder="寫下你的想法"></textarea>
			</label>
			{
				turnstileSiteKey && (
					<div class="turnstile-field">
						<p>安全驗證</p>
						<div class="turnstile cf-turnstile" data-sitekey={turnstileSiteKey} aria-label="Cloudflare Turnstile 安全驗證" />
					</div>
				)
			}
			<div class="actions">
				<button type="submit">
					<Send size={14} stroke-width={1.8} aria-hidden="true" />
					送出留言
				</button>
			</div>
		</form>
	</div>

	<div class="comment-list" data-comment-list aria-live="polite"></div>
</section>

<script>
	import { setupPageLifecycle } from "@/scripts/pageLifecycle";

	type TurnstileApi = {
		render: (container: HTMLElement, options: { sitekey: string }) => string;
		reset: (widgetId?: string) => void;
		remove?: (widgetId?: string) => void;
	};

	type PublicComment = {
		id: string;
		pagePath: string;
		parentId: string | null;
		body: string;
		author: {
			type: "anonymous" | "named" | "gravatar" | "github";
			name: string;
			avatarUrl: string | null;
		};
		meta: {
			device: string | null;
			browser: string | null;
			location: string | null;
		};
		createdAt: string;
	};

	setupPageLifecycle("comments", () => {
		const root = document.querySelector<HTMLElement>("[data-comments-root]");
		if (!root) return;

		const controller = new AbortController();
		const { signal } = controller;
		const configuredApiBase = root.dataset.apiBase ?? "";
		const isLocalPage = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
		const apiBase = isLocalPage && configuredApiBase === "https://api.emtech.cc" ? `${window.location.protocol}//${window.location.hostname}:8787` : configuredApiBase;
		const pagePath = root.dataset.pagePath ?? location.pathname;
		const form = root.querySelector<HTMLFormElement>("[data-comment-form]");
		const formHost = root.querySelector<HTMLElement>("[data-form-host]");
		const list = root.querySelector<HTMLElement>("[data-comment-list]");
		const notice = root.querySelector<HTMLElement>("[data-notice]");
		const authPanel = root.querySelector<HTMLElement>("[data-auth-panel]");
		const authName = root.querySelector<HTMLElement>("[data-auth-name]");
		const loginLink = root.querySelector<HTMLAnchorElement>("[data-github-login]");
		const logoutButton = root.querySelector<HTMLButtonElement>("[data-logout]");
		const parentInput = root.querySelector<HTMLInputElement>("[data-parent-id]");
		const replying = root.querySelector<HTMLElement>("[data-replying]");
		const replyingLabel = root.querySelector<HTMLElement>("[data-replying-label]");
		const cancelReply = root.querySelector<HTMLButtonElement>("[data-cancel-reply]");
		const identityFields = Array.from(root.querySelectorAll<HTMLElement>("[data-identity-field]"));
		let isAuthenticated = false;
		let activeReplyCard: HTMLElement | null = null;
		let turnstileWidgetId: string | null = null;
		let turnstileRenderTimer = 0;

		const getTurnstile = () => (window as unknown as { turnstile?: TurnstileApi }).turnstile;

		const loadTurnstile = (onReady: () => void) => {
			if (!root.dataset.turnstileSiteKey) return;
			if (getTurnstile()) {
				onReady();
				return;
			}

			let script = document.querySelector<HTMLScriptElement>('script[src^="https://challenges.cloudflare.com/turnstile/v0/api.js"]');
			if (!script) {
				script = document.createElement("script");
				script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
				script.async = true;
				script.defer = true;
				document.head.appendChild(script);
			}

			script.addEventListener(
				"load",
				() => {
					if (!signal.aborted) onReady();
				},
				{ once: true, signal }
			);
		};

		if (form && formHost) {
			formHost.appendChild(form);
		}

		const setNotice = (message: string, tone: "neutral" | "error" | "success" = "neutral") => {
			if (!notice) return;
			notice.textContent = message;
			notice.dataset.tone = tone;
			notice.hidden = message.trim().length === 0;
		};

		setNotice("");

		const apiUrl = (path: string) => `${apiBase}${path}`;

		const rerenderTurnstile = () => {
			if (!form) return;
			const widget = form.querySelector<HTMLElement>(".cf-turnstile");
			const sitekey = widget?.dataset.sitekey ?? root.dataset.turnstileSiteKey;
			if (!widget || !sitekey) return;

			window.clearTimeout(turnstileRenderTimer);
			turnstileRenderTimer = window.setTimeout(() => {
				if (signal.aborted) return;
				const turnstile = getTurnstile();
				if (!turnstile) {
					loadTurnstile(rerenderTurnstile);
					return;
				}
				if (turnstileWidgetId) {
					turnstile.remove?.(turnstileWidgetId);
					turnstileWidgetId = null;
				}
				widget.replaceChildren();
				turnstileWidgetId = turnstile.render(widget, { sitekey });
			}, 0);
		};

		if (loginLink) {
			const returnTo = new URL(window.location.href);
			returnTo.hash = "comments";
			loginLink.href = apiUrl(`/api/auth/github/start?returnTo=${encodeURIComponent(returnTo.toString())}`);
		}

		const refreshAuth = async () => {
			try {
				const response = await fetch(apiUrl("/api/auth/me"), { credentials: "include", signal });
				const data = await response.json();
				if (signal.aborted) return;
				if (data.authenticated && authPanel && authName && loginLink) {
					authName.textContent = `已用 GitHub 登入：${data.user.login}`;
					authPanel.hidden = false;
					loginLink.hidden = true;
					isAuthenticated = true;
					for (const field of identityFields) {
						field.hidden = true;
						for (const input of field.querySelectorAll<HTMLInputElement>("input")) input.value = "";
					}
				}
			} catch (error) {
				if (error instanceof DOMException && error.name === "AbortError") return;
				// Comments still work anonymously if auth state cannot be loaded.
			}
		};

		const loadComments = async () => {
			if (!list) return;
			list.removeAttribute("role");
			list.textContent = "載入留言中…";
			try {
				const response = await fetch(apiUrl(`/api/comments?pagePath=${encodeURIComponent(pagePath)}`), { credentials: "include", signal });
				const data = (await response.json()) as { comments: PublicComment[] };
				if (signal.aborted) return;
				list.replaceChildren();
				renderComments(data.comments, list);
			} catch (error) {
				if (error instanceof DOMException && error.name === "AbortError") return;
				list.textContent = "";
				setNotice("留言載入失敗，請稍後再試。", "error");
			}
		};

		const renderComments = (comments: PublicComment[], container: HTMLElement) => {
			container.removeAttribute("role");
			const byParent = new Map<string, PublicComment[]>();
			for (const comment of comments) {
				const key = comment.parentId ?? "";
				byParent.set(key, [...(byParent.get(key) ?? []), comment]);
			}

			const renderGroup = (parentId: string, target: HTMLElement) => {
				const group = byParent.get(parentId) ?? [];
				for (const comment of group) {
					const article = renderComment(comment);
					target.appendChild(article);
					const childComments = byParent.get(comment.id) ?? [];
					if (childComments.length) {
						const replies = document.createElement("div");
						replies.className = "replies";
						replies.setAttribute("role", "list");
						article.appendChild(replies);
						renderGroup(comment.id, replies);
					}
					const replySlot = document.createElement("div");
					replySlot.className = "reply-form-slot";
					article.appendChild(replySlot);
				}
			};

			renderGroup("", container);
			if (container.querySelector("[role='listitem']")) {
				container.setAttribute("role", "list");
			} else {
				const empty = document.createElement("p");
				empty.className = "empty";
				empty.textContent = "還沒有留言。";
				container.appendChild(empty);
			}
		};

		const renderComment = (comment: PublicComment) => {
			const article = document.createElement("article");
			article.className = "comment-card";
			article.setAttribute("role", "listitem");

			const head = document.createElement("div");
			head.className = "comment-head";

			const avatar = document.createElement("span");
			avatar.className = "avatar";
			if (comment.author.avatarUrl) {
				const img = document.createElement("img");
				img.src = comment.author.avatarUrl;
				img.alt = "";
				img.width = 44;
				img.height = 44;
				img.loading = "lazy";
				avatar.appendChild(img);
			}

			const meta = document.createElement("div");
			const name = document.createElement("strong");
			name.textContent = comment.author.name;
			const time = document.createElement("time");
			time.dateTime = comment.createdAt;
			time.textContent = new Date(comment.createdAt).toLocaleString("zh-TW", { dateStyle: "medium", timeStyle: "short" });
			meta.append(name, time);
			head.append(avatar, meta);

			const body = document.createElement("p");
			body.innerHTML = comment.body;

			const bottom = document.createElement("div");
			bottom.className = "comment-bottom";
			const tagLabels = [comment.author.type === "github" ? "GitHub 驗證" : "匿名留言", comment.meta?.device, comment.meta?.browser, comment.meta?.location].filter((label): label is string =>
				Boolean(label)
			);
			for (const label of tagLabels) {
				const tag = document.createElement("span");
				tag.textContent = label;
				bottom.appendChild(tag);
			}
			const reply = document.createElement("button");
			reply.type = "button";
			reply.textContent = "回覆";
			reply.setAttribute("aria-label", `回覆 ${comment.author.name} 的留言`);
			reply.addEventListener(
				"click",
				() => {
					const replySlot = article.querySelector<HTMLElement>(".reply-form-slot");
					if (!parentInput || !replying || !replyingLabel || !form || !replySlot) return;
					parentInput.value = comment.id;
					replyingLabel.textContent = `回覆給 ${comment.author.name}`;
					replying.hidden = false;
					activeReplyCard?.classList.remove("reply-target");
					activeReplyCard = article;
					activeReplyCard.classList.add("reply-target");
					replySlot.appendChild(form);
					rerenderTurnstile();
					form.querySelector("textarea")?.focus();
				},
				{ signal }
			);
			bottom.append(reply);
			article.append(head, body, bottom);
			return article;
		};

		const resetReply = (options: { focus?: boolean } = {}) => {
			if (!parentInput || !replying) return;
			parentInput.value = "";
			replying.hidden = true;
			activeReplyCard?.classList.remove("reply-target");
			activeReplyCard = null;
			if (form && formHost) {
				formHost.appendChild(form);
				rerenderTurnstile();
			}
			if (options.focus) {
				form?.querySelector("textarea")?.focus();
			}
		};

		cancelReply?.addEventListener("click", () => resetReply({ focus: true }), { signal });

		logoutButton?.addEventListener(
			"click",
			async () => {
				await fetch(apiUrl("/api/auth/logout"), { method: "POST", credentials: "include", signal });
				location.reload();
			},
			{ signal }
		);

		form?.addEventListener(
			"submit",
			async event => {
				event.preventDefault();
				if (signal.aborted) return;
				const data = new FormData(form);
				const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
				const turnstileToken = form.querySelector<HTMLInputElement>("[name='cf-turnstile-response']")?.value ?? "";
				form.setAttribute("aria-busy", "true");
				submit?.setAttribute("disabled", "true");
				setNotice("送出中…");

				try {
					const response = await fetch(apiUrl("/api/comments"), {
						method: "POST",
						credentials: "include",
						signal,
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							pagePath,
							parentId: data.get("parentId") || undefined,
							name: isAuthenticated ? undefined : data.get("name") || undefined,
							email: isAuthenticated ? undefined : data.get("email") || undefined,
							body: data.get("body"),
							turnstileToken
						})
					});
					const result = await response.json();
					if (signal.aborted) return;
					if (!response.ok) {
						throw new Error(result.error ?? "留言送出失敗");
					}
					form.reset();
					resetReply();
					setNotice(result.status === "approved" ? "留言已發布。" : "留言正在等待審核。", "success");
					await loadComments();
					getTurnstile()?.reset(turnstileWidgetId ?? undefined);
				} catch (error) {
					if (error instanceof DOMException && error.name === "AbortError") return;
					setNotice(error instanceof Error ? error.message : "留言送出失敗", "error");
				} finally {
					if (signal.aborted) return;
					form.removeAttribute("aria-busy");
					submit?.removeAttribute("disabled");
				}
			},
			{ signal }
		);

		refreshAuth();
		loadComments();
		rerenderTurnstile();

		return () => {
			window.clearTimeout(turnstileRenderTimer);
			activeReplyCard?.classList.remove("reply-target");
			const turnstile = getTurnstile();
			if (turnstileWidgetId) turnstile?.remove?.(turnstileWidgetId);
			controller.abort();
		};
	});
</script>

<style>
	.comments {
		width: min(57.5rem, 100%);
		margin: 0 auto;
	}

	.comments-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h2 {
		margin-top: 0.5rem;
		font-size: 3.25rem;
		line-height: 1;
		letter-spacing: -0.07em;
		color: var(--color-ink);
	}

	.github-login,
	.auth-panel button,
	.actions button,
	.replying button,
	.comments :global(.comment-bottom button) {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		line-height: 1;
		color: var(--color-ink);
		background: var(--color-surface);
		border: 1px solid var(--color-accent-strong);
		transition:
			background 160ms ease,
			border-color 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	.github-login,
	.actions button {
		padding: 0.75rem 1rem;
	}

	.github-login[hidden],
	.auth-panel[hidden],
	[data-identity-field][hidden] {
		display: none;
	}

	.auth-panel {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
		padding: 0.75rem 1rem;
		background: var(--color-surface-glass);
		border: 1px solid var(--color-border);
	}

	.auth-panel button,
	.replying button,
	.comments :global(.comment-bottom button) {
		padding: 0.5rem 0.75rem;
		font-size: 0.85rem;
	}

	.github-login:hover,
	.auth-panel button:hover,
	.actions button:hover,
	.replying button:hover,
	.comments :global(.comment-bottom button:hover) {
		background: oklch(93% 0.045 220 / 45%);
		border-color: var(--color-accent);
		box-shadow: 0 0.35rem 1rem oklch(71% 0.15 225 / 12%);
		transform: translateY(-0.1rem);
	}

	.notice {
		margin-bottom: 1rem;
		font-size: 0.95rem;
		color: var(--color-muted);
	}

	.notice[hidden] {
		display: none;
	}

	.notice[data-tone="error"] {
		color: oklch(52% 0.17 28);
	}

	.notice[data-tone="success"] {
		color: oklch(43% 0.13 150);
	}

	.form-host {
		margin-bottom: 2rem;
	}

	.comment-list {
		display: grid;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.comments :global(.empty) {
		color: var(--color-muted);
	}

	.comment-form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	label {
		display: grid;
		gap: 0.25rem;
		font-size: 1rem;
		color: var(--color-text);
	}

	.message,
	.actions,
	.turnstile-field,
	.replying {
		grid-column: 1 / -1;
	}

	.turnstile-field {
		display: grid;
		gap: 0.5rem;
	}

	.turnstile-field p {
		font-size: 1rem;
		color: var(--color-text);
	}

	input,
	textarea {
		width: 100%;
		padding: 0.5rem 1rem;
		color: var(--color-text);
		background: var(--color-surface-glass);
		border: 1px solid var(--color-border);
		transition:
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	input::placeholder,
	textarea::placeholder {
		color: var(--color-placeholder);
	}

	textarea {
		resize: vertical;
	}

	input:focus,
	textarea:focus {
		border-color: var(--color-accent);
	}

	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--color-accent-strong);
		outline-offset: 3px;
		box-shadow: 0 0 0 0.25rem var(--color-accent-soft);
	}

	.replying {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem;
		color: var(--color-text);
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
	}

	.replying[hidden] {
		display: none;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.comments :global(.comment-card) {
		padding: 1rem;
		background: var(--color-surface-glass-strong);
		border: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.comments :global(.comment-card.reply-target) {
		background: color-mix(in oklch, var(--color-surface-soft) 72%, var(--color-surface));
		border-color: var(--color-accent);
	}

	.comments :global(.comment-head) {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		line-height: 1;
	}

	.comments :global(.avatar) {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		overflow: hidden;
		border-radius: 50%;
		background:
			radial-gradient(circle at 35% 35%, var(--color-yellow), transparent 30%), radial-gradient(circle at 70% 30%, var(--color-pink), transparent 34%),
			linear-gradient(135deg, var(--color-accent), var(--color-purple));
	}

	.comments :global(.avatar img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.comments :global(.comment-card strong),
	.comments :global(.comment-card time) {
		display: block;
	}

	.comments :global(.comment-card strong) {
		font-size: 1rem;
		color: var(--color-ink);
	}

	.comments :global(.comment-card time) {
		margin-top: 0.3rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.comments :global(.comment-card p) {
		font-size: 1rem;
		line-height: 1.9;
		color: var(--color-text);
		white-space: pre-wrap;
	}

	.comments :global(.comment-bottom) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	.comments :global(.comment-bottom span) {
		padding: 0.25rem 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
		border: 1px solid var(--color-border);
	}

	.comments :global(.comment-bottom button) {
		margin-left: auto;
	}

	.comments :global(.replies) {
		display: grid;
		gap: 1rem;
		margin-left: 2rem;
		padding-left: 1rem;
		border-left: 1px solid var(--color-border);
	}

	.comments :global(.reply-form-slot) {
		display: none;
		margin-top: 0.25rem;
