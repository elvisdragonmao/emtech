---
import { COMMENT_REACTION_GROUPS } from "@emtech/comments-shared";
import { LogOut, Send, Smile } from "@lucide/astro";
import androidIconUrl from "@/assets/comment-icons/android.svg?url";
import appleIconUrl from "@/assets/comment-icons/apple.svg?url";
import chromeIconUrl from "@/assets/comment-icons/chrome.svg?url";
import edgeIconUrl from "@/assets/comment-icons/microsoft-edge.svg?url";
import firefoxIconUrl from "@/assets/comment-icons/firefox.svg?url";
import githubIconUrl from "@/assets/comment-icons/github.svg?url";
import linuxIconUrl from "@/assets/comment-icons/linux.svg?url";
import operaIconUrl from "@/assets/comment-icons/opera.svg?url";
import safariIconUrl from "@/assets/comment-icons/safari.svg?url";
import windowsIconUrl from "@/assets/comment-icons/windows.svg?url";

interface Props {
	pagePath?: string;
}

const { pagePath = Astro.url.pathname } = Astro.props;
const commentApiBaseUrl = (import.meta.env.COMMENT_API_BASE_URL ?? import.meta.env.PUBLIC_COMMENT_API_BASE_URL ?? "https://api.emtech.cc").replace(/\/$/, "");
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY ?? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

type CommentMetaIcon = { src: string };

const commentIcon = (src: string): CommentMetaIcon => ({ src });

const commentMetaIcons = {
	auth: {
		github: commentIcon(githubIconUrl)
	},
	device: {
		iPhone: commentIcon(appleIconUrl),
		iPad: commentIcon(appleIconUrl),
		"Android Phone": commentIcon(androidIconUrl),
		Android: commentIcon(androidIconUrl),
		Mac: commentIcon(appleIconUrl),
		"Windows PC": commentIcon(windowsIconUrl),
		Linux: commentIcon(linuxIconUrl)
	},
	browser: {
		Chrome: commentIcon(chromeIconUrl),
		Firefox: commentIcon(firefoxIconUrl),
		Safari: commentIcon(safariIconUrl),
		Opera: commentIcon(operaIconUrl),
		Edge: commentIcon(edgeIconUrl)
	}
} satisfies Record<string, Record<string, CommentMetaIcon>>;
---

<section
	id="comments"
	class="comments"
	data-comments-root
	data-page-path={pagePath}
	data-api-base={commentApiBaseUrl}
	data-turnstile-site-key={turnstileSiteKey}
	data-comment-meta-icons={JSON.stringify(commentMetaIcons)}
	data-reaction-groups={JSON.stringify(COMMENT_REACTION_GROUPS)}
>
	<template data-reaction-icon-template>
		<Smile size={16} stroke-width={1.8} aria-hidden="true" />
	</template>
	<div class="comments-heading">
		<div>
			<p class="eyebrow">留言</p>
			<h2>留言區</h2>
		</div>
		<a class="github-login" data-github-login href={`${commentApiBaseUrl}/api/auth/github/start?returnTo=${encodeURIComponent(`${pagePath}#comments`)}`}>
			<img src={githubIconUrl} alt="" width="16" height="16" loading="lazy" decoding="async" aria-hidden="true" />
			GitHub 登入
		</a>
	</div>

	<div class="auth-panel" data-auth-panel hidden>
		<span data-auth-name></span>
		<button type="button" data-logout>
			<LogOut size={14} stroke-width={1.8} aria-hidden="true" />
			登出
		</button>
	</div>

	<div class="notice" data-notice role="status" aria-live="polite" hidden></div>

	<div class="form-host" data-form-host>
		<form class="comment-form" data-comment-form>
			<input type="hidden" name="parentId" data-parent-id />
			<div class="replying" data-replying hidden>
				<span data-replying-label></span>
				<button type="button" data-cancel-reply>取消回覆</button>
			</div>
			<label data-anonymous-identity-field>
				顯示名稱
				<input name="name" type="text" maxlength="80" autocomplete="name" placeholder="匿名" />
			</label>
			<label>
				電子郵件
				<input name="email" type="email" autocomplete="email" spellcheck="false" placeholder="用於頭像與討論串回覆通知，不會公開" />
				<small>這個討論串有新回覆時會寄信通知你；表情符號回應不會寄信。</small>
			</label>
			<label class="message">
				留言
				<textarea name="body" rows="5" maxlength="3000" required placeholder="寫下你的想法"></textarea>
			</label>
			{
				turnstileSiteKey && (
					<div class="turnstile-field">
						<p>安全驗證</p>
						<div class="turnstile cf-turnstile" data-sitekey={turnstileSiteKey} aria-label="Cloudflare Turnstile 安全驗證" />
					</div>
				)
			}
			<div class="actions">
				<button type="submit">
					<Send size={14} stroke-width={1.8} aria-hidden="true" />
					送出留言
				</button>
			</div>
		</form>
	</div>

	<div class="comment-list" data-comment-list aria-live="polite"></div>
</section>

<script>
	import { setupPageLifecycle } from "@/scripts/pageLifecycle";

	type TurnstileApi = {
		render: (container: HTMLElement, options: { sitekey: string }) => string;
		reset: (widgetId?: string) => void;
		remove?: (widgetId?: string) => void;
	};

	type PublicComment = {
		id: string;
		pagePath: string;
		parentId: string | null;
		body: string;
		author: {
			type: "anonymous" | "named" | "gravatar" | "github";
			name: string;
			avatarUrl: string | null;
		};
		meta: {
			device: string | null;
			browser: string | null;
			location: string | null;
		};
		reactions: CommentReaction[];
		createdAt: string;
	};

	type CommentReaction = {
		emoji: string;
		count: number;
	};

	type ReactionGroup = {
		label: string;
		emojis: string[];
	};

	type ReactionView = {
		comment: PublicComment;
		bar: HTMLElement;
		picker: HTMLElement;
	};

	type CommentMetaIcon = { src: string };

	type CommentMetaIcons = {
		auth: Record<string, CommentMetaIcon | undefined>;
		device: Record<string, CommentMetaIcon | undefined>;
		browser: Record<string, CommentMetaIcon | undefined>;
	};

	setupPageLifecycle("comments", () => {
		const root = document.querySelector<HTMLElement>("[data-comments-root]");
		if (!root) return;

		const controller = new AbortController();
		const { signal } = controller;
		const configuredApiBase = root.dataset.apiBase ?? "";
		const apiBase = configuredApiBase;
		const pagePath = root.dataset.pagePath ?? location.pathname;
		const form = root.querySelector<HTMLFormElement>("[data-comment-form]");
		const formHost = root.querySelector<HTMLElement>("[data-form-host]");
		const list = root.querySelector<HTMLElement>("[data-comment-list]");
		const notice = root.querySelector<HTMLElement>("[data-notice]");
		const authPanel = root.querySelector<HTMLElement>("[data-auth-panel]");
		const authName = root.querySelector<HTMLElement>("[data-auth-name]");
		const loginLink = root.querySelector<HTMLAnchorElement>("[data-github-login]");
		const logoutButton = root.querySelector<HTMLButtonElement>("[data-logout]");
		const parentInput = root.querySelector<HTMLInputElement>("[data-parent-id]");
		const replying = root.querySelector<HTMLElement>("[data-replying]");
		const replyingLabel = root.querySelector<HTMLElement>("[data-replying-label]");
		const cancelReply = root.querySelector<HTMLButtonElement>("[data-cancel-reply]");
		const anonymousIdentityFields = Array.from(root.querySelectorAll<HTMLElement>("[data-anonymous-identity-field]"));
		const reactionIconTemplate = root.querySelector<HTMLTemplateElement>("[data-reaction-icon-template]");
		let isAuthenticated = false;
		let activeReplyCard: HTMLElement | null = null;
		let openReactionPicker: HTMLElement | null = null;
		let openReactionButton: HTMLButtonElement | null = null;
		let turnstileWidgetId: string | null = null;
		let turnstileRenderTimer = 0;
		const reactionViews = new Map<string, ReactionView>();
		const reactionGroups = (() => {
			try {
				return JSON.parse(root.dataset.reactionGroups ?? "[]") as ReactionGroup[];
			} catch {
				return [];
			}
		})();
		const allowedReactions = new Set(reactionGroups.flatMap(group => group.emojis));
		const reactionStorageKey = "emtech-comment-reactions:v1";
		const reactionVisitorStorageKey = "emtech-comment-reaction-visitor:v1";
		const createReactionVisitorId = () => globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;
		const readReactionVisitorId = () => {
			try {
				const stored = localStorage.getItem(reactionVisitorStorageKey);
				if (stored && stored.length >= 16 && stored.length <= 128) return stored;
				const created = createReactionVisitorId();
				localStorage.setItem(reactionVisitorStorageKey, created);
				return created;
			} catch {
				return createReactionVisitorId();
			}
		};
		const readOwnReactions = () => {
			try {
				const parsed = JSON.parse(localStorage.getItem(reactionStorageKey) ?? "{}") as Record<string, unknown>;
				return Object.fromEntries(
					Object.entries(parsed)
						.map(([commentId, emojis]) => [commentId, Array.isArray(emojis) ? emojis.filter((emoji): emoji is string => typeof emoji === "string" && allowedReactions.has(emoji)) : []])
						.filter(([, emojis]) => emojis.length > 0)
				) as Record<string, string[]>;
			} catch {
				return {};
			}
		};
		const reactionVisitorId = readReactionVisitorId();
		let ownReactions = readOwnReactions();
		const metaIcons = (() => {
			try {
				return JSON.parse(root.dataset.commentMetaIcons ?? "{}") as CommentMetaIcons;
			} catch {
				return { auth: {}, device: {}, browser: {} };
			}
		})();

		const getTurnstile = () => (window as unknown as { turnstile?: TurnstileApi }).turnstile;

		const loadTurnstile = (onReady: () => void) => {
			if (!root.dataset.turnstileSiteKey) return;
			if (getTurnstile()) {
				onReady();
				return;
			}

			let script = document.querySelector<HTMLScriptElement>('script[src^="https://challenges.cloudflare.com/turnstile/v0/api.js"]');
			if (!script) {
				script = document.createElement("script");
				script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
				script.async = true;
				script.defer = true;
				document.head.appendChild(script);
			}

			script.addEventListener(
				"load",
				() => {
					if (!signal.aborted) onReady();
				},
				{ once: true, signal }
			);
		};

		if (form && formHost) {
			formHost.appendChild(form);
		}

		const setNotice = (message: string, tone: "neutral" | "error" | "success" = "neutral") => {
			if (!notice) return;
			notice.textContent = message;
			notice.dataset.tone = tone;
			notice.hidden = message.trim().length === 0;
		};

		setNotice("");

		const createMetaIcon = (icon: CommentMetaIcon) => {
			const wrapper = document.createElement("span");
			wrapper.className = "comment-meta-icon";
			const img = document.createElement("img");
			img.src = icon.src;
			img.alt = "";
			img.loading = "lazy";
			img.decoding = "async";
			img.setAttribute("aria-hidden", "true");
			wrapper.appendChild(img);
			return wrapper;
		};

		const appendMetaPill = (container: HTMLElement, label: string | null | undefined, icon?: CommentMetaIcon) => {
			if (!label) return;
			const tag = document.createElement("span");
			tag.className = "comment-meta-pill";
			tag.title = label;
			if (icon) {
				tag.classList.add("has-icon");
				tag.setAttribute("aria-label", label);
				const iconElement = createMetaIcon(icon);
				iconElement.querySelector("img")?.addEventListener(
					"error",
					() => {
						tag.classList.remove("has-icon");
						tag.removeAttribute("aria-label");
						tag.textContent = label;
					},
					{ once: true }
				);
				tag.appendChild(iconElement);
			} else {
				tag.textContent = label;
			}
			container.appendChild(tag);
		};

		const apiUrl = (path: string) => `${apiBase}${path}`;
		const hasOwnReaction = (commentId: string, emoji: string) => ownReactions[commentId]?.includes(emoji) ?? false;
		const saveOwnReaction = (commentId: string, emoji: string, active: boolean) => {
			const selected = new Set(ownReactions[commentId] ?? []);
			if (active) selected.add(emoji);
			else selected.delete(emoji);
			if (selected.size) ownReactions[commentId] = [...selected];
			else delete ownReactions[commentId];
			try {
				localStorage.setItem(reactionStorageKey, JSON.stringify(ownReactions));
			} catch {
				// The reaction still works for the current page when storage is unavailable.
			}
		};

		const closeReactionPicker = (options: { focus?: boolean } = {}) => {
			if (!openReactionPicker || !openReactionButton) return;
			openReactionPicker.hidden = true;
			openReactionButton.setAttribute("aria-expanded", "false");
			if (options.focus) openReactionButton.focus();
			openReactionPicker = null;
			openReactionButton = null;
		};

		const updateReactionPicker = (view: ReactionView) => {
			for (const button of view.picker.querySelectorAll<HTMLButtonElement>("[data-reaction-emoji]")) {
				const emoji = button.dataset.reactionEmoji ?? "";
				const selected = hasOwnReaction(view.comment.id, emoji);
				button.setAttribute("aria-pressed", String(selected));
				button.dataset.selected = String(selected);
			}
		};

		const updateReactionBar = (view: ReactionView) => {
			view.bar.replaceChildren();
			for (const reaction of view.comment.reactions) {
				if (reaction.count < 1) continue;
				const button = document.createElement("button");
				button.type = "button";
				button.className = "reaction-count";
				button.dataset.reactionEmoji = reaction.emoji;
				const selected = hasOwnReaction(view.comment.id, reaction.emoji);
				button.dataset.selected = String(selected);
				button.setAttribute("aria-pressed", String(selected));
				button.setAttribute("aria-label", `${selected ? "取消" : "加入"} ${reaction.emoji} 回應，目前 ${reaction.count} 個`);
				const emoji = document.createElement("span");
				emoji.className = "reaction-count-emoji";
				emoji.textContent = reaction.emoji;
				emoji.setAttribute("aria-hidden", "true");
				const count = document.createElement("span");
				count.textContent = String(reaction.count);
				button.append(emoji, count);
				button.addEventListener("click", () => void toggleReaction(view, reaction.emoji), { signal });
				view.bar.appendChild(button);
			}
			view.bar.hidden = view.bar.childElementCount === 0;
		};

		const toggleReaction = async (view: ReactionView, emoji: string) => {
			if (!allowedReactions.has(emoji)) return;
			const active = !hasOwnReaction(view.comment.id, emoji);
			const relatedButtons = Array.from(view.bar.querySelectorAll<HTMLButtonElement>(`[data-reaction-emoji="${CSS.escape(emoji)}"]`)).concat(
				Array.from(view.picker.querySelectorAll<HTMLButtonElement>(`[data-reaction-emoji="${CSS.escape(emoji)}"]`))
			);
			for (const button of relatedButtons) button.disabled = true;

			try {
				const response = await fetch(apiUrl(`/api/comments/${encodeURIComponent(view.comment.id)}/reactions`), {
					method: "POST",
					credentials: "include",
					signal,
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ visitorId: reactionVisitorId, emoji, active })
				});
				const result = (await response.json()) as { error?: string; reactions?: CommentReaction[] };
				if (!response.ok || !result.reactions) throw new Error(result.error ?? "表情符號回應失敗");
				view.comment.reactions = result.reactions;
				saveOwnReaction(view.comment.id, emoji, active);
				updateReactionBar(view);
				updateReactionPicker(view);
			} catch (error) {
				if (error instanceof DOMException && error.name === "AbortError") return;
				setNotice(error instanceof Error ? error.message : "表情符號回應失敗", "error");
			} finally {
				for (const button of relatedButtons) button.disabled = false;
			}
		};

		const createReactionPicker = (view: ReactionView) => {
			const picker = view.picker;
			picker.className = "reaction-picker";
			picker.hidden = true;
			picker.setAttribute("role", "dialog");
			picker.setAttribute("aria-label", "選擇表情符號回應");
			for (const group of reactionGroups) {
				const section = document.createElement("section");
				section.className = "reaction-picker-group";
				const heading = document.createElement("p");
				heading.className = "reaction-picker-heading";
				heading.textContent = group.label;
				const grid = document.createElement("div");
				grid.className = "reaction-picker-grid";
				for (const emoji of group.emojis) {
					const button = document.createElement("button");
					button.type = "button";
					button.className = "reaction-option";
					button.dataset.reactionEmoji = emoji;
					button.textContent = emoji;
					button.setAttribute("aria-label", `使用 ${emoji} 回應`);
					button.addEventListener("click", () => void toggleReaction(view, emoji), { signal });
					grid.appendChild(button);
				}
				section.append(heading, grid);
				picker.appendChild(section);
			}
			updateReactionPicker(view);
		};

		const rerenderTurnstile = () => {
			if (!form) return;
			const widget = form.querySelector<HTMLElement>(".cf-turnstile");
			const sitekey = widget?.dataset.sitekey ?? root.dataset.turnstileSiteKey;
			if (!widget || !sitekey) return;

			window.clearTimeout(turnstileRenderTimer);
			turnstileRenderTimer = window.setTimeout(() => {
				if (signal.aborted) return;
				const turnstile = getTurnstile();
				if (!turnstile) {
					loadTurnstile(rerenderTurnstile);
					return;
				}
				if (turnstileWidgetId) {
					turnstile.remove?.(turnstileWidgetId);
					turnstileWidgetId = null;
				}
				widget.replaceChildren();
				turnstileWidgetId = turnstile.render(widget, { sitekey });
			}, 0);
		};

		if (loginLink) {
			const returnTo = new URL(window.location.href);
			returnTo.hash = "comments";
			loginLink.href = apiUrl(`/api/auth/github/start?returnTo=${encodeURIComponent(returnTo.toString())}`);
		}

		const refreshAuth = async () => {
			try {
				const response = await fetch(apiUrl("/api/auth/me"), { credentials: "include", signal });
				const data = await response.json();
				if (signal.aborted) return;
				if (data.authenticated && authPanel && authName && loginLink) {
					authName.textContent = `已用 GitHub 登入：${data.user.login}`;
					authPanel.hidden = false;
					loginLink.hidden = true;
					isAuthenticated = true;
					for (const field of anonymousIdentityFields) {
						field.hidden = true;
						for (const input of field.querySelectorAll<HTMLInputElement>("input")) input.value = "";
					}
				}
			} catch (error) {
				if (error instanceof DOMException && error.name === "AbortError") return;
				// Comments still work anonymously if auth state cannot be loaded.
			}
		};

		const loadComments = async () => {
			if (!list) return;
			list.removeAttribute("role");
			list.textContent = "載入留言中…";
			try {
				const response = await fetch(apiUrl(`/api/comments?pagePath=${encodeURIComponent(pagePath)}`), { credentials: "include", signal });
				const data = (await response.json()) as { comments: PublicComment[] };
				if (signal.aborted) return;
				list.replaceChildren();
				renderComments(data.comments, list);
			} catch (error) {
				if (error instanceof DOMException && error.name === "AbortError") return;
				list.textContent = "";
				setNotice("留言載入失敗，請稍後再試。", "error");
			}
		};

		const renderComments = (comments: PublicComment[], container: HTMLElement) => {
			reactionViews.clear();
			container.removeAttribute("role");
			const byParent = new Map<string, PublicComment[]>();
			for (const comment of comments) {
				const key = comment.parentId ?? "";
				byParent.set(key, [...(byParent.get(key) ?? []), comment]);
			}

			const renderGroup = (parentId: string, target: HTMLElement) => {
				const group = byParent.get(parentId) ?? [];
				for (const comment of group) {
					const article = renderComment(comment);
					target.appendChild(article);
					const childComments = byParent.get(comment.id) ?? [];
					if (childComments.length) {
						const replies = document.createElement("div");
						replies.className = "replies";
						replies.setAttribute("role", "list");
						article.appendChild(replies);
						renderGroup(comment.id, replies);
					}
					const replySlot = document.createElement("div");
					replySlot.className = "reply-form-slot";
					article.appendChild(replySlot);
				}
			};

			renderGroup("", container);
			if (container.querySelector("[role='listitem']")) {
				container.setAttribute("role", "list");
			} else {
				const empty = document.createElement("p");
				empty.className = "empty";
				empty.textContent = "還沒有留言。";
				container.appendChild(empty);
			}
		};

		const renderComment = (comment: PublicComment) => {
			const article = document.createElement("article");
			article.className = "comment-card";
			article.setAttribute("role", "listitem");

			const head = document.createElement("div");
			head.className = "comment-head";

			const avatar = document.createElement("span");
			avatar.className = "avatar";
			const showAvatarFallback = () => {
				avatar.replaceChildren();
				avatar.classList.add("avatar-fallback");
			};
			if (comment.author.avatarUrl) {
				const img = document.createElement("img");
				img.src = comment.author.avatarUrl;
				img.alt = "";
				img.width = 44;
				img.height = 44;
				img.loading = "lazy";
				img.addEventListener("error", showAvatarFallback, { once: true });
				avatar.appendChild(img);
			} else {
				showAvatarFallback();
			}

			const meta = document.createElement("div");
			const name = document.createElement("strong");
			name.textContent = comment.author.name;
			const time = document.createElement("time");
			time.dateTime = comment.createdAt;
			time.textContent = new Date(comment.createdAt).toLocaleString("zh-TW", { dateStyle: "medium", timeStyle: "short" });
			meta.append(name, time);
			head.append(avatar, meta);

			const body = document.createElement("p");
			body.innerHTML = comment.body;

			const bottom = document.createElement("div");
			bottom.className = "comment-bottom";
			appendMetaPill(bottom, comment.author.type === "github" ? "GitHub 驗證" : "匿名留言", comment.author.type === "github" ? metaIcons.auth.github : undefined);
			appendMetaPill(bottom, comment.meta?.device, comment.meta?.device ? metaIcons.device[comment.meta.device] : undefined);
			appendMetaPill(bottom, comment.meta?.browser, comment.meta?.browser ? metaIcons.browser[comment.meta.browser] : undefined);
			appendMetaPill(bottom, comment.meta?.location);
			const reactionBar = document.createElement("div");
			reactionBar.className = "reaction-bar";
			reactionBar.setAttribute("aria-label", "表情符號回應");
			const commentActions = document.createElement("div");
			commentActions.className = "comment-actions";
			const reactionPicker = document.createElement("div");
			const view = { comment, bar: reactionBar, picker: reactionPicker };
			reactionViews.set(comment.id, view);
			createReactionPicker(view);
			updateReactionBar(view);
			const reactionButton = document.createElement("button");
			reactionButton.type = "button";
			reactionButton.className = "reaction-trigger";
			reactionButton.setAttribute("aria-label", `為 ${comment.author.name} 的留言添加表情符號回應`);
			reactionButton.setAttribute("aria-haspopup", "dialog");
			reactionButton.setAttribute("aria-expanded", "false");
			if (reactionIconTemplate) reactionButton.appendChild(reactionIconTemplate.content.cloneNode(true));
			else reactionButton.textContent = "☺";
			reactionButton.addEventListener(
				"click",
				() => {
					const opening = reactionPicker.hidden;
					closeReactionPicker();
					if (!opening) return;
					reactionPicker.hidden = false;
					reactionButton.setAttribute("aria-expanded", "true");
					openReactionPicker = reactionPicker;
					openReactionButton = reactionButton;
				},
				{ signal }
			);
			const reply = document.createElement("button");
			reply.type = "button";
			reply.textContent = "回覆";
			reply.setAttribute("aria-label", `回覆 ${comment.author.name} 的留言`);
			reply.addEventListener(
				"click",
				() => {
					const replySlot = article.querySelector<HTMLElement>(".reply-form-slot");
					if (!parentInput || !replying || !replyingLabel || !form || !replySlot) return;
					parentInput.value = comment.id;
					replyingLabel.textContent = `回覆給 ${comment.author.name}`;
					replying.hidden = false;
					activeReplyCard?.classList.remove("reply-target");
					activeReplyCard = article;
					activeReplyCard.classList.add("reply-target");
					replySlot.appendChild(form);
					rerenderTurnstile();
					form.querySelector("textarea")?.focus();
				},
				{ signal }
			);
			commentActions.append(reactionPicker, reactionButton, reply);
			bottom.append(reactionBar, commentActions);
			article.append(head, body, bottom);
			return article;
		};

		const resetReply = (options: { focus?: boolean } = {}) => {
			if (!parentInput || !replying) return;
			parentInput.value = "";
			replying.hidden = true;
			activeReplyCard?.classList.remove("reply-target");
			activeReplyCard = null;
			if (form && formHost) {
				formHost.appendChild(form);
				rerenderTurnstile();
			}
			if (options.focus) {
				form?.querySelector("textarea")?.focus();
			}
		};

		cancelReply?.addEventListener("click", () => resetReply({ focus: true }), { signal });
		document.addEventListener(
			"click",
			event => {
				if (openReactionPicker && event.target instanceof Node && !openReactionPicker.parentElement?.contains(event.target)) closeReactionPicker();
			},
			{ signal }
		);
		document.addEventListener(
			"keydown",
			event => {
				if (event.key === "Escape" && openReactionPicker) closeReactionPicker({ focus: true });
			},
			{ signal }
		);
		window.addEventListener(
			"storage",
			event => {
				if (event.key !== reactionStorageKey) return;
				ownReactions = readOwnReactions();
				for (const view of reactionViews.values()) {
					updateReactionBar(view);
					updateReactionPicker(view);
				}
			},
			{ signal }
		);

		logoutButton?.addEventListener(
			"click",
			async () => {
				await fetch(apiUrl("/api/auth/logout"), { method: "POST", credentials: "include", signal });
				location.reload();
			},
			{ signal }
		);

		form?.addEventListener(
			"submit",
			async event => {
				event.preventDefault();
				if (signal.aborted) return;
				const data = new FormData(form);
				const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
				const turnstileToken = form.querySelector<HTMLInputElement>("[name='cf-turnstile-response']")?.value ?? "";
				form.setAttribute("aria-busy", "true");
				submit?.setAttribute("disabled", "true");
				setNotice("送出中…");

				try {
					const response = await fetch(apiUrl("/api/comments"), {
						method: "POST",
						credentials: "include",
						signal,
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							pagePath,
							parentId: data.get("parentId") || undefined,
							name: isAuthenticated ? undefined : data.get("name") || undefined,
							email: data.get("email") || undefined,
							body: data.get("body"),
							turnstileToken
						})
					});
					const result = await response.json();
					if (signal.aborted) return;
					if (!response.ok) {
						throw new Error(result.error ?? "留言送出失敗");
					}
					form.reset();
					resetReply();
					setNotice(result.status === "approved" ? "留言已發布。" : "留言正在等待審核。", "success");
					await loadComments();
					getTurnstile()?.reset(turnstileWidgetId ?? undefined);
				} catch (error) {
					if (error instanceof DOMException && error.name === "AbortError") return;
					setNotice(error instanceof Error ? error.message : "留言送出失敗", "error");
				} finally {
					if (signal.aborted) return;
					form.removeAttribute("aria-busy");
					submit?.removeAttribute("disabled");
				}
			},
			{ signal }
		);

		refreshAuth();
		loadComments();
		rerenderTurnstile();

		return () => {
			window.clearTimeout(turnstileRenderTimer);
			activeReplyCard?.classList.remove("reply-target");
			closeReactionPicker();
			const turnstile = getTurnstile();
			if (turnstileWidgetId) turnstile?.remove?.(turnstileWidgetId);
			controller.abort();
		};
	});
</script>

