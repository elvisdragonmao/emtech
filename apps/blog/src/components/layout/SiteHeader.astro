---
import { Menu, Moon, Search, Sun, X } from "@lucide/astro";

interface Props {
	active?: "home" | "blog" | "course" | "sitemap";
}

const { active } = Astro.props;

const navItems = [
	{ label: "首頁", href: "/", key: "home" },
	{ label: "課程", href: "/course/", key: "course" },
	{ label: "導覽", href: "/sitemap/", key: "sitemap" }
];
---

<header class="site-header-container">
	<div class="site-header">
		<a class="brand" href="/" aria-label="毛哥EM資訊密技首頁">
			<img src="/img/logo.svg" alt="" width="32" height="37" />
			<span>毛哥EM資訊密技</span>
		</a>

		<nav id="site-main-nav" class="main-nav" aria-label="主要導覽">
			{
				navItems.map(item => (
					<a href={item.href} class:list={[{ active: active === item.key }]} aria-current={active === item.key ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="site-actions">
			<button class="theme-toggle" type="button" aria-label="切換為深色" title="切換為深色" aria-pressed="false" data-theme-toggle data-theme-state="light">
				<Sun class="theme-icon theme-icon-light" size={14} stroke-width={2} aria-hidden="true" />
				<Moon class="theme-icon theme-icon-dark" size={14} stroke-width={2} aria-hidden="true" />
			</button>

			<button class="search-button" type="button" aria-label="搜尋文章與課程" aria-controls="site-search" aria-expanded="false" data-search-open>
				<Search size={15} stroke-width={1.8} aria-hidden="true" />
				<span>搜尋</span>
				<kbd>⌘K</kbd>
			</button>

			<button class="menu-button" type="button" aria-label="開啟導覽選單" aria-controls="site-main-nav" aria-expanded="false" data-menu-toggle>
				<Menu class="menu-icon" size={18} stroke-width={1.8} aria-hidden="true" />
				<X class="close-icon" size={18} stroke-width={1.8} aria-hidden="true" />
			</button>
		</div>
	</div>
</header>

<script>
	import { setupPageLifecycle } from "@/scripts/pageLifecycle";

	setupPageLifecycle("site-header", () => {
		const header = document.querySelector<HTMLElement>(".site-header");
		const nav = document.querySelector<HTMLElement>(".main-nav");
		const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
		const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
		const mobileMenu = window.matchMedia("(max-width: 43rem)");
		const controller = new AbortController();
		const { signal } = controller;
		const themeStorageKey = "emtech:theme";
		type Theme = "light" | "dark";
		const themeColors = { light: "#f7fbff", dark: "#141821" };

		const getTheme = (): Theme => {
			try {
				const stored = window.localStorage.getItem(themeStorageKey);
				return stored === "dark" ? "dark" : "light";
			} catch {
				return "light";
			}
		};

		const applyTheme = (theme: Theme) => {
			const nextLabel = theme === "dark" ? "切換為淺色" : "切換為深色";
			document.documentElement.dataset.theme = theme;
			document.documentElement.style.colorScheme = theme;
			document.querySelector("[data-theme-color]")?.setAttribute("content", themeColors[theme]);

			if (!themeToggle) return;
			themeToggle.dataset.themeState = theme;
			themeToggle.setAttribute("aria-label", nextLabel);
			themeToggle.setAttribute("title", nextLabel);
			themeToggle.setAttribute("aria-pressed", String(theme === "dark"));
		};

		const setMenuOpen = (isOpen: boolean, options: { focusNav?: boolean; restoreFocus?: boolean } = {}) => {
			if (!header || !nav || !menuToggle) return;
			header.classList.toggle("is-menu-open", isOpen);
			menuToggle.setAttribute("aria-expanded", String(isOpen));
			menuToggle.setAttribute("aria-label", isOpen ? "關閉導覽選單" : "開啟導覽選單");
			nav.toggleAttribute("inert", mobileMenu.matches && !isOpen);
			nav.setAttribute("aria-hidden", String(mobileMenu.matches && !isOpen));

			if (isOpen && options.focusNav) {
				window.requestAnimationFrame(() => nav.querySelector<HTMLAnchorElement>("a[href]")?.focus());
			}

			if (!isOpen && options.restoreFocus) {
				menuToggle.focus();
			}
		};

		menuToggle?.addEventListener(
			"click",
			() => {
				const nextOpen = !(header?.classList.contains("is-menu-open") ?? false);
				setMenuOpen(nextOpen, { focusNav: nextOpen });
			},
			{ signal }
		);

		themeToggle?.addEventListener(
			"click",
			() => {
				const nextTheme = getTheme() === "dark" ? "light" : "dark";
				try {
					window.localStorage.setItem(themeStorageKey, nextTheme);
				} catch {
					// Keep the current page usable if storage is unavailable.
				}
				applyTheme(nextTheme);
			},
			{ signal }
		);

		nav?.addEventListener(
			"click",
			event => {
				if (event.target instanceof HTMLAnchorElement) setMenuOpen(false);
			},
			{ signal }
		);

		window.addEventListener(
			"keydown",
			event => {
				if (event.key === "Escape" && header?.classList.contains("is-menu-open")) {
					setMenuOpen(false, { restoreFocus: true });
				}
			},
			{ signal }
		);

		mobileMenu.addEventListener(
			"change",
			event => {
				if (!event.matches) setMenuOpen(false);
				else setMenuOpen(header?.classList.contains("is-menu-open") ?? false);
			},
			{ signal }
		);

		setMenuOpen(false);
		applyTheme(getTheme());

		return () => controller.abort();
	});
</script>

<style>
	.site-header-container {
		position: sticky;
		top: 0;
		z-index: 20;
		margin-inline: calc(var(--page-padding, 0rem) * -1);
		padding-inline: var(--page-padding, 0rem);
		border-bottom: 1px solid var(--color-border);
		background: var(--color-header-bg);
		backdrop-filter: blur(1.25rem);
	}

	@media (max-width: 43rem), (max-height: 32rem) {
		.site-header-container {
			position: static;
		}
	}

	.site-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: var(--site-width);
		margin: auto;
		min-height: 4rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		width: fit-content;
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--color-ink);
	}

	.brand img {
		width: 1.75rem;
		height: auto;
	}

	.main-nav {
		display: flex;
		align-items: stretch;
		gap: 2rem;
		font-size: 1rem;
		color: var(--color-muted);
		height: 100%;
	}

	.main-nav a {
		position: relative;
		display: flex;
		align-items: center;
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.main-nav a::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 0.25rem;
		content: "";
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.main-nav a:hover,
	.main-nav a.active {
		color: var(--color-ink);
	}

	.main-nav a:hover::after,
	.main-nav a.active::after {
		transform: scaleX(1);
	}

	.site-actions {
		display: inline-flex;
		justify-self: end;
		align-items: center;
		gap: 0.5rem;
	}

	.theme-toggle {
		position: relative;
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		width: 2.875rem;
		height: 1.625rem;
		overflow: hidden;
		color: var(--color-muted);
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
		transition:
			background 160ms ease,
			border-color 160ms ease;
	}

	.theme-toggle::after {
		position: absolute;
		inset: 0 auto 0 0;
		width: 50%;
		content: "";
		background: var(--color-surface);
		border-right: 1px solid var(--color-accent);
		transition:
			background 160ms ease,
			border-color 160ms ease,
			transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.theme-toggle:hover,
	.theme-toggle:focus-visible {
		color: var(--color-ink);
		border-color: var(--color-accent);
	}

	.theme-toggle[data-theme-state="dark"] {
		color: var(--color-ink);
		background: var(--color-accent-strong);
		border-color: var(--color-accent-strong);
	}

	.theme-toggle[data-theme-state="dark"]::after {
		background: var(--color-surface);
		border-right: 0;
		border-left: 1px solid var(--color-surface);
		transform: translateX(100%);
	}

	.theme-icon {
		position: absolute;
		top: 50%;
		z-index: 1;
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.7);
		transition:
			opacity 140ms ease,
			transform 160ms ease;
	}

	.theme-icon-light {
		left: 0.75rem;
	}

	.theme-icon-dark {
		left: 2.125rem;
	}

	.theme-toggle[data-theme-state="light"] .theme-icon-light,
	.theme-toggle[data-theme-state="dark"] .theme-icon-dark {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}

	.search-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 8rem;
		padding: 0.5rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1;
		color: var(--color-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 0 0 1px var(--color-inset-highlight);
	}

	.search-button kbd {
		padding: 0.25rem 0.25rem;
		font-family: inherit;
		font-size: 0.75rem;
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}

	.search-button span {
		color: var(--color-text);
	}

	.menu-button {
		display: none;
		position: relative;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		overflow: hidden;
		color: var(--color-ink);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.menu-button svg {
		position: absolute;
		transition:
			opacity 140ms ease,
			transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.menu-button .close-icon {
		opacity: 0;
		transform: scale(0.45);
	}

	@media (max-width: 56rem) {
		.site-header {
			grid-template-columns: auto minmax(0, 1fr) auto;
			column-gap: 1rem;
		}

		.main-nav {
			justify-content: center;
			gap: 1.25rem;
		}
	}

	@media (max-width: 43rem) {
		.site-header-container {
			overflow: visible;
		}

		.site-header {
			position: relative;
			grid-template-columns: 1fr auto auto;
			column-gap: 0.5rem;
			row-gap: 0;
			padding-block: 0.65rem;
		}

		.brand {
			min-width: 0;
			gap: 0.55rem;
			font-size: 0.95rem;
		}

		.brand span {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.main-nav {
			position: absolute;
			top: calc(100% + 1px);
			right: 0;
			left: 0;
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 0;
			height: auto;
			padding: 0.35rem;
			font-size: 1rem;
			background: var(--color-header-menu-bg);
			border: 1px solid var(--color-border);
			box-shadow: var(--shadow-menu);
			backdrop-filter: blur(1.25rem);
			opacity: 0;
			pointer-events: none;
			transform: translateY(-0.85rem);
			transition:
				opacity 180ms ease,
				transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
		}

		.site-header.is-menu-open .main-nav {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.main-nav a {
			justify-content: center;
			min-height: 2.75rem;
			padding-inline: 0.75rem;
		}

		.main-nav a::after {
			right: 0.75rem;
			bottom: 0;
			left: 0;
			height: 0.2rem;
			transform: scaleX(0);
			transform-origin: center;
		}

		.main-nav a:hover::after,
		.main-nav a.active::after {
			transform: scaleX(1);
		}

		.search-button {
			min-width: 2.5rem;
			padding: 0.65rem;
		}

		.search-button span,
		.search-button kbd {
			display: none;
		}

		.menu-button {
			display: inline-flex;
		}

		.site-header.is-menu-open .menu-button .menu-icon {
			opacity: 0;
			transform: scale(0.45);
		}

		.site-header.is-menu-open .menu-button .close-icon {
			opacity: 1;
			transform: scale(1);
			transition-delay: 80ms;
		}

		.site-header:not(.is-menu-open) .menu-button .menu-icon {
			transition-delay: 80ms;
		}
	}
</style>
