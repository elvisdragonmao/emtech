---
import { MessageSquare } from "@lucide/astro";
import { siGithub, siRss } from "simple-icons";
import SimpleIcon from "@/components/shared/SimpleIcon.astro";
---

<footer class="site-footer">
	<a class="footer-action" href="/" aria-label="毛哥EM資訊密技首頁"><img src="/img/logo.svg" alt="" class="footer-logo" width="32" height="37" /></a>
	<div class="footer-brand">
		<p>©2021 - 2026 By 毛哥EM</p>
		<p>原創文章採 <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noreferrer">CC BY-SA 4.0（另開新視窗）</a> 授權，轉載請註明來源。</p>
	</div>
	<a class="footer-action" href="https://github.com/elvisdragonmao/emtech/issues" target="_blank" rel="noreferrer" aria-label="到 GitHub Issues 留言（另開新視窗）">
		<MessageSquare size={21} stroke-width={1.7} aria-hidden="true" />
	</a>
	<a class="footer-action" href="https://github.com/elvisdragonmao/emtech" target="_blank" rel="noreferrer" aria-label="GitHub 專案（另開新視窗）"><SimpleIcon icon={siGithub} size={21} /></a>
	<a class="footer-action" href="/rss.xml" aria-label="RSS 訂閱"><SimpleIcon icon={siRss} size={21} /></a>
</footer>

<style>
	.site-footer {
		display: flex;
		gap: 1rem;
		width: 100%;
		margin: 4rem 0 2rem;
		padding-inline: 1rem;
		backdrop-filter: blur(0.75rem);
		border-inline: none;
		color: var(--color-muted);
		font-size: 0.75rem;
		border-block: 1px solid var(--color-border);
	}

	.site-footer > * {
		border-inline: 1px solid var(--color-border);
	}

	.footer-logo {
		width: 2rem;
	}

	.footer-brand {
		flex: 1;
		padding: 1.25rem;
		line-height: 1;
	}

	.footer-brand p:first-child {
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 0.75rem;
	}

	.footer-brand a {
		color: var(--color-accent-strong);
		transition: color 160ms ease;
	}

	.footer-action {
		display: grid;
		place-items: center;
		color: var(--color-muted);
		transition:
			color 160ms ease,
			background 160ms ease;
		width: 5rem;
	}

	.footer-action:hover {
		color: var(--color-accent-strong);
		background: var(--color-accent-soft);
	}

	@media (max-width: 43rem) {
		.site-footer {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 0;
			width: calc(100% + 2rem);
			margin-left: -1rem;
			padding-inline: 0;
		}

		.footer-brand {
			grid-column: 1 / -1;
			grid-row: 2;
			padding: 1rem;
			line-height: 1.45;
			border-top: 1px solid var(--color-border);
		}

		.footer-action {
			width: auto;
			min-height: 3.5rem;
		}
	}
</style>
