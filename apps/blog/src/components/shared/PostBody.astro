---
import { ArrowLeft, ArrowRight, X, ZoomIn, ZoomOut } from "@lucide/astro";
import type { ImageInput, MetaItem, TocHeading } from "@/utils/content";
import MetaTable from "./MetaTable.astro";

type TagLink = {
	label: string;
	href: string;
};

interface Props {
	tag: string;
	tagLinks?: TagLink[];
	title: string;
	image?: ImageInput;
	meta: MetaItem[];
	tldr?: string;
	headings?: TocHeading[];
	previousHref?: string;
	previousTitle?: string;
	nextHref?: string;
	nextTitle?: string;
	progressStorageKey?: string;
	progressItemId?: string;
	layout?: "post" | "course";
}

const { tag, tagLinks = [], title, image, meta, tldr, headings = [], previousHref, previousTitle, nextHref, nextTitle, progressStorageKey, progressItemId, layout = "post" } = Astro.props;
const imageSrc = typeof image === "string" ? image : image?.src;
const imageWidth = typeof image === "string" ? undefined : image?.width;
const imageHeight = typeof image === "string" ? undefined : image?.height;

// Only show TOC headings at depth 2 and 3
const tocItems = headings.filter(h => h.depth === 2 || h.depth === 3);
const isCourseLayout = layout === "course";
const pagefindType = isCourseLayout ? "課程" : "文章";
const pagefindDate = meta.find(item => item.label === "Date")?.value ?? "";
---

<section class:list={["article-hero", { "course-layout": isCourseLayout }]}>
	<div></div>
	<div class="hero-main">
		{
			tagLinks.length > 0 ? (
				<div class="tag" aria-label="文章標籤">
					{tagLinks.map((link, index) => (
						<>
							<a href={link.href}>{link.label}</a>
							{index < tagLinks.length - 1 && " "}
						</>
					))}
				</div>
			) : (
				<p class="tag">{tag}</p>
			)
		}
		<h1 data-pagefind-meta="title">{title}</h1>
		<MetaTable items={meta} />
	</div>
	{
		!isCourseLayout && (
			<aside class="hero-side-nav" aria-label="文章導覽">
				{(previousHref || nextHref) && (
					<div class="side-nav">
						{previousHref && (
							<a href={previousHref}>
								<ArrowLeft size={14} stroke-width={1.8} aria-hidden="true" />
								<span>上一篇</span>
								<strong>{previousTitle ?? "上一篇"}</strong>
							</a>
						)}
						{nextHref && (
							<a href={nextHref}>
								<strong>{nextTitle ?? "下一篇"}</strong>
								<span>下一篇</span>
								<ArrowRight size={14} stroke-width={1.8} aria-hidden="true" />
							</a>
						)}
					</div>
				)}
			</aside>
		)
	}
</section>

<section class:list={["article-shell", { "course-layout": isCourseLayout }]}>
	<aside class="toc" aria-label="文章目錄">
		{
			tocItems.length > 0 ? (
				<>
					<span class="toc-label">本頁目錄</span>
					{tocItems.map(item => (
						<a href={`#${item.slug}`} class:list={[{ "toc-h3": item.depth === 3 }]} data-toc-link={item.slug}>
							{item.text}
						</a>
					))}
				</>
			) : null
		}
	</aside>

	<article id="content" class="article-content" data-pagefind-body data-progress-storage-key={progressStorageKey} data-progress-item-id={progressItemId}>
		<span class="sr-only" data-pagefind-meta="type">{pagefindType}</span>
		{
			pagefindDate && (
				<span class="sr-only" data-pagefind-meta="date" data-pagefind-sort="date">
					{pagefindDate}
				</span>
			)
		}
		{imageSrc && <img class="hero-image" src={imageSrc} width={imageWidth} height={imageHeight} alt={title} />}
		{
			tldr && (
				<aside class="tldr-callout">
					<strong>簡單來說</strong>
					<p>{tldr}</p>
					<span aria-hidden="true">TL;DR</span>
				</aside>
			)
		}
		<slot />
		<div data-read-complete-sentinel aria-hidden="true"></div>
	</article>

	<div></div>
</section>

<div class:list={["reading-toast", { "course-layout": isCourseLayout }]} data-reading-toast role="status" aria-live="polite" hidden>閱讀完成已紀錄</div>

<div class="image-preview-overlay" data-image-preview-overlay hidden>
	<div class="image-preview-backdrop" data-image-preview-backdrop aria-hidden="true"></div>
	<section class="image-preview-dialog" data-image-preview-dialog role="dialog" aria-modal="true" aria-labelledby="image-preview-title" aria-describedby="image-preview-help" tabindex="-1">
		<p id="image-preview-title" class="sr-only">圖片預覽</p>
		<div class="image-preview-stage" data-image-preview-stage tabindex="0">
			<div class="image-preview-canvas" data-image-preview-canvas>
				<img data-image-preview-image alt="" draggable="false" />
			</div>
		</div>
		<p class="image-preview-caption" data-image-preview-caption hidden></p>
		<div class="image-preview-controls" aria-label="圖片預覽控制項">
			<button class="image-preview-control" type="button" data-image-preview-zoom-in aria-label="放大圖片，目前 100%" title="放大圖片">
				<ZoomIn size={22} stroke-width={1.9} aria-hidden="true" />
			</button>
			<button class="image-preview-control" type="button" data-image-preview-zoom-out aria-label="縮小圖片，目前 100%" title="縮小圖片">
				<ZoomOut size={22} stroke-width={1.9} aria-hidden="true" />
			</button>
			<button class="image-preview-control" type="button" data-image-preview-close aria-label="關閉圖片預覽" title="關閉圖片預覽">
				<X size={22} stroke-width={1.9} aria-hidden="true" />
			</button>
		</div>
		<p id="image-preview-help" class="sr-only" data-image-preview-live aria-live="polite">按 Escape 關閉圖片預覽。使用放大和縮小按鈕調整圖片大小；圖片放大後可捲動查看細節。</p>
	</section>
</div>

<script>
	import { setupPageLifecycle } from "@/scripts/pageLifecycle";

	setupPageLifecycle("post-body", () => {
		const controller = new AbortController();
		const { signal } = controller;
		let readObserver: IntersectionObserver | null = null;
		let embedObserver: MutationObserver | null = null;
		let toastHideTimer = 0;
		let toastHiddenTimer = 0;
		let previewResizeFrame = 0;
		let articleImageResizeFrame = 0;
		const copyResetTimers = new Set<number>();
		const tocContainer = document.querySelector<HTMLElement>("aside.toc");
		const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
		const tocHeadings = tocLinks
			.map(link => {
				const id = link.dataset.tocLink;
				const heading = id ? document.getElementById(id) : null;
				return heading ? { id, heading, link } : null;
			})
			.filter((item): item is { id: string; heading: HTMLElement; link: HTMLAnchorElement } => Boolean(item));

		const setActiveToc = (id: string) => {
			for (const { id: itemId, link } of tocHeadings) {
				const isActive = itemId === id;
				link.classList.toggle("active", isActive);
				if (isActive) {
					link.setAttribute("aria-current", "location");
					if (tocContainer) {
						tocContainer.scrollTo({ top: link.offsetTop - tocContainer.clientHeight / 2, behavior: "smooth" });
					}
				} else {
					link.removeAttribute("aria-current");
				}
			}
		};

		let tocFrame = 0;
		const updateToc = () => {
			tocFrame = 0;
			const firstHeading = tocHeadings[0];
			if (!firstHeading) return;

			const active = tocHeadings.reduce((current, item) => {
				const top = item.heading.getBoundingClientRect().top;
				return top <= 120 ? item : current;
			}, firstHeading);

			setActiveToc(active.id);
		};

		const queueTocUpdate = () => {
			if (tocFrame) return;
			tocFrame = window.requestAnimationFrame(updateToc);
		};

		if (tocHeadings.length > 0) {
			updateToc();
			window.addEventListener("scroll", queueTocUpdate, { passive: true, signal });
			window.addEventListener("resize", queueTocUpdate, { signal });
		}

		const articleContent = document.querySelector<HTMLElement>(".article-content");
		const imagePreviewOverlay = document.querySelector<HTMLElement>("[data-image-preview-overlay]");
		const imagePreviewBackdrop = imagePreviewOverlay?.querySelector<HTMLElement>("[data-image-preview-backdrop]");
		const imagePreviewDialog = imagePreviewOverlay?.querySelector<HTMLElement>("[data-image-preview-dialog]");
		const imagePreviewStage = imagePreviewOverlay?.querySelector<HTMLElement>("[data-image-preview-stage]");
		const imagePreviewCanvas = imagePreviewOverlay?.querySelector<HTMLElement>("[data-image-preview-canvas]");
		const imagePreviewImage = imagePreviewOverlay?.querySelector<HTMLImageElement>("[data-image-preview-image]");
		const imagePreviewCaption = imagePreviewOverlay?.querySelector<HTMLElement>("[data-image-preview-caption]");
		const imagePreviewLive = imagePreviewOverlay?.querySelector<HTMLElement>("[data-image-preview-live]");
		const imagePreviewZoomOut = imagePreviewOverlay?.querySelector<HTMLButtonElement>("[data-image-preview-zoom-out]");
		const imagePreviewZoomIn = imagePreviewOverlay?.querySelector<HTMLButtonElement>("[data-image-preview-zoom-in]");
		const imagePreviewClose = imagePreviewOverlay?.querySelector<HTMLButtonElement>("[data-image-preview-close]");
		const imagePreviewFocusableSelector = "a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex='-1'])";
		const minPreviewZoom = 0.5;
		const maxPreviewZoom = 4;
		const previewZoomStep = 0.25;
		const previewReturnMs = 340;
		const previewReleaseMs = 190;
		let activePreviewTrigger: HTMLElement | null = null;
		let activePreviewSourceImage: HTMLImageElement | null = null;
		let previewZoom = 1;
		let previewBaseWidth = 0;
		let previewBaseHeight = 0;
		let previewReleaseTimer = 0;
		let previewCloseTimer = 0;
		const embeddedFrameTitle = (frame: HTMLIFrameElement) => {
			const src = frame.getAttribute("src") ?? "";
			if (/instagram\.com/i.test(src) || frame.classList.contains("instagram-media")) return "Instagram 貼文嵌入內容";
			if (/youtube(?:-nocookie)?\.com|youtu\.be/i.test(src)) return "YouTube 影片嵌入內容";
			if (/facebook\.com/i.test(src)) return "Facebook 貼文嵌入內容";
			if (/codepen\.io/i.test(src)) return "CodePen 範例嵌入內容";
			return "嵌入內容";
		};
		const ensureFrameTitle = (frame: HTMLIFrameElement) => {
			const hasName = frame.getAttribute("title")?.trim() || frame.getAttribute("aria-label")?.trim() || frame.getAttribute("aria-labelledby")?.trim();
			if (!hasName) frame.title = embeddedFrameTitle(frame);
		};
		const ensureFrameTitles = (root: ParentNode) => {
			if (root instanceof HTMLIFrameElement) {
				ensureFrameTitle(root);
				return;
			}

			for (const frame of root.querySelectorAll<HTMLIFrameElement>("iframe")) {
				ensureFrameTitle(frame);
			}
		};
		const isAnimatedGif = (image: HTMLImageElement) => {
			const source = image.currentSrc || image.getAttribute("src") || "";
			if (!source) return false;

			try {
				return new URL(source, window.location.href).pathname.toLowerCase().endsWith(".gif");
			} catch {
				return source.toLowerCase().split("?")[0].endsWith(".gif");
			}
		};
		let animatedImageControlIndex = 0;
		const ensureAnimatedImageControl = (image: HTMLImageElement) => {
			if (image.dataset.animationControlReady === "true" || !isAnimatedGif(image)) return;

			image.dataset.animationControlReady = "true";
			if (!image.id) {
				animatedImageControlIndex += 1;
				image.id = `animated-image-${animatedImageControlIndex}`;
			}

			const control = document.createElement("button");
			const imageLabel = image.alt.trim();
			control.type = "button";
			control.className = "animated-image-toggle";
			control.setAttribute("aria-controls", image.id);
			control.setAttribute("aria-pressed", "false");
			if (imageLabel) control.setAttribute("aria-label", `隱藏動畫圖片：${imageLabel}`);

			const setHidden = (hidden: boolean) => {
				image.hidden = hidden;
				control.textContent = hidden ? "顯示動畫圖片" : "隱藏動畫圖片";
				control.setAttribute("aria-pressed", String(hidden));
				if (imageLabel) control.setAttribute("aria-label", `${hidden ? "顯示" : "隱藏"}動畫圖片：${imageLabel}`);
			};

			setHidden(false);
			control.addEventListener("click", () => setHidden(!image.hidden), { signal });
			image.after(control);
		};
		const ensureAnimatedImageControls = (root: ParentNode) => {
			if (root instanceof HTMLImageElement) {
				ensureAnimatedImageControl(root);
				return;
			}

			for (const image of root.querySelectorAll<HTMLImageElement>("img")) {
				ensureAnimatedImageControl(image);
			}
		};
		const clampPreviewZoom = (zoom: number) => Math.min(maxPreviewZoom, Math.max(minPreviewZoom, Math.round(zoom * 100) / 100));
		const isImageHref = (href: string) => {
			try {
				return /\.(?:avif|gif|jpe?g|png|svg|webp)$/i.test(new URL(href, window.location.href).pathname);
			} catch {
				return /\.(?:avif|gif|jpe?g|png|svg|webp)(?:[?#].*)?$/i.test(href);
			}
		};
		const imageSource = (image: HTMLImageElement) => image.currentSrc || image.src || image.getAttribute("src") || "";
		const sameImageHref = (href: string, image: HTMLImageElement) => {
			const source = imageSource(image);
			if (!source) return false;

			try {
				return new URL(href, window.location.href).href === new URL(source, window.location.href).href;
			} catch {
				return href === source;
			}
		};
		const imageCaption = (image: HTMLImageElement) => image.closest("figure")?.querySelector("figcaption")?.textContent?.trim() || image.alt.trim() || image.title.trim();
		const articleImageMaxHeight = () => {
			const rootFontSize = Number.parseFloat(window.getComputedStyle(document.documentElement).fontSize) || 16;
			return Math.max(1, Math.min(rootFontSize * 34, window.innerHeight * 0.82));
		};
		const imageIntrinsicSize = (image: HTMLImageElement) => {
			const width = image.naturalWidth || Number.parseFloat(image.getAttribute("width") ?? "");
			const height = image.naturalHeight || Number.parseFloat(image.getAttribute("height") ?? "");
			return width > 0 && height > 0 ? { width, height } : null;
		};
		const fitArticleImageTrigger = (trigger: HTMLElement) => {
			const image = trigger.querySelector("img");
			if (!(image instanceof HTMLImageElement)) return;

			const intrinsicSize = imageIntrinsicSize(image);
			const container = trigger.parentElement ?? articleContent;
			const availableWidth = container ? container.getBoundingClientRect().width : window.innerWidth;
			if (!intrinsicSize || availableWidth <= 0) return;

			const fitRatio = Math.min(1, availableWidth / intrinsicSize.width, articleImageMaxHeight() / intrinsicSize.height);
			const width = Math.max(1, intrinsicSize.width * fitRatio);
			const height = Math.max(1, intrinsicSize.height * fitRatio);

			trigger.style.width = `${width}px`;
			trigger.style.height = `${height}px`;
			image.style.width = "100%";
			image.style.height = "100%";
		};
		const fitArticleImageTriggers = () => {
			if (!articleContent) return;
			for (const trigger of articleContent.querySelectorAll<HTMLElement>(".image-preview-trigger")) {
				fitArticleImageTrigger(trigger);
			}
		};
		const queueArticleImageFit = () => {
			if (articleImageResizeFrame) return;
			articleImageResizeFrame = window.requestAnimationFrame(() => {
				articleImageResizeFrame = 0;
				fitArticleImageTriggers();
			});
		};
		const imageTriggerLabel = (image: HTMLImageElement) => {
			const caption = imageCaption(image);
			return caption ? `開啟圖片預覽：${caption}` : "開啟圖片預覽";
		};
		const onlyImageAnchor = (image: HTMLImageElement) => {
			const anchor = image.closest("a");
			if (!anchor || anchor.closest("[data-image-preview-overlay]")) return null;
			const meaningfulChildren = Array.from(anchor.childNodes).filter(node => {
				if (node === image) return true;
				if (node.nodeType === Node.TEXT_NODE) return Boolean(node.textContent?.trim());
				return true;
			});

			return meaningfulChildren.length === 1 && meaningfulChildren[0] === image ? anchor : null;
		};
		const previewSourceFor = (image: HTMLImageElement, trigger: HTMLElement) => trigger.dataset.imagePreviewSrc || imageSource(image);
		const previewFocusableElements = () =>
			imagePreviewOverlay
				? Array.from(imagePreviewOverlay.querySelectorAll<HTMLElement>(imagePreviewFocusableSelector)).filter(element => !element.hasAttribute("disabled") && element.getClientRects().length > 0)
				: [];
		const previewSourceRect = () => {
			const image = activePreviewSourceImage;
			if (!image?.isConnected) return null;

			const rect = image.getBoundingClientRect();
			if (rect.width <= 0 || rect.height <= 0) return null;
			return rect;
		};
		const imageNaturalSize = () => {
			const naturalWidth = imagePreviewImage?.naturalWidth || activePreviewSourceImage?.naturalWidth || previewBaseWidth || 1;
			const naturalHeight = imagePreviewImage?.naturalHeight || activePreviewSourceImage?.naturalHeight || previewBaseHeight || 1;
			return { naturalWidth, naturalHeight };
		};
		const previewFitSize = () => {
			const { naturalWidth, naturalHeight } = imageNaturalSize();
			const fitWidth = Math.max(1, window.innerWidth - 96);
			const fitHeight = Math.max(1, window.innerHeight - 96);
			const fitRatio = Math.min(fitWidth / naturalWidth, fitHeight / naturalHeight, 1);

			previewBaseWidth = Math.max(1, naturalWidth * fitRatio);
			previewBaseHeight = Math.max(1, naturalHeight * fitRatio);
			return { width: previewBaseWidth * previewZoom, height: previewBaseHeight * previewZoom };
		};
		const positionPreviewImage = (announce = false, anchor: { clientX: number; clientY: number } | null = null) => {
			if (!imagePreviewImage || !imagePreviewStage || !imagePreviewCanvas || imagePreviewOverlay?.hidden) return;

			const previousScrollWidth = Math.max(imagePreviewStage.scrollWidth, 1);
			const previousScrollHeight = Math.max(imagePreviewStage.scrollHeight, 1);
			const scrollX = (imagePreviewStage.scrollLeft + imagePreviewStage.clientWidth / 2) / previousScrollWidth;
			const scrollY = (imagePreviewStage.scrollTop + imagePreviewStage.clientHeight / 2) / previousScrollHeight;
			const previousRect = imagePreviewImage.getBoundingClientRect();
			const anchorXRatio = previousRect.width > 0 && anchor ? (anchor.clientX - previousRect.left) / previousRect.width : 0.5;
			const anchorYRatio = previousRect.height > 0 && anchor ? (anchor.clientY - previousRect.top) / previousRect.height : 0.5;
			const { width, height } = previewFitSize();
			const canvasWidth = Math.max(window.innerWidth, width + 64);
			const canvasHeight = Math.max(window.innerHeight, height + 64);
			const left = Math.max(32, (canvasWidth - width) / 2);
			const top = Math.max(32, (canvasHeight - height) / 2);
			const percent = `${Math.round(previewZoom * 100)}%`;

			imagePreviewCanvas.style.width = `${canvasWidth}px`;
			imagePreviewCanvas.style.height = `${canvasHeight}px`;
			imagePreviewImage.style.left = `${left}px`;
			imagePreviewImage.style.top = `${top}px`;
			imagePreviewImage.style.width = `${width}px`;
			imagePreviewImage.style.height = `${height}px`;
			imagePreviewStage.classList.toggle("is-zoomed", previewZoom > 1.01);
			imagePreviewStage.classList.toggle("is-max-zoom", previewZoom >= maxPreviewZoom);
			if (imagePreviewZoomOut) {
				imagePreviewZoomOut.disabled = previewZoom <= minPreviewZoom;
				imagePreviewZoomOut.setAttribute("aria-label", `縮小圖片，目前 ${percent}`);
			}
			if (imagePreviewZoomIn) {
				imagePreviewZoomIn.disabled = previewZoom >= maxPreviewZoom;
				imagePreviewZoomIn.setAttribute("aria-label", `放大圖片，目前 ${percent}`);
			}

			requestAnimationFrame(() => {
				if (!imagePreviewStage) return;
				if (anchor && imagePreviewImage && previousRect.width > 0 && previousRect.height > 0) {
					const nextRect = imagePreviewImage.getBoundingClientRect();
					const nextAnchorX = nextRect.left + nextRect.width * anchorXRatio;
					const nextAnchorY = nextRect.top + nextRect.height * anchorYRatio;
					imagePreviewStage.scrollTo({
						left: Math.max(0, imagePreviewStage.scrollLeft + nextAnchorX - anchor.clientX),
						top: Math.max(0, imagePreviewStage.scrollTop + nextAnchorY - anchor.clientY)
					});
				} else {
					const nextLeft = imagePreviewStage.scrollWidth * scrollX - imagePreviewStage.clientWidth / 2;
					const nextTop = imagePreviewStage.scrollHeight * scrollY - imagePreviewStage.clientHeight / 2;
					imagePreviewStage.scrollTo({ left: Math.max(0, nextLeft), top: Math.max(0, nextTop) });
				}
			});

			if (announce && imagePreviewLive) imagePreviewLive.textContent = `圖片縮放 ${percent}`;
		};
		const setPreviewZoom = (nextZoom: number, announce = true, anchor: { clientX: number; clientY: number } | null = null) => {
			previewZoom = clampPreviewZoom(nextZoom);
			positionPreviewImage(announce, anchor);
		};
		const placePreviewAtRect = (rect: DOMRect) => {
			if (!imagePreviewImage || !imagePreviewCanvas) return;
			imagePreviewCanvas.style.width = `${window.innerWidth}px`;
			imagePreviewCanvas.style.height = `${window.innerHeight}px`;
			imagePreviewImage.style.left = `${rect.left}px`;
			imagePreviewImage.style.top = `${rect.top}px`;
			imagePreviewImage.style.width = `${rect.width}px`;
			imagePreviewImage.style.height = `${rect.height}px`;
		};
		const movePreviewBackToRect = (rect: DOMRect) => {
			if (!imagePreviewImage || !imagePreviewCanvas || !imagePreviewStage) return;

			const currentRect = imagePreviewImage.getBoundingClientRect();
			imagePreviewImage.style.transition = "none";
			imagePreviewStage.scrollTo({ left: 0, top: 0 });
			imagePreviewCanvas.style.width = `${window.innerWidth}px`;
			imagePreviewCanvas.style.height = `${window.innerHeight}px`;
			imagePreviewImage.style.left = `${currentRect.left}px`;
			imagePreviewImage.style.top = `${currentRect.top}px`;
			imagePreviewImage.style.width = `${currentRect.width}px`;
			imagePreviewImage.style.height = `${currentRect.height}px`;
			imagePreviewImage.getBoundingClientRect();
			imagePreviewImage.style.removeProperty("transition");
			placePreviewAtRect(rect);
		};
		const updatePreviewFit = () => {
			positionPreviewImage(false);
		};
		const queuePreviewFit = () => {
			if (previewResizeFrame) return;
			previewResizeFrame = window.requestAnimationFrame(() => {
				previewResizeFrame = 0;
				updatePreviewFit();
			});
		};
		const restorePreviewSourceVisibility = () => {
			const sourceImage = activePreviewSourceImage;
			if (!sourceImage) {
				activePreviewTrigger?.classList.remove("is-preview-source-hidden");
				return;
			}

			const previousTransition = sourceImage.style.transition;
			sourceImage.style.transition = "none";
			activePreviewTrigger?.classList.remove("is-preview-source-hidden");
			sourceImage.classList.remove("is-preview-source-hidden");
			sourceImage.getBoundingClientRect();
			requestAnimationFrame(() => {
				if (!sourceImage.isConnected) return;
				if (previousTransition) sourceImage.style.transition = previousTransition;
				else sourceImage.style.removeProperty("transition");
			});
		};
		const finishCloseImagePreview = (restoreFocus: boolean) => {
			if (!imagePreviewOverlay || !imagePreviewImage) return;

			window.clearTimeout(previewReleaseTimer);
			window.clearTimeout(previewCloseTimer);
			restorePreviewSourceVisibility();
			imagePreviewOverlay.hidden = true;
			imagePreviewOverlay.classList.remove("is-open", "is-closing", "is-releasing");
			document.documentElement.classList.remove("image-preview-open");
			activePreviewTrigger?.setAttribute("aria-expanded", "false");
			if (restoreFocus && activePreviewTrigger?.isConnected) activePreviewTrigger.focus();
			activePreviewTrigger = null;
			activePreviewSourceImage = null;
			imagePreviewImage.removeAttribute("src");
			imagePreviewImage.alt = "";
			imagePreviewImage.removeAttribute("style");
			imagePreviewCanvas?.removeAttribute("style");
		};
		const closeImagePreview = (restoreFocus = true) => {
			if (!imagePreviewOverlay || !imagePreviewImage || imagePreviewOverlay.hidden || imagePreviewOverlay.classList.contains("is-closing")) return;

			window.clearTimeout(previewReleaseTimer);
			window.clearTimeout(previewCloseTimer);
			const sourceRect = previewSourceRect();
			imagePreviewOverlay.classList.add("is-closing");
			imagePreviewOverlay.classList.remove("is-open", "is-releasing");
			if (sourceRect) movePreviewBackToRect(sourceRect);
			previewReleaseTimer = window.setTimeout(
				() => {
					restorePreviewSourceVisibility();
					imagePreviewOverlay.classList.add("is-releasing");
					previewCloseTimer = window.setTimeout(() => finishCloseImagePreview(restoreFocus), previewReleaseMs);
				},
				sourceRect ? previewReturnMs : 1
			);
		};
		const openImagePreview = (image: HTMLImageElement, trigger: HTMLElement) => {
			if (!imagePreviewOverlay || !imagePreviewDialog || !imagePreviewImage || !imagePreviewCaption || !imagePreviewLive || !imagePreviewStage) return;

			const source = previewSourceFor(image, trigger);
			if (!source) return;
			const sourceRect = image.getBoundingClientRect();
			if (sourceRect.width <= 0 || sourceRect.height <= 0) return;

			window.clearTimeout(previewReleaseTimer);
			window.clearTimeout(previewCloseTimer);
			activePreviewTrigger?.setAttribute("aria-expanded", "false");
			activePreviewTrigger?.classList.remove("is-preview-source-hidden");
			activePreviewSourceImage?.classList.remove("is-preview-source-hidden");
			activePreviewTrigger = trigger;
			activePreviewSourceImage = image;
			previewZoom = 1;
			previewBaseWidth = sourceRect.width;
			previewBaseHeight = sourceRect.height;

			const caption = imageCaption(image);
			imagePreviewImage.alt = image.alt.trim();
			imagePreviewImage.src = source;
			imagePreviewCaption.textContent = caption;
			imagePreviewCaption.hidden = !caption;
			imagePreviewLive.textContent = "圖片預覽已開啟。按 Escape 關閉，或使用放大和縮小按鈕調整圖片大小。";
			trigger.setAttribute("aria-expanded", "true");
			imagePreviewOverlay.hidden = false;
			imagePreviewOverlay.classList.remove("is-open", "is-closing", "is-releasing");
			document.documentElement.classList.add("image-preview-open");
			imagePreviewStage.scrollTo({ left: 0, top: 0 });
			placePreviewAtRect(sourceRect);
			trigger.classList.add("is-preview-source-hidden");
			image.classList.add("is-preview-source-hidden");
			requestAnimationFrame(() => {
				imagePreviewOverlay.classList.add("is-open");
				imagePreviewDialog.focus();
				positionPreviewImage(false);
			});
		};
		const ensureImagePreviewTrigger = (image: HTMLImageElement) => {
			if (image.dataset.imagePreviewReady === "true") {
				const trigger = image.closest<HTMLElement>(".image-preview-trigger");
				if (trigger) fitArticleImageTrigger(trigger);
				return;
			}
			if (image.closest("[data-image-preview-overlay], picture")) return;

			const label = imageTriggerLabel(image);
			const anchor = onlyImageAnchor(image);
			if (anchor) {
				if (!isImageHref(anchor.href) && !sameImageHref(anchor.href, image)) return;
				image.dataset.imagePreviewReady = "true";
				anchor.dataset.imagePreviewSrc = anchor.href;
				anchor.classList.add("image-preview-trigger");
				if (image.classList.contains("hero-image")) anchor.classList.add("hero-image-preview-trigger");
				anchor.setAttribute("aria-haspopup", "dialog");
				anchor.setAttribute("aria-expanded", "false");
				anchor.setAttribute("aria-label", label);
				fitArticleImageTrigger(anchor);
				if (!image.complete) image.addEventListener("load", () => fitArticleImageTrigger(anchor), { once: true, signal });
				return;
			}

			if (image.closest("a, button")) return;

			const parent = image.parentNode;
			if (!parent) return;

			image.dataset.imagePreviewReady = "true";
			const button = document.createElement("button");
			button.type = "button";
			button.className = image.classList.contains("hero-image") ? "image-preview-trigger hero-image-preview-trigger" : "image-preview-trigger";
			button.setAttribute("aria-haspopup", "dialog");
			button.setAttribute("aria-expanded", "false");
			button.setAttribute("aria-label", label);
			parent.insertBefore(button, image);
			button.append(image);
			fitArticleImageTrigger(button);
			if (!image.complete) image.addEventListener("load", () => fitArticleImageTrigger(button), { once: true, signal });
		};
		const ensureImagePreviewTriggers = (root: ParentNode) => {
			if (root instanceof HTMLImageElement) {
				ensureImagePreviewTrigger(root);
				return;
			}

			for (const image of root.querySelectorAll<HTMLImageElement>("img")) {
				ensureImagePreviewTrigger(image);
			}
		};

		imagePreviewImage?.addEventListener("load", updatePreviewFit, { signal });
		imagePreviewImage?.addEventListener(
			"click",
			event => {
				event.preventDefault();
				event.stopPropagation();
				const nextZoom = previewZoom >= maxPreviewZoom ? 1 : previewZoom + previewZoomStep;
				setPreviewZoom(nextZoom, true, { clientX: event.clientX, clientY: event.clientY });
			},
			{ signal }
		);
		imagePreviewZoomOut?.addEventListener("click", () => setPreviewZoom(previewZoom - previewZoomStep), { signal });
		imagePreviewZoomIn?.addEventListener("click", () => setPreviewZoom(previewZoom + previewZoomStep), { signal });
		imagePreviewClose?.addEventListener("click", () => closeImagePreview(), { signal });
		window.addEventListener("resize", queuePreviewFit, { signal });
		window.addEventListener("resize", queueArticleImageFit, { signal });
		imagePreviewStage?.addEventListener(
			"wheel",
			event => {
				if (!event.ctrlKey) return;

				event.preventDefault();
				const nextZoom = previewZoom * Math.exp(-event.deltaY * 0.002);
				setPreviewZoom(nextZoom, true, { clientX: event.clientX, clientY: event.clientY });
			},
			{ signal, passive: false }
		);
		imagePreviewOverlay?.addEventListener(
			"click",
			event => {
				const target = event.target;
				if (target === imagePreviewOverlay || target === imagePreviewBackdrop || target === imagePreviewDialog || target === imagePreviewStage || target === imagePreviewCanvas) closeImagePreview();
			},
			{ signal }
		);
		document.addEventListener(
			"keydown",
			event => {
				if (!imagePreviewOverlay || imagePreviewOverlay.hidden) return;

				if (event.key === "Escape") {
					event.preventDefault();
					closeImagePreview();
					return;
				}

				if (event.key === "Tab") {
					const focusable = previewFocusableElements();
					const first = focusable[0];
					const last = focusable[focusable.length - 1];
					if (first && last) {
						const activeElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
						if (!activeElement || !focusable.includes(activeElement)) {
							event.preventDefault();
							(event.shiftKey ? last : first).focus();
						} else if (event.shiftKey && activeElement === first) {
							event.preventDefault();
							last.focus();
						} else if (!event.shiftKey && activeElement === last) {
							event.preventDefault();
							first.focus();
						}
					}
					return;
				}

				if ((event.key === "+" || event.key === "=") && !event.metaKey && !event.ctrlKey && !event.altKey) {
					event.preventDefault();
					setPreviewZoom(previewZoom + previewZoomStep);
					return;
				}

				if ((event.key === "-" || event.key === "_") && !event.metaKey && !event.ctrlKey && !event.altKey) {
					event.preventDefault();
					setPreviewZoom(previewZoom - previewZoomStep);
					return;
				}

				if (event.key === "0" && !event.metaKey && !event.ctrlKey && !event.altKey) {
					event.preventDefault();
					setPreviewZoom(1);
				}
			},
			{ signal }
		);

		if (articleContent) {
			articleContent.addEventListener(
				"click",
				event => {
					const trigger = event.target instanceof Element ? event.target.closest<HTMLElement>(".image-preview-trigger") : null;
					if (!trigger || !articleContent.contains(trigger)) return;

					const image = trigger.querySelector("img");
					if (!(image instanceof HTMLImageElement)) return;

					event.preventDefault();
					openImagePreview(image, trigger);
				},
				{ signal }
			);
			ensureFrameTitles(articleContent);
			ensureAnimatedImageControls(articleContent);
			ensureImagePreviewTriggers(articleContent);
			if (typeof window.MutationObserver === "function") {
				embedObserver = new MutationObserver(mutations => {
					for (const mutation of mutations) {
						for (const node of mutation.addedNodes) {
							if (node instanceof HTMLElement || node instanceof DocumentFragment) {
								ensureFrameTitles(node);
								ensureAnimatedImageControls(node);
								ensureImagePreviewTriggers(node);
							}
						}
					}
				});
				embedObserver.observe(articleContent, { childList: true, subtree: true });
			}
		}

		const progressArticle = document.querySelector<HTMLElement>("[data-progress-storage-key][data-progress-item-id]");
		const sentinel = progressArticle?.querySelector<HTMLElement>("[data-read-complete-sentinel]");
		const toast = document.querySelector<HTMLElement>("[data-reading-toast]");

		const parseProgress = (value: string | null) => {
			if (!value) return [];
			try {
				const parsed = JSON.parse(value);
				return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === "string") : [];
			} catch {
				return [];
			}
		};

		const showToast = () => {
			if (!toast) return;
			window.clearTimeout(toastHideTimer);
			window.clearTimeout(toastHiddenTimer);
			toast.hidden = false;
			toast.classList.add("visible");
			toastHideTimer = window.setTimeout(() => {
				toast.classList.remove("visible");
				toastHiddenTimer = window.setTimeout(() => {
					toast.hidden = true;
				}, 280);
			}, 2600);
		};

		const markReadComplete = () => {
			const storageKey = progressArticle?.dataset.progressStorageKey;
			const itemId = progressArticle?.dataset.progressItemId;
			if (!storageKey || !itemId) return;

			const completed = parseProgress(window.localStorage.getItem(storageKey));
			if (completed.includes(itemId)) return;

			const nextCompleted = [...completed, itemId];
			window.localStorage.setItem(storageKey, JSON.stringify(nextCompleted));
			window.dispatchEvent(new CustomEvent("emtech:course-progress", { detail: { storageKey, completed: nextCompleted } }));
			showToast();
		};

		if (progressArticle && sentinel) {
			const supportsIntersectionObserver = typeof window.IntersectionObserver === "function";

			if (supportsIntersectionObserver) {
				const observer = new IntersectionObserver(
					entries => {
						if (entries.some(entry => entry.isIntersecting)) {
							markReadComplete();
							observer.disconnect();
						}
					},
					{ rootMargin: "0px 0px -10% 0px" }
				);
				readObserver = observer;
				observer.observe(sentinel);
			} else {
				const scrollTarget: Window = window;
				scrollTarget.addEventListener(
					"scroll",
					() => {
						const bottom = progressArticle.getBoundingClientRect().bottom;
						if (bottom <= window.innerHeight + 24) markReadComplete();
					},
					{ passive: true, signal }
				);
			}
		}

		const getLineText = (line: HTMLElement) => {
			const hasElementChildren = Array.from(line.childNodes).some(node => node.nodeType === Node.ELEMENT_NODE);

			return Array.from(line.childNodes)
				.map(node => {
					const text = node.textContent ?? "";
					if (hasElementChildren && node.nodeType === Node.TEXT_NODE && !text.trim()) return "";
					return text;
				})
				.join("");
		};

		const getCodeText = (code: HTMLElement) => {
			const lines = Array.from(code.querySelectorAll<HTMLElement>(".line"));
			if (lines.length > 0) return lines.map(getLineText).join("\n");
			return code.textContent ?? "";
		};

		const writeClipboard = async (text: string) => {
			if (navigator.clipboard?.writeText && window.isSecureContext) {
				await navigator.clipboard.writeText(text);
				return;
			}

			const textarea = document.createElement("textarea");
			textarea.value = text;
			textarea.setAttribute("readonly", "");
			textarea.style.position = "fixed";
			textarea.style.inset = "0 auto auto 0";
			textarea.style.opacity = "0";
			document.body.append(textarea);
			textarea.select();

			const copied = (document as unknown as { execCommand: (command: string) => boolean }).execCommand("copy");
			textarea.remove();
			if (!copied) throw new Error("Copy command failed");
		};

		const languageLabels: Record<string, string> = {
			bash: "Bash",
			c: "C",
			"c++": "C++",
			cpp: "C++",
			cs: "C#",
			csharp: "C#",
			css: "CSS",
			dockerfile: "Dockerfile",
			html: "HTML",
			javascript: "JS",
			js: "JS",
			json: "JSON",
			jsx: "JSX",
			markdown: "MD",
			md: "MD",
			plaintext: "Text",
			powershell: "PowerShell",
			ps1: "PowerShell",
			py: "Python",
			python: "Python",
			sh: "Shell",
			shell: "Shell",
			ts: "TS",
			tsx: "TSX",
			typescript: "TS",
			xml: "XML",
			yaml: "YAML",
			yml: "YAML",
			zsh: "Zsh"
		};

		const normalizeLanguageLabel = (language: string | null | undefined) => {
			const normalized = language?.trim() ?? "";
			if (!normalized) return "Text";
			return languageLabels[normalized.toLowerCase()] ?? normalized;
		};

		const getCodeLanguage = (block: HTMLElement, code: HTMLElement) => {
			const pre = code.closest("pre");
			const dataLanguage = pre?.getAttribute("data-language") || code.getAttribute("data-language");
			const languageClass = [...code.classList, ...(pre ? [...pre.classList] : []), ...block.classList].find(className => className.startsWith("language-"));
			return normalizeLanguageLabel(dataLanguage || languageClass?.replace(/^language-/, ""));
		};

		const ensureCodeLanguageLabel = (block: HTMLElement, code: HTMLElement) => {
			const toolbar = block.querySelector<HTMLElement>(".code-block-toolbar");
			if (!toolbar) return;

			let label = toolbar.querySelector<HTMLElement>(".code-block-language");
			if (!label) {
				label = document.createElement("span");
				label.className = "code-block-language";
				toolbar.prepend(label);
			}

			if (!label.textContent?.trim()) label.textContent = getCodeLanguage(block, code);
		};

		for (const block of document.querySelectorAll<HTMLElement>("[data-code-block]")) {
			const code = block.querySelector<HTMLElement>("pre code");
			if (!code) continue;

			ensureCodeLanguageLabel(block, code);

			const button = block.querySelector<HTMLButtonElement>("[data-code-copy-button]");
			if (!button) continue;

			const defaultLabel = button.textContent ?? "複製";
			let resetTimer = 0;

			button.addEventListener(
				"click",
				async () => {
					window.clearTimeout(resetTimer);
					copyResetTimers.delete(resetTimer);
					button.disabled = true;

					try {
						await writeClipboard(getCodeText(code));
						button.dataset.copyState = "success";
						button.textContent = "已複製";
					} catch {
						button.dataset.copyState = "error";
						button.textContent = "複製失敗";
					} finally {
						button.disabled = false;
						resetTimer = window.setTimeout(() => {
							copyResetTimers.delete(resetTimer);
							delete button.dataset.copyState;
							button.textContent = defaultLabel;
						}, 1800);
						copyResetTimers.add(resetTimer);
					}
				},
				{ signal }
			);
		}

		return () => {
			controller.abort();
			if (tocFrame) window.cancelAnimationFrame(tocFrame);
			if (previewResizeFrame) window.cancelAnimationFrame(previewResizeFrame);
			if (articleImageResizeFrame) window.cancelAnimationFrame(articleImageResizeFrame);
			window.clearTimeout(previewReleaseTimer);
			window.clearTimeout(previewCloseTimer);
			finishCloseImagePreview(false);
			readObserver?.disconnect();
			embedObserver?.disconnect();
			window.clearTimeout(toastHideTimer);
			window.clearTimeout(toastHiddenTimer);
			for (const timer of copyResetTimers) window.clearTimeout(timer);
			copyResetTimers.clear();
		};
	});
</script>

