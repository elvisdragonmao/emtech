---
import type { ImageInput } from "@/utils/content";

export type ArticleCardData = {
	title: string;
	href: string;
	image: ImageInput;
	tag: string;
	description?: string;
	category?: string;
	date?: string;
	readTime?: string;
};

interface Props {
	article: ArticleCardData;
	compact?: boolean;
}

const { article } = Astro.props;
const imageSrc = typeof article.image === "string" ? article.image : article.image?.src;
const imageWidth = typeof article.image === "string" ? undefined : article.image?.width;
const imageHeight = typeof article.image === "string" ? undefined : article.image?.height;
---

<a class="article-card" href={article.href}>
	<figure>
		{imageSrc ? <img src={imageSrc} width={imageWidth} height={imageHeight} alt={article.title} loading="lazy" /> : <div class="placeholder" aria-hidden="true" />}
	</figure>
	<h3>{article.title}</h3>
	<p class="tag">{article.tag}</p>
</a>

<style>
	.article-card {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		padding: 1rem;
		gap: 1rem;
		color: var(--color-text);
		background: oklch(100% 0 0 / 92%);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 0 0 1px oklch(100% 0 0 / 60%);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			border-color 180ms ease;
	}

	.article-card:hover {
		transform: translateY(-0.25rem);
		border-color: var(--color-accent);
		box-shadow: var(--shadow-card);
	}

	figure {
		position: relative;
		aspect-ratio: 2 / 1;
		background: var(--color-surface-soft);
		overflow: hidden;
	}

	img,
	.placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 260ms ease;
	}

	.article-card:hover img {
		transform: scale(1.04);
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-muted);
	}

	h3 {
		font-size: 1.25rem;
		line-height: 1.2;
		letter-spacing: -0.045em;
		color: var(--color-ink);
		flex-grow: 1;
	}
</style>
