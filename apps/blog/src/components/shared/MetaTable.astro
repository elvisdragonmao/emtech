---
import type { MetaItem } from "@/utils/content";

interface Props {
	items: MetaItem[];
}

const { items } = Astro.props;
const labelText: Record<string, string> = {
	Date: "日期",
	Category: "分類",
	"Read Time": "閱讀時間",
	Word: "字數",
	"Last Mod": "最後更新"
};
---

<dl class="meta-table">
	{
		items.map(item => (
			<div>
				<dt>{labelText[item.label] ?? item.label}</dt>
				<dd>
					{item.links && item.links.length > 0 ? (
						item.links.map((link, index) => (
							<>
								<a href={link.href}>{link.label}</a>
								{index < item.links!.length - 1 && <span aria-hidden="true"> / </span>}
							</>
						))
					) : item.href ? (
						<a href={item.href}>{item.value}</a>
					) : (
						item.value
					)}
				</dd>
			</div>
		))
	}
</dl>

<style>
	.meta-table {
		display: grid;
		grid-template-columns: repeat(var(--meta-columns, 5), minmax(0, 1fr));
		border: 1px solid var(--color-border);
		background: var(--color-surface-glass-soft);
	}

	.meta-table div {
		min-width: 0;
		min-height: 4.75rem;
		padding: 0.75rem 1rem;
		border-left: 1px solid var(--color-border);
	}

	.meta-table div:first-child {
		border-left: 0;
	}

	dt {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-muted);
	}

	dd {
		margin-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-text);
		overflow-wrap: anywhere;
	}

	dd a {
		color: var(--color-accent-strong);
		text-decoration: none;
		text-underline-offset: 0.18em;
	}

	dd a:hover {
		text-decoration: underline;
	}

	@media (max-width: 48.75rem) {
		.meta-table {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.meta-table div:nth-child(odd) {
			border-left: 0;
		}

		.meta-table div {
			border-top: 1px solid var(--color-border);
		}

		.meta-table div:nth-child(3),
		.meta-table div:nth-child(4) {
			border-bottom: 1px solid var(--color-border);
		}

		.meta-table div:nth-child(5) {
			border-top: 0;
		}

		.meta-table div:nth-child(-n + 2) {
			border-top: 0;
		}
	}
</style>
