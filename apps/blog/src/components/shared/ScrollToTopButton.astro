---
import { ArrowUp } from "@lucide/astro";
---

<button class="scroll-to-top" type="button" aria-label="回到頁面頂端" tabindex="-1" aria-hidden="true" data-scroll-to-top>
	<ArrowUp size={18} stroke-width={1.9} aria-hidden="true" />
</button>

<script>
	import { setupPageLifecycle } from "@/scripts/pageLifecycle";

	setupPageLifecycle("scroll-to-top", () => {
		const button = document.querySelector<HTMLButtonElement>("[data-scroll-to-top]");
		if (!button) return;

		const controller = new AbortController();
		const { signal } = controller;
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let frame = 0;

		const updateVisibility = () => {
			frame = 0;
			const isVisible = window.scrollY > 360;

			button.toggleAttribute("data-visible", isVisible);
			button.tabIndex = isVisible ? 0 : -1;
			button.setAttribute("aria-hidden", String(!isVisible));
		};

		const handleScroll = () => {
			if (!frame) {
				frame = window.requestAnimationFrame(updateVisibility);
			}
		};

		button.addEventListener(
			"click",
			() => {
				window.scrollTo({
					top: 0,
					behavior: prefersReducedMotion.matches ? "auto" : "smooth"
				});
			},
			{ signal }
		);

		window.addEventListener("scroll", handleScroll, { passive: true, signal });
		updateVisibility();

		return () => {
			if (frame) window.cancelAnimationFrame(frame);
			controller.abort();
		};
	});
</script>

<style>
	.scroll-to-top {
		position: fixed;
		right: max(2rem, calc(var(--page-padding, 1rem) + 1rem));
		bottom: 8rem;
		z-index: 30;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1;
		color: var(--color-muted);
		background: repeating-linear-gradient(135deg, transparent 0 0.45rem, var(--color-hatch-glass) 0.45rem 0.65rem), var(--color-surface-glass-strong);
		border: 1px solid var(--color-border-strong);
		box-shadow:
			inset 0 0 0 1px var(--color-inset-highlight),
			var(--shadow-card);
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.75rem);
		backdrop-filter: blur(0.75rem);
		transition:
			color 160ms ease,
			background 160ms ease,
			border-color 160ms ease,
			opacity 160ms ease,
			transform 160ms ease;
	}

	.scroll-to-top[data-visible] {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.scroll-to-top:hover,
	.scroll-to-top:focus-visible {
		color: var(--color-ink);
		background: var(--color-accent-soft);
		border-color: var(--color-accent);
	}

	.scroll-to-top:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	@media (max-width: 40rem) {
		.scroll-to-top {
			right: 1rem;
			bottom: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-to-top {
			transition: none;
		}
	}
</style>
