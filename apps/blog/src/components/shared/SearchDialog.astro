---
const pagefindPath = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
---

<div class="search-overlay" data-search-overlay data-pagefind-path={pagefindPath} hidden>
	<section class="search-dialog" id="site-search" role="dialog" aria-modal="true" aria-labelledby="site-search-title">
		<div class="search-head">
			<p id="site-search-title">搜尋</p>
			<button type="button" data-search-close aria-label="關閉搜尋">Esc</button>
		</div>
		<label class="search-field">
			<span class="sr-only">搜尋文章與課程內文</span>
			<input data-search-input name="q" type="search" autocomplete="off" placeholder="搜尋標題、標籤或內文…" />
		</label>
		<div class="search-meta" data-search-meta role="status" aria-live="polite">輸入關鍵字開始搜尋</div>
		<ol class="search-results" data-search-results></ol>
	</section>
</div>

<script>
	import { setupPageLifecycle } from "@/scripts/pageLifecycle";

	type PagefindModule = {
		init?: () => Promise<void> | void;
		debouncedSearch: (
			query: string,
			options: Record<string, unknown>,
			delay: number
		) => Promise<{
			results: Array<{
				data: () => Promise<{
					url?: string;
					title?: string;
					excerpt?: string;
					plain_excerpt?: string;
					meta?: {
						type?: string;
						date?: string;
						title?: string;
					};
				}>;
			}>;
		} | null>;
	};

	setupPageLifecycle("search-dialog", () => {
		const overlay = document.querySelector("[data-search-overlay]");
		const input = document.querySelector("[data-search-input]");
		const results = document.querySelector("[data-search-results]");
		const meta = document.querySelector("[data-search-meta]");
		const openButtons = document.querySelectorAll("[data-search-open]");
		const closeButtons = document.querySelectorAll("[data-search-close]");

		if (!(overlay instanceof HTMLElement) || !(input instanceof HTMLInputElement) || !(results instanceof HTMLOListElement) || !(meta instanceof HTMLElement)) return;

		const controller = new AbortController();
		const { signal } = controller;
		let pagefindPromise: Promise<PagefindModule> | null = null;
		let activeSearch = 0;
		let restoreFocusTo: HTMLElement | null = null;
		let disposed = false;

		const pagefindPath = overlay.dataset.pagefindPath || "/pagefind/pagefind.js";
		const focusableSelector = "a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex='-1'])";

		const loadPagefind = () => {
			pagefindPromise ??= import(/* @vite-ignore */ pagefindPath).then(async pagefind => {
				await pagefind.init?.();
				return pagefind as PagefindModule;
			});

			return pagefindPromise;
		};

		const isEditable = (target: EventTarget | null) => {
			if (!(target instanceof HTMLElement)) return false;
			return Boolean(target.closest("input, textarea, select, [contenteditable='true']"));
		};

		const clearResults = () => {
			results.textContent = "";
		};

		const renderResults = async () => {
			const searchId = ++activeSearch;
			const query = input.value.trim();
			clearResults();

			if (disposed) return;

			if (!query) {
				meta.textContent = "輸入關鍵字開始搜尋";
				return;
			}

			meta.textContent = "搜尋中…";

			try {
				const pagefind = await loadPagefind();
				const search = await pagefind.debouncedSearch(query, {}, 180);
				if (disposed || searchId !== activeSearch || search === null) return;

				const loaded = await Promise.all(search.results.slice(0, 20).map(result => result.data()));
				if (disposed || searchId !== activeSearch) return;

				meta.textContent = search.results.length > 0 ? `找到 ${search.results.length} 筆結果` : "沒有找到符合的內容";

				for (const item of loaded) {
					const li = document.createElement("li");
					const link = document.createElement("a");
					const top = document.createElement("span");
					const title = document.createElement("strong");
					const excerpt = document.createElement("span");
					const type = item.meta?.type || (item.url?.startsWith("/course/") ? "課程" : "文章");
					const date = item.meta?.date ? ` / ${item.meta.date}` : "";

					link.href = item.url ?? "#";
					top.className = "result-kicker";
					title.className = "result-title";
					excerpt.className = "result-snippet";

					top.textContent = `${type}${date}`;
					title.textContent = item.meta?.title || item.title || item.url || "";
					excerpt.innerHTML = item.excerpt || item.plain_excerpt || "";

					link.append(top, title, excerpt);
					li.append(link);
					results.append(li);
				}
			} catch {
				if (disposed || searchId !== activeSearch) return;
				meta.textContent = "搜尋索引尚未載入，請先執行 build 產生 Pagefind index";
			}
		};

		const openSearch = () => {
			restoreFocusTo = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			overlay.hidden = false;
			openButtons.forEach(button => button.setAttribute("aria-expanded", "true"));
			document.documentElement.classList.add("search-open");
			requestAnimationFrame(() => input.focus());
			loadPagefind().catch(() => undefined);
			renderResults();
		};

		const closeSearch = () => {
			overlay.hidden = true;
			openButtons.forEach(button => button.setAttribute("aria-expanded", "false"));
			document.documentElement.classList.remove("search-open");
			restoreFocusTo?.focus();
			restoreFocusTo = null;
		};

		openButtons.forEach(button => button.addEventListener("click", openSearch, { signal }));
		closeButtons.forEach(button => button.addEventListener("click", closeSearch, { signal }));
		input.addEventListener("input", renderResults, { signal });

		const initialQuery = new URLSearchParams(window.location.search).get("q");
		if (initialQuery) {
			input.value = initialQuery;
			openSearch();
		}

		overlay.addEventListener(
			"click",
			event => {
				if (event.target === overlay) closeSearch();
			},
			{ signal }
		);

		document.addEventListener(
			"keydown",
			event => {
				if (event.key === "Escape" && !overlay.hidden) {
					event.preventDefault();
					closeSearch();
					return;
				}

				if (event.key === "Tab" && !overlay.hidden) {
					const focusable = Array.from(overlay.querySelectorAll(focusableSelector)).filter(element => element instanceof HTMLElement && element.offsetParent !== null);
					const first = focusable[0];
					const last = focusable[focusable.length - 1];
					if (first instanceof HTMLElement && last instanceof HTMLElement) {
						if (event.shiftKey && document.activeElement === first) {
							event.preventDefault();
							last.focus();
						} else if (!event.shiftKey && document.activeElement === last) {
							event.preventDefault();
							first.focus();
						}
					}
					return;
				}

				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k" && !isEditable(event.target)) {
					event.preventDefault();
					openSearch();
				}
			},
			{ signal }
		);

		return () => {
			disposed = true;
			activeSearch += 1;
			controller.abort();
			document.documentElement.classList.remove("search-open");
		};
	});
</script>

<style>
	.search-overlay {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		place-items: start center;
		padding: 12vh 1rem 1rem;
		background: oklch(17% 0.022 255 / 32%);
		backdrop-filter: blur(0.45rem);
		overscroll-behavior: contain;
	}

	.search-overlay[hidden] {
		display: none;
	}

	.search-dialog {
		width: min(42rem, 100%);
		max-height: min(42rem, 76vh);
		overflow: hidden;
		background: var(--color-surface-glass-strong);
		border: 1px solid var(--color-border-strong);
		box-shadow: var(--shadow-soft);
		overscroll-behavior: contain;
	}

	.search-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.search-head p {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.search-head button {
		padding: 0.3rem 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-text);
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
	}

	.search-field {
		display: block;
		padding: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.search-field:focus-within {
		outline: 2px solid var(--color-focus-ring);
		outline-offset: -2px;
		background: var(--color-surface);
	}

	.search-field input {
		width: 100%;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0;
		color: var(--color-ink);
		background: transparent;
		border: 0;
	}

	.search-field input:focus-visible {
		outline: none;
	}

	.search-field input::placeholder {
		color: var(--color-placeholder);
	}

	.search-meta {
		padding: 0.7rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-text);
		background: var(--color-surface-soft);
		border-bottom: 1px solid var(--color-border);
	}

	.search-results {
		max-height: 25rem;
		overflow: auto;
		list-style: none;
	}

	:global(.search-results li + li) {
		border-top: 1px solid var(--color-border);
	}

	:global(.search-results a) {
		display: grid;
		gap: 0.45rem;
		padding: 1rem;
		transition:
			background 140ms ease,
			color 140ms ease;
	}

	:global(.search-results a:hover),
	:global(.search-results a:focus-visible) {
		color: var(--color-ink);
		background: var(--color-accent-soft);
		outline: 2px solid var(--color-focus-ring);
		outline-offset: -2px;
	}

	:global(.result-kicker) {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	:global(.result-title) {
		font-size: 1.15rem;
		line-height: 1.3;
		letter-spacing: -0.04em;
		color: var(--color-ink);
	}

	:global(.result-snippet) {
		display: block;
		font-size: 0.92rem;
		line-height: 1.65;
		color: var(--color-text);
	}

	:global(.result-snippet mark) {
		color: var(--color-ink);
		background: oklch(88% 0.16 96 / 55%);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	:global(html.search-open) {
		overflow: hidden;
	}

	@media (max-width: 40rem) {
		.search-overlay {
			place-items: start center;
			padding-top: 5.5rem;
		}

		.search-dialog {
			max-height: calc(100vh - 6.5rem);
		}
	}
</style>
