---
import { Globe, SquareArrowOutUpRight } from "@lucide/astro";
import { siGithub, siInstagram } from "simple-icons";
import SimpleIcon from "./SimpleIcon.astro";

interface Props {
	copyright?: boolean;
}

const { copyright = false } = Astro.props;
---

<section class="about-card">
	<div>
		<p class="eyebrow">關於我</p>
		<h2>毛哥EM</h2>
		<p class="bio">
			這裡是毛哥EM，一隻全端開發龍還有英文辯士。<br />
			熱愛開源、音樂、設計、獸迷文化，專研人機互動與人工智慧。
		</p>
		{
			copyright && (
				<p class="bio">
					本部落格皆屬原創文章，採{" "}
					<a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noreferrer">
						CC BY-SA 4.0
						<SquareArrowOutUpRight class="external-link-icon" size={14} stroke-width={1.9} aria-hidden="true" />
						<span class="sr-only">新分頁開啟</span>
					</a>{" "}
					授權，
					<br />
					轉載請註明來自毛哥EM資訊密技。
					<br />
					這篇文章對你有幫助嗎？
					<a href="https://www.buymeacoffee.com/elvismao" target="_blank" rel="noreferrer">
						考慮幫我買瓶 Red Bull？
						<SquareArrowOutUpRight class="external-link-icon" size={14} stroke-width={1.9} aria-hidden="true" />
						<span class="sr-only">新分頁開啟</span>
					</a>
				</p>
			)
		}
		<nav class="links" aria-label="社群連結">
			<a href="https://elvismao.com" target="_blank" rel="noreferrer" aria-label="個人網站，新分頁開啟"><Globe size={22} stroke-width={1.7} aria-hidden="true" /></a>
			<a href="https://github.com/elvisdragonmao" target="_blank" rel="noreferrer" aria-label="GitHub，新分頁開啟"><SimpleIcon icon={siGithub} size={22} /></a>
			<a href="https://instagram.com/elvisdragonmao" target="_blank" rel="noreferrer" aria-label="Instagram，新分頁開啟"><SimpleIcon icon={siInstagram} size={22} /></a>
		</nav>
	</div>
	<div class="dragon-container">
		<img class="dragon" src="/img/avatar_faier.webp" alt="毛哥EM 角色插圖" loading="lazy" />
	</div>
</section>

<style>
	.about-card {
		position: relative;
		display: flex;
		width: min(57.5rem, 100%);
		padding: 3rem;
		overflow: hidden;
		background: var(--color-surface-glass);
		border: 1px solid var(--color-accent);
		box-shadow: var(--shadow-card);
	}

	.about-card::before {
		position: absolute;
		inset: 1.25rem;
		content: "";
		border: 1px solid oklch(89% 0.018 255 / 70%);
		pointer-events: none;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h2 {
		margin-top: 1rem;
		font-size: 3.5rem;
		line-height: 0.9;
		letter-spacing: -0.05em;
		color: var(--color-ink);
	}

	.bio {
		max-width: 28.75rem;
		margin-top: 1.5rem;
		font-size: 1rem;
		line-height: 1.33;
		color: var(--color-muted);
	}

	.bio a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.2rem;
		color: var(--color-accent-strong);
	}

	.external-link-icon {
		display: inline-block;
		flex: 0 0 auto;
		width: 0.875em;
		height: 0.875em;
		vertical-align: -0.1em;
	}

	.links {
		display: flex;
		gap: 1.25rem;
		margin-top: 1.75rem;
	}

	.links a {
		color: var(--color-muted);
		transition: color 160ms ease;
	}

	.links a:hover {
		color: var(--color-accent-strong);
	}
	.dragon-container {
		position: relative;
		flex-grow: 1;
		min-width: 10rem;
	}

	.dragon {
		position: absolute;
		left: 25%;
		top: -1rem;
		width: min(20vw, 14rem);
		filter: drop-shadow(0 1.5rem 1.5rem oklch(71% 0.15 225 / 18%));
	}

	@media (screen and max-width: 55rem) {
		.dragon {
			position: absolute;
			right: 0%;
			left: unset;
			top: unset;
			bottom: -20%;
			margin-top: -1rem;
		}
	}

	@media (max-width: 45rem) {
		.about-card {
			flex-direction: column;
		}

		.dragon-container {
			height: 10rem;
		}

		.dragon {
			top: 0;
			bottom: unset;
			width: 10rem;
		}

		/* .dragon {
			width: 33.333%;
		} */
	}

	@media print {
		.about-card {
			flex-direction: row;
			width: 100%;
			padding: 8mm;
			overflow: hidden;
			background: #fff;
			border: 1px solid #4a90ad;
			box-shadow: none;
			break-inside: avoid;
		}

		.about-card::before {
			inset: 3mm;
			border-color: #d5d5d5;
		}

		.eyebrow {
			font-size: 7.5pt;
			color: #555;
		}

		h2 {
			margin-top: 2.5mm;
			font-size: 20pt;
			color: #111;
		}

		.bio {
			max-width: 125mm;
			margin-top: 3mm;
			font-size: 9pt;
			line-height: 1.45;
			color: #444;
		}

		.bio a {
			color: #075d80;
			text-decoration: underline;
		}

		.links {
			gap: 4mm;
			margin-top: 4mm;
		}

		.links a {
			color: #444;
		}
	}
</style>
