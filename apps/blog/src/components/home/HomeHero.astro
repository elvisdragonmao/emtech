---
import { getCollection } from "astro:content";
import { Pause, Play } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { extractTitle, formatDate, resolvePostThumbnail } from "@/utils/content";

const allPosts = (await getCollection("post")).filter(post => !post.data.draft);
const courses = await getCollection("course");

const LAUNCH_DATE = "2021-06-05";

const stats = [
	{ label: "Post", value: String(allPosts.length) },
	{ label: "Course", value: String(courses.length) },
	{ label: "Lived for", value: "--", livedFor: true }
];

// 2 most recent posts
const recentPosts = [...allPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);

const allThumbs = import.meta.glob<{ default: ImageMetadata }>("/src/content/post/**/thumbnail.{avif,gif,jpeg,jpg,png,webp}", { eager: true });

const articleTags = ["最新文章", "次新文章"];

const featuredArticles = recentPosts.map((p, index) => {
	const image = resolvePostThumbnail(p, allThumbs);
	return {
		tag: articleTags[index] ?? "最新文章",
		title: extractTitle(p.body) || p.id,
		description: p.data.description ?? "",
		href: `/p/${p.id}/`,
		image,
		imageSrc: typeof image === "string" ? image : image?.src,
		imageWidth: typeof image === "string" ? undefined : image?.width,
		imageHeight: typeof image === "string" ? undefined : image?.height,
		date: formatDate(p.data.date)
	};
});
---

<section class="hero">
	<div class="hero-copy">
		<div class="hero-heading">
			<p class="eyebrow">EMTECH.CC / ELVIS DRAGON MAO</p>
			<h1>毛哥EM<br />資訊密技</h1>
			<p class="hero-subtitle">科技、設計、毛茸茸</p>
		</div>
		<dl class="card stats-panel" aria-label="網站統計">
			{
				stats.map(stat => (
					<div>
						<dt>{stat.label}</dt>
						{stat.livedFor ? (
							<dd data-lived-for data-launch-date={LAUNCH_DATE} aria-live="polite">
								{stat.value}
							</dd>
						) : (
							<dd>{stat.value}</dd>
						)}
					</div>
				))
			}
		</dl>
	</div>

	<div class="hero-gallery" role="group" aria-label="精選內容">
		<picture>
			<source media="(prefers-reduced-motion: reduce)" srcset="/img/dragon-still.webp" />
			<img class="dragon" src="/img/dragon.webp" alt="毛哥EM 角色插圖" data-dragon-image data-animated-src="/img/dragon.webp" data-still-src="/img/dragon-still.webp" />
		</picture>
		<button class="motion-toggle" type="button" aria-label="暫停角色插圖動畫" aria-pressed="false" data-dragon-toggle data-motion-state="playing">
			<Pause class="pause-icon" size={16} stroke-width={2} aria-hidden="true" />
			<Play class="play-icon" size={16} stroke-width={2} aria-hidden="true" />
			<span class="sr-only" data-motion-label>暫停角色插圖動畫</span>
		</button>
		<div class="circle circle-one"></div>
		<div class="circle circle-two"></div>
		{
			featuredArticles.map(article => (
				<a class="feature-note" href={article.href}>
					{article.imageSrc ? <img src={article.imageSrc} width={article.imageWidth} height={article.imageHeight} alt="" /> : <div class="thumb-placeholder" aria-hidden="true" />}
					<div>
						<span>{article.tag}</span>
						<strong>{article.title}</strong>
						<small>{article.description}</small>
					</div>
				</a>
			))
		}
	</div>
</section>

<script>
	import { setupPageLifecycle } from "@/scripts/pageLifecycle";

	setupPageLifecycle("home-hero", () => {
		const livedFor = document.querySelector("[data-lived-for]");
		const launchDate = livedFor?.getAttribute("data-launch-date");
		const dragon = document.querySelector<HTMLImageElement>("[data-dragon-image]");
		const dragonToggle = document.querySelector<HTMLButtonElement>("[data-dragon-toggle]");
		const dragonToggleLabel = document.querySelector<HTMLElement>("[data-motion-label]");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const controller = new AbortController();
		const { signal } = controller;

		if (livedFor instanceof HTMLElement && launchDate) {
			const launch = new Date(`${launchDate}T00:00:00`);
			const totalDays = Math.max(0, Math.floor((Date.now() - launch.getTime()) / (1000 * 60 * 60 * 24)));
			const years = Math.floor(totalDays / 365.25);
			const remainingDays = Math.round(totalDays - years * 365.25);

			livedFor.textContent = `${years}y ${remainingDays}d`;
		}

		if (dragon && dragonToggle) {
			const animatedSrc = dragon.dataset.animatedSrc ?? "/img/dragon.webp";
			const stillSrc = dragon.dataset.stillSrc ?? "/img/dragon-still.webp";

			const setDragonPaused = (isPaused: boolean) => {
				dragon.src = isPaused ? stillSrc : animatedSrc;
				dragonToggle.dataset.motionState = isPaused ? "paused" : "playing";
				dragonToggle.setAttribute("aria-pressed", String(isPaused));
				const label = isPaused ? "播放角色插圖動畫" : "暫停角色插圖動畫";
				dragonToggle.setAttribute("aria-label", label);
				if (dragonToggleLabel) dragonToggleLabel.textContent = label;
			};

			dragonToggle.addEventListener(
				"click",
				() => {
					setDragonPaused(dragonToggle.dataset.motionState !== "paused");
				},
				{ signal }
			);

			reducedMotion.addEventListener(
				"change",
				event => {
					if (event.matches) setDragonPaused(true);
				},
				{ signal }
			);

			setDragonPaused(reducedMotion.matches);
		}

		return () => controller.abort();
	});
</script>

<style>
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(22.5rem, 1.08fr);
		gap: 4rem;
		align-items: flex-end;
		min-height: min(calc(100svh - 4.25rem), 70rem);
		padding: 2rem 0 10rem;
		margin-bottom: -6rem;
	}

	.hero::before {
		position: absolute;
		top: 9.5rem;
		left: 0;
		width: min(32.5rem, 46vw);
		content: "";
		border-top: 1px solid var(--color-accent);
		transform: rotate(-8deg);
		transform-origin: left center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 6rem;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h1 {
		margin-top: 1.5rem;
		font-size: 8rem;
		line-height: 1;
		letter-spacing: -0.05em;
		color: var(--color-ink);
	}

	.hero-subtitle {
		margin-top: 1.5rem;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--color-text);
	}

	.stats-panel {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		max-width: 35rem;
		margin: 0;
	}

	.stats-panel div {
		padding: 1.25rem;
		border-left: 1px solid var(--color-border);
	}

	.stats-panel div:first-child {
		border-left: 0;
	}

	.stats-panel dt {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.stats-panel dd {
		display: block;
		margin: 0.5rem 0 0;
		font-size: 1.75rem;
		line-height: 1.75rem;
		letter-spacing: -0.04em;
		color: var(--color-ink);
	}

	.hero-gallery {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		padding-right: 2rem;
	}

	.dragon {
		z-index: 2;
		width: 40rem;
		height: auto;
		/* filter: drop-shadow(0 2rem 2.25rem oklch(71% 0.15 225 / 20%)); */
		transform: translateX(9rem) rotate(-4deg);
	}

	.motion-toggle {
		position: absolute;
		right: 0.75rem;
		bottom: 8.25rem;
		z-index: 4;
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		color: var(--color-ink);
		background: var(--color-surface-glass-strong);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-card);
		backdrop-filter: blur(0.75rem);
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.motion-toggle:hover,
	.motion-toggle:focus-visible {
		border-color: var(--color-accent);
		transform: translateY(-0.125rem);
	}

	.motion-toggle svg {
		grid-area: 1 / 1;
	}

	.motion-toggle .play-icon,
	.motion-toggle[data-motion-state="paused"] .pause-icon {
		display: none;
	}

	.motion-toggle[data-motion-state="paused"] .play-icon {
		display: block;
	}

	.circle {
		position: absolute;
		border: 1px solid oklch(71% 0.15 225 / 48%);
		border-radius: 62.5rem;
	}

	.circle-one {
		right: 2.5rem;
		bottom: 4.5rem;
		width: 14.75rem;
		height: 14.75rem;
	}

	.circle-two {
		bottom: 9.25rem;
		left: 2rem;
		width: 13.75rem;
		height: 13.75rem;
	}

	.feature-note {
		z-index: 3;
		display: grid;
		grid-template-columns: 10.75rem 1fr;
		gap: 1.25rem;
		width: min(30rem, 100%);
		padding: 1rem;
		background: var(--color-surface-glass-strong);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-card);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.feature-note:hover {
		transform: translateX(0.25rem);
		border-color: var(--color-accent);
	}

	.feature-note img,
	.thumb-placeholder {
		width: 100%;
		aspect-ratio: 2 / 1;
		height: auto;
		object-fit: cover;
	}

	.thumb-placeholder {
		background: var(--color-surface-soft);
	}

	.feature-note span,
	.feature-note small {
		display: block;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.feature-note span {
		font-family: var(--font-mono);
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	.feature-note small {
		display: block;
	}

	.feature-note strong {
		display: block;
		margin: 0.5rem 0;
		font-size: 1rem;
		line-height: 1.25;
		letter-spacing: -0.04em;
		color: var(--color-ink);
	}

	@media (max-width: 72rem) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			align-items: start;
			min-height: auto;
			padding-bottom: 6rem;
			margin-bottom: -3rem;
		}

		.hero-copy {
			gap: 2rem;
		}

		h1 {
			font-size: clamp(4.5rem, 17vw, 8rem);
		}

		.hero-gallery {
			align-items: stretch;
			padding-right: 0;
		}

		.dragon {
			width: min(35rem, 86vw);
			transform: translateX(1rem) rotate(-4deg);
		}

		.motion-toggle {
			right: 1rem;
			bottom: 7rem;
		}

		.circle-one {
			right: 1rem;
		}

		.circle-two {
			left: 0;
		}
	}

	@media (max-width: 40rem) {
		.hero {
			padding-top: 1.5rem;
			padding-bottom: 4rem;
		}

		.hero::before,
		.circle {
			display: none;
		}

		h1 {
			margin-top: 1rem;
			font-size: max(3rem, 20vw);
		}

		.hero-subtitle {
			font-size: 1.25rem;
		}

		.stats-panel div:last-child dd {
			font-size: max(1.25rem, 5vw);
		}

		/* .stats-panel {
			grid-template-columns: 1fr;
			width: fit-content;
		}

		.stats-panel div {
			padding-inline: 2rem;
		}

		.stats-panel div,
		.stats-panel div:first-child {
			border-top: 1px solid var(--color-border);
			border-left: 0;
		}

		.stats-panel div:first-child {
			border-top: 0;
		} */

		.dragon {
			width: min(45rem, 100%);
		}

		.motion-toggle {
			right: 0.75rem;
			bottom: 6.5rem;
		}

		.feature-note {
			grid-template-columns: minmax(5.5rem, 34%) 1fr;
			gap: 0.85rem;
			padding: 0.75rem;
		}
	}
</style>
