---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import CourseCard from "@/components/shared/CourseCard.astro";
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { formatDate, resolveCourseThumbnail } from "@/utils/content";
import type { CourseCardData } from "@/components/shared/CourseCard.astro";

const courses = (await getCollection("course")).sort((a, b) => a.data.displayOrder - b.data.displayOrder || a.data.title.localeCompare(b.data.title));
const allLessons = (await getCollection("lesson")).filter(lesson => !lesson.data.draft);
const allThumbs = import.meta.glob<{ default: ImageMetadata }>("/src/content/course/**/thumbnail.{avif,gif,jpeg,jpg,png,svg,webp}", { eager: true });

const courseCards: CourseCardData[] = courses.map(c => {
	const img = resolveCourseThumbnail(c, allThumbs);
	const courseLessons = allLessons.filter(l => l.id.startsWith(`${c.id}/`));
	const latestDate = courseLessons.reduce((acc, l) => (l.data.date > acc ? l.data.date : acc), new Date(0));
	return {
		title: c.data.title,
		description: c.data.description,
		meta: c.data.meta ?? `${courseLessons.length} 單元 / 課程`,
		lastUpdated: formatDate(latestDate),
		href: `/course/${c.id}/`,
		image: img,
		accent: c.data.accent
	};
});

const topCourses = courseCards.slice(0, 3);
const featuredCourses = courseCards.slice(3);
const featuredCourseRows = Array.from({ length: Math.ceil(featuredCourses.length / 2) }, (_, index) => featuredCourses.slice(index * 2, index * 2 + 2));
---

<section id="courses" class="section-block courses-preview">
	<SectionTitle eyebrow="課程" title="一篇像廢文<br>一系列看起來就挺有道理。" description="鐵人賽系列文章<br>和詳細的程式開發與設計教學" />
	<div class="course-grid-top">
		{topCourses.map(course => <CourseCard course={course} />)}
	</div>
	{
		featuredCourses.length > 0 && (
			<div class="course-grid-featured">
				{featuredCourseRows.map(row => (
					<div class:list={["course-grid-featured-row", { single: row.length === 1 }]}>
						{row.map(course => (
							<CourseCard course={course} featured={true} />
						))}
					</div>
				))}
			</div>
		)
	}
</section>

<style>
	.section-block {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	/* Row 1: 3 cards, no gap, leftmost 1.3x wider, borders collapse */
	.course-grid-top {
		display: grid;
		grid-template-columns: 1.3fr 1fr 1fr;
		gap: 0;
	}

	/* first card larger h3 */
	.course-grid-top :global(.course-card:first-child h3) {
		font-size: 3rem;
	}

	.course-grid-top :global(.course-card:not(:hover)) {
		border-right: none;
	}

	.course-grid-top :global(.course-card:last-child:not(:hover)) {
		border-right: 1px solid var(--color-border);
	}

	.course-grid-featured {
		display: flex;
		flex-direction: column;
	}

	.course-grid-featured-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
	}

	.course-grid-featured-row.single {
		grid-template-columns: 1fr;
	}

	.course-grid-featured-row :global(.course-card:not(:hover):not(:last-child)) {
		border-right: none;
	}

	.course-grid-featured-row + .course-grid-featured-row :global(.course-card:not(:hover)) {
		border-top: none;
	}

	@media (max-width: 57.5rem) {
		.course-grid-top {
			grid-template-columns: 1fr;
		}

		.course-grid-top :global(.course-card:not(:hover)) {
			border-right: 1px solid var(--color-border);
			border-bottom: none;
		}

		.course-grid-top :global(.course-card:last-child:not(:hover)) {
			border-bottom: 1px solid var(--color-border);
		}

		.course-grid-featured-row {
			grid-template-columns: 1fr;
		}

		.course-grid-featured-row :global(.course-card:not(:hover):not(:last-child)) {
			border-right: 1px solid var(--color-border);
			border-bottom: none;
		}
	}

	@media (max-width: 40rem) {
		.course-grid-top :global(.course-card:first-child h3) {
			font-size: 2.25rem;
		}
	}
</style>
