---
import { ArrowRight } from "@lucide/astro";
import SectionTitle from "@/components/shared/SectionTitle.astro";

const specialPages = [
	{ title: "交個朋友", description: "訂閱我的電子報", href: "https://elvismao.com/zh-Hant/hmmm/" },
	{ title: "友情連結", description: "我的好捧油們！", href: "/friends/" },
	{ title: "關於本站", description: "這裡的故事", href: "/p/about/" },
	{ title: "網站導覽", description: "站內內容清單", href: "/sitemap/" },
	{ title: "RSS", description: "不被演算法操控！", href: "/rss.xml" }
];
---

<section class="section-block special-pages">
	<SectionTitle eyebrow="Special Pages" title="疑，這是什麼？" />
	<div class="special-grid">
		{
			specialPages.map(page => (
				<a class="card" href={page.href}>
					<h3>{page.title}</h3>
					<p>{page.description}</p>
					<ArrowRight size={17} stroke-width={1.8} aria-hidden="true" />
				</a>
			))
		}
	</div>
</section>

<style>
	.section-block {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.special-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		border: 1px solid var(--color-border);
	}

	.special-grid a {
		position: relative;
		min-height: 8.5rem;
		padding: 1.75rem;
		border-left: 1px solid var(--color-border);
		transition: background 180ms ease;
	}

	.special-grid a::before {
		content: "";
		position: absolute;
		inset: 0;
		top: auto;
		height: 2px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 220ms ease;
	}

	.special-grid a:first-child {
		border-left: none;
	}

	.special-grid a:hover {
		background: var(--color-surface-soft);
	}

	.special-grid a:hover::before {
		transform: scaleX(1);
	}

	.special-grid a:hover h3 {
		color: var(--color-accent);
	}

	.special-grid a:hover svg {
		transform: translate(0.2rem, -0.2rem);
	}

	.special-grid h3 {
		font-size: 1.75rem;
		line-height: 1;
		letter-spacing: -0.055em;
		color: var(--color-ink);
		transition: color 180ms ease;
	}

	.special-grid p {
		margin-top: 0.75rem;
		font-size: 1rem;
		color: var(--color-muted);
	}

	.special-grid svg {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		color: var(--color-accent-strong);
		transition: transform 180ms ease;
	}

	@media (max-width: 72rem) {
		.special-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.special-grid a:nth-child(3n + 1) {
			border-left: none;
		}

		.special-grid a:nth-child(n + 4) {
			border-top: 1px solid var(--color-border);
		}
	}

	@media (max-width: 40rem) {
		.special-grid {
			grid-template-columns: 1fr;
		}

		.special-grid a {
			min-height: 7.5rem;
			padding: 1.4rem;
			border-left: none;
			border-top: 1px solid var(--color-border);
		}

		.special-grid a:first-child {
			border-top: none;
		}

		.special-grid h3 {
			font-size: 1.5rem;
		}
	}
</style>
