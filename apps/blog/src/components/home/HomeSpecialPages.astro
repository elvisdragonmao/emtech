---
import { ArrowRight } from "@lucide/astro";
import SectionTitle from "@/components/shared/SectionTitle.astro";

const specialPages = [
	{ title: "交個朋友", description: "打開我的電子報" },
	{ title: "友情連結", description: "我的好朋友們" },
	{ title: "關於本站", description: "伴隨我們開始？" },
	{ title: "RSS", description: "從海量內容中控管" }
];
---

<section class="section-block special-pages">
	<SectionTitle eyebrow="Special Pages" title="疑，這是什麼？" />
	<div class="special-grid">
		{
			specialPages.map(page => (
				<a class="card" href="/article/">
					<h3>{page.title}</h3>
					<p>{page.description}</p>
					<ArrowRight size={17} stroke-width={1.8} />
				</a>
			))
		}
	</div>
</section>

<style>
	.section-block {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.special-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border: 1px solid var(--color-border);
	}

	.special-grid a {
		position: relative;
		min-height: 8.5rem;
		padding: 1.75rem;
		border-left: 1px solid var(--color-border);
		transition: background 180ms ease;
	}

	.special-grid a::before {
		content: "";
		position: absolute;
		inset: 0;
		top: auto;
		height: 2px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 220ms ease;
	}

	.special-grid a:first-child {
		border-left: none;
	}

	.special-grid a:hover {
		background: var(--color-surface-soft);
	}

	.special-grid a:hover::before {
		transform: scaleX(1);
	}

	.special-grid a:hover h3 {
		color: var(--color-accent);
	}

	.special-grid a:hover svg {
		transform: translate(0.2rem, -0.2rem);
	}

	.special-grid h3 {
		font-size: 1.75rem;
		line-height: 1;
		letter-spacing: -0.055em;
		color: var(--color-ink);
		transition: color 180ms ease;
	}

	.special-grid p {
		margin-top: 0.75rem;
		font-size: 1rem;
		color: var(--color-muted);
	}

	.special-grid svg {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		color: var(--color-accent-strong);
		transition: transform 180ms ease;
	}

	@media (max-width: 57.5rem) {
		.special-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.special-grid a:nth-child(odd) {
			border-left: none;
		}

		.special-grid a:nth-child(n + 3) {
			border-top: 1px solid var(--color-border);
		}
	}

	@media (max-width: 40rem) {
		.special-grid {
			grid-template-columns: 1fr;
		}

		.special-grid a {
			min-height: 7.5rem;
			padding: 1.4rem;
			border-left: none;
			border-top: 1px solid var(--color-border);
		}

		.special-grid a:first-child {
			border-top: none;
		}

		.special-grid h3 {
			font-size: 1.5rem;
		}
	}
</style>
