---
import { ClientRouter } from "astro:transitions";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SearchDialog from "@/components/shared/SearchDialog.astro";
import ScrollToTopButton from "@/components/shared/ScrollToTopButton.astro";
import { DEFAULT_SEO_IMAGE, SITE_LANGUAGE, SITE_LOCALE, SITE_NAME, absoluteUrl, pageTitle, safeJsonLd, toSeoImage, withSchemaContext, type JsonLd, type SeoImageInput } from "@/utils/seo";
import "@/styles/global.css";

interface Props {
	title?: string;
	description?: string;
	active?: "home" | "blog" | "course";
	canonicalPath?: string;
	image?: SeoImageInput;
	imageAlt?: string;
	ogType?: "website" | "article";
	noindex?: boolean;
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	authors?: string[];
	tags?: string[];
	structuredData?: JsonLd | JsonLd[];
}

const {
	title = SITE_NAME,
	description = "科技、設計、毛茸茸的資訊密技與教學筆記。",
	active,
	canonicalPath = Astro.url.pathname,
	image,
	imageAlt,
	ogType = title === SITE_NAME ? "website" : "article",
	noindex = false,
	publishedTime,
	modifiedTime,
	authors = [],
	tags = [],
	structuredData
} = Astro.props;
const fullTitle = pageTitle(title);
const canonicalUrl = absoluteUrl(canonicalPath);
const seoImage = toSeoImage(image ?? DEFAULT_SEO_IMAGE, imageAlt ?? title);
const jsonLd = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content={authors[0] ?? "毛哥EM"} />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		<meta name="theme-color" content="#f7fbff" data-theme-color />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={absoluteUrl("/rss.xml")} />
		<link rel="icon" href="/img/favicon/favicon.ico" />
		<link rel="apple-touch-icon" href="/img/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/img/favicon/site.webmanifest" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content={SITE_LOCALE} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={seoImage.src} />
		<meta property="og:image:secure_url" content={seoImage.src} />
		{seoImage.type && <meta property="og:image:type" content={seoImage.type} />}
		{seoImage.width && <meta property="og:image:width" content={String(seoImage.width)} />}
		{seoImage.height && <meta property="og:image:height" content={String(seoImage.height)} />}
		<meta property="og:image:alt" content={seoImage.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={seoImage.src} />
		<meta name="twitter:image:alt" content={seoImage.alt} />
		{
			ogType === "article" && (
				<>
					{publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
					{modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
					{authors.map(author => (
						<meta property="article:author" content={author} />
					))}
					{tags.map(tag => (
						<meta property="article:tag" content={tag} />
					))}
				</>
			)
		}
		<script is:inline>
			(() => {
				const storageKey = "emtech:theme";
				const themeColors = { light: "#f7fbff", dark: "#141821" };

				const getTheme = () => {
					try {
						const stored = window.localStorage.getItem(storageKey);
						return stored === "dark" ? "dark" : "light";
					} catch {
						return "light";
					}
				};

				const applyTheme = theme => {
					document.documentElement.dataset.theme = theme;
					document.documentElement.style.colorScheme = theme;
					document.querySelector("[data-theme-color]")?.setAttribute("content", themeColors[theme]);
				};

				applyTheme(getTheme());
			})();
		</script>
		{jsonLd.map(item => <script is:inline type="application/ld+json" set:html={safeJsonLd(withSchemaContext(item))} />)}
		<title>{fullTitle}</title>
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main-content">跳到主要內容</a>
		<div class="page-shell">
			<SiteHeader active={active} />
			<slot />
			<SiteFooter />
			<SearchDialog />
			<ScrollToTopButton />
		</div>
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 200;
		padding: 0.65rem 0.85rem;
		font-weight: 800;
		color: var(--color-ink);
		background: var(--color-surface);
		border: 2px solid var(--color-accent-strong);
		box-shadow: var(--shadow-card);
		transform: translateY(calc(-100% - 1rem));
		transition: transform 160ms ease;
	}

	.skip-link:focus-visible {
		transform: translateY(0);
	}

	.page-shell {
		--page-padding: 2.75rem;
		position: relative;
		min-height: 100vh;
		padding-inline: var(--page-padding);
		overflow: clip;
	}

	.page-shell::before,
	.page-shell::after {
		position: fixed;
		top: 0;
		bottom: 0;
		width: var(--page-padding);
		content: "";
		border-inline: 1px solid var(--color-border);
		background: repeating-linear-gradient(135deg, transparent 0 0.5rem, var(--color-hatch-glass) 0.5rem 0.75rem), var(--color-inset-highlight);
	}

	.page-shell::before {
		left: 0;
	}

	.page-shell::after {
		right: 0;
	}

	@media (max-width: 40rem) {
		.page-shell::before,
		.page-shell::after {
			display: none;
		}
	}

	@media (max-width: 40rem) {
		.page-shell {
			--page-padding: 1rem;
		}
	}
</style>
