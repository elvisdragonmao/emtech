---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import CourseCard from "@/components/shared/CourseCard.astro";
import Comments from "@/components/Comments.astro";
import Layout from "@/layouts/Layout.astro";
import { formatDate, normalizeImportPath } from "@/utils/content";
import type { CourseCardData } from "@/components/shared/CourseCard.astro";

const courses = (await getCollection("course")).sort((a, b) => a.data.displayOrder - b.data.displayOrder || a.data.title.localeCompare(b.data.title));
const allLessons = (await getCollection("lesson")).filter(lesson => !lesson.data.draft);
const allThumbs = import.meta.glob<{ default: ImageMetadata }>("/src/content/course/*/*/thumbnail.webp", { eager: true });

const courseCards: CourseCardData[] = courses.map(c => {
	const thumbKey = normalizeImportPath(`/src/content/course/${c.id}/${c.data.thumbnail}`);
	const img = allThumbs[thumbKey]?.default ?? null;
	const courseLessons = allLessons.filter(l => l.id.startsWith(`${c.id}/`));
	const latestDate = courseLessons.reduce((acc, l) => (l.data.date > acc ? l.data.date : acc), new Date(0));
	return {
		title: c.data.title,
		description: c.data.description,
		meta: c.data.meta ?? `${courseLessons.length} 單元 / 課程`,
		lastUpdated: formatDate(latestDate),
		href: `/course/${c.id}/`,
		image: img,
		accent: c.data.accent
	};
});

const topCourses = courseCards.slice(0, 3);
const featuredCourses = courseCards.slice(3);
---

<Layout title="課程" description="程式開發與設計系列課程" active="course">
	<main id="main-content" class="courses-page" tabindex="-1">
		<header class="courses-header">
			<p class="eyebrow">Course</p>
			<h1>課程</h1>
			<p class="lead">鐵人賽系列文章和詳細的程式開發與設計教學</p>
		</header>
		<section class="courses-body">
			<div class="course-grid-top">
				{topCourses.map(course => <CourseCard course={course} />)}
			</div>
			{
				featuredCourses.length > 0 && (
					<div class="course-grid-featured">
						{featuredCourses.map(course => (
							<CourseCard course={course} featured={true} />
						))}
					</div>
				)
			}
		</section>
		<section class="comments-wrap">
			<Comments pagePath={Astro.url.pathname} />
		</section>
	</main>
</Layout>

<style>
	.courses-page {
		width: min(var(--site-width), 100%);
		margin-inline: auto;
		padding: 5.5rem 2rem 7.5rem;
	}

	.courses-header {
		margin-bottom: 3rem;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.lead {
		margin-top: 1.5rem;
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-muted);
	}

	.courses-body {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.comments-wrap {
		margin-top: 5.75rem;
	}

	.course-grid-top {
		display: grid;
		grid-template-columns: 1.3fr 1fr 1fr;
		gap: 0;
	}

	.course-grid-top :global(.course-card:first-child h3) {
		font-size: 3rem;
	}

	.course-grid-top :global(.course-card:not(:hover)) {
		border-right: none;
	}

	.course-grid-top :global(.course-card:last-child:not(:hover)) {
		border-right: 1px solid var(--color-border);
	}

	.course-grid-featured {
		display: flex;
	}

	@media (max-width: 57.5rem) {
		.course-grid-top {
			grid-template-columns: 1fr;
		}

		.course-grid-top :global(.course-card:not(:hover)) {
			border-right: 1px solid var(--color-border);
			border-bottom: none;
		}

		.course-grid-top :global(.course-card:last-child:not(:hover)) {
			border-bottom: 1px solid var(--color-border);
		}

		.course-grid-featured {
			display: grid;
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 40rem) {
		.courses-page {
			padding: 3.25rem 0 5.5rem;
		}

		.course-grid-top :global(.course-card:first-child h3) {
			font-size: 2.25rem;
		}

		.comments-wrap {
			margin-top: 3rem;
		}
	}
</style>
