---
import { BookOpen, Clock, Users } from "@lucide/astro";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import CourseModuleRow from "@/components/course/CourseModuleRow.astro";
import Comments from "@/components/Comments.astro";
import Layout from "@/layouts/Layout.astro";
import { extractExcerpt, extractTitle, formatDate, readingTime, resolveCourseThumbnail, resolveLessonThumbnail } from "@/utils/content";
import { courseSchema, breadcrumbSchema, itemListSchema, publisherSchema, webPageSchema } from "@/utils/seo";

export async function getStaticPaths() {
	const courses = await getCollection("course");
	return courses.map(course => ({ params: { courseId: course.id } }));
}

const { courseId } = Astro.params;
const courses = await getCollection("course");
const courseEntry = courses.find(c => c.id === courseId);

if (!courseEntry) return Astro.redirect("/404");

const allLessons = (await getCollection("lesson")).filter(lesson => !lesson.data.draft);
const lessons = allLessons
	.filter(l => l.id.startsWith(`${courseId}/`))
	.sort((a, b) => {
		const order = courseEntry.data.order;
		const aId = a.id.replace(`${courseId}/`, "");
		const bId = b.id.replace(`${courseId}/`, "");
		return order.indexOf(aId) - order.indexOf(bId);
	});

// Discover thumbnails for lessons
const allThumbs = import.meta.glob<{ default: ImageMetadata }>("/src/content/course/**/thumbnail.{avif,gif,jpeg,jpg,png,webp}", { eager: true });

// Course-level thumbnail
const courseThumbnail = resolveCourseThumbnail(courseEntry, allThumbs);

// Most-recent lesson update date
const latestDate = lessons.reduce((acc, l) => {
	const modified = l.data.lastmod ?? l.data.date;
	return modified > acc ? modified : acc;
}, new Date(0));

const totalModules = lessons.length;

const courseData = courseEntry.data;
const outcomes = courseData.outcomes ?? [];
const courseThumbnailSrc = typeof courseThumbnail === "string" ? courseThumbnail : courseThumbnail?.src;
const courseThumbnailWidth = typeof courseThumbnail === "string" ? undefined : courseThumbnail?.width;
const courseThumbnailHeight = typeof courseThumbnail === "string" ? undefined : courseThumbnail?.height;
const breadcrumbId = `https://emtech.cc/course/${courseId}/#breadcrumb`;
const courseUrl = `/course/${courseId}/`;
const structuredData = [
	publisherSchema(),
	breadcrumbSchema(
		[
			{ name: "首頁", url: "/" },
			{ name: "課程", url: "/course/" },
			{ name: courseData.title, url: courseUrl }
		],
		breadcrumbId
	),
	webPageSchema({ url: courseUrl, title: courseData.title, description: courseData.description, image: courseThumbnail, type: "WebPage", breadcrumbId, dateModified: latestDate }),
	courseSchema({ url: courseUrl, title: courseData.title, description: courseData.description, image: courseThumbnail, courseId, lessonCount: totalModules, dateModified: latestDate }),
	itemListSchema(
		lessons.map(lesson => {
			const lessonId = lesson.id.replace(`${courseId}/`, "");
			return {
				url: `/course/${courseId}/${lessonId}/`,
				name: extractTitle(lesson.body) || lesson.data.description || lessonId
			};
		}),
		`https://emtech.cc/course/${courseId}/#lesson-list`
	)
];
---

<Layout
	title={courseData.title}
	description={courseData.description}
	active="course"
	canonicalPath={courseUrl}
	image={courseThumbnail}
	imageAlt={courseData.title}
	ogType="website"
	structuredData={structuredData}
>
	<main id="main-content" class="course-page" tabindex="-1">
		<section class="course-hero">
			<div class="hero-copy">
				<p class="eyebrow">課程</p>
				<h1>{courseData.title}</h1>
				<p class="lead">{courseData.description}</p>
				{
					outcomes.length > 0 && (
						<div class="outcomes">
							{outcomes.map((item, i) => (
								<article>
									<span>學習目標 {String(i + 1).padStart(2, "0")}</span>
									<h2>{item.title}</h2>
									<p>{item.text}</p>
								</article>
							))}
						</div>
					)
				}
			</div>
			<article class="overview-card">
				<span>課程總覽</span>
				<h2>{totalModules} 單元</h2>
				<p>適合對象：{courseData.meta ?? "所有學習者"}</p>
				<div class="progress">
					<strong>閱讀路徑</strong>
					<i></i>
				</div>
				{courseThumbnailSrc && <img class="overview-thumb" src={courseThumbnailSrc} width={courseThumbnailWidth} height={courseThumbnailHeight} alt={courseData.title} />}
				<div class="quick-stats">
					<div><BookOpen size={18} stroke-width={1.8} aria-hidden="true" /><span>{totalModules} 章節</span></div>
					<div>
						<Clock size={18} stroke-width={1.8} aria-hidden="true" />
						<span>最後更新 {formatDate(latestDate)}</span>
					</div>
					<div><Users size={18} stroke-width={1.8} aria-hidden="true" /><span>適合<br />所有學習者</span></div>
				</div>
			</article>
		</section>

		<section class="curriculum">
			{
				lessons.map((lesson, i) => {
					const lessonId = lesson.id.replace(`${courseId}/`, "");
					const thumb = resolveLessonThumbnail(lesson, allThumbs);
					return (
						<CourseModuleRow
							module={{
								number: `Module ${String(i + 1).padStart(2, "0")}`,
								title: extractTitle(lesson.body) || lesson.data.description || lessonId,
								description: lesson.data.description ?? extractExcerpt(lesson.body),
								duration: readingTime(lesson.body ?? lesson.data.description ?? ""),
								image: thumb,
								href: `/course/${courseId}/${lessonId}/`
							}}
						/>
					);
				})
			}
		</section>
		<section class="comments-wrap">
			<Comments pagePath={Astro.url.pathname} />
		</section>
	</main>
</Layout>

<style>
	.course-page {
		padding-top: 5.5rem;
	}

	.course-hero,
	.curriculum {
		width: min(var(--site-width), calc(100% - 2rem));
		margin-inline: auto;
	}

	.course-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 24.5rem;
		gap: 2rem;
		align-items: flex-end;
		padding-bottom: 2rem;
	}

	.hero-copy {
		padding-top: 0.75rem;
		height: 100%;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h1 {
		margin-top: 1.5rem;
		font-size: 4.25rem;
		line-height: 0.95;
		letter-spacing: -0.05em;
		color: var(--color-ink);
		text-wrap: balance;
	}

	.lead {
		max-width: 57.5rem;
		margin-top: 2rem;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.5;
		color: var(--color-text);
	}

	.overview-card {
		position: relative;
		padding: 2.25rem;
		margin-top: 2rem;
		background: var(--color-surface-glass-strong);
		border: 1px solid var(--color-border);
	}

	.overview-card::after {
		position: absolute;
		right: -5.5rem;
		bottom: -4rem;
		z-index: -1;
		width: 13.75rem;
		height: 13.75rem;
		content: "";
		border: 1px solid oklch(71% 0.15 225 / 48%);
		border-radius: 50%;
	}

	.overview-card > span {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--color-accent-strong);
	}

	.overview-card h2 {
		margin-top: 1.25rem;
		font-size: 3rem;
		line-height: 1;
		letter-spacing: -0.07em;
		color: var(--color-ink);
	}

	.overview-card p {
		margin-top: 1.5rem;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.progress {
		margin-top: 2.75rem;
	}

	.progress strong {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.progress i {
		display: block;
		width: 100%;
		height: 0.5rem;
		margin-top: 1rem;
		background: var(--color-border);
	}

	.overview-thumb {
		width: 100%;
		aspect-ratio: 2 / 1;
		height: auto;
		margin-top: 1.75rem;
		object-fit: cover;
		background: var(--color-paper);
	}

	.quick-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.quick-stats div {
		display: grid;
		place-items: center;
		text-align: center;
		gap: 0.5rem;
		padding: 1rem 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--color-text);
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
	}

	.quick-stats svg {
		color: var(--color-accent-strong);
	}

	.outcomes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 3.75rem;
		background: color-mix(in oklch, var(--color-surface) 58%, transparent);
		border: 1px solid var(--color-border);
	}

	.outcomes article {
		padding: 2rem;
		border-right: 1px solid var(--color-border);
	}

	.outcomes article:last-child {
		border-right: none;
	}

	.outcomes span {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.outcomes h2 {
		margin-top: 1.25rem;
		font-size: 1.25rem;
		line-height: 1.35;
		color: var(--color-ink);
	}

	.outcomes p {
		margin-top: 0.75rem;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.curriculum {
		background: color-mix(in oklch, var(--color-surface) 58%, transparent);
		border: 1px solid var(--color-border);
		border-inline: 0;
		border-top-color: var(--color-ink);
	}

	.comments-wrap {
		width: min(var(--site-width), calc(100% - 2rem));
		margin: 5.75rem auto 0;
	}

	@media (max-width: 57.5rem) {
		.course-hero {
			grid-template-columns: 1fr;
		}

		.outcomes {
			grid-template-columns: 1fr;
		}

		.outcomes article {
			border-right: none;
			border-bottom: 1px solid var(--color-border);
		}

		.outcomes article:last-child {
			border-bottom: none;
		}

		.overview-card {
			margin-top: 1.25rem;
		}
	}

	@media (max-width: 38.75rem) {
		.course-page {
			padding-top: 3.25rem;
		}

		h1 {
			font-size: 3rem;
			line-height: 1.05;
		}

		.lead {
			font-size: 1.15rem;
		}

		.quick-stats {
			grid-template-columns: 1fr;
		}

		.overview-card {
			padding: 1.5rem;
		}

		.overview-card::after {
			display: none;
		}

		.comments-wrap {
			margin-top: 3rem;
		}
	}
</style>
