---
import { getCollection } from "astro:content";
import HomeArchive from "@/components/home/HomeArchive.astro";
import HomeCoursesPreview from "@/components/home/HomeCoursesPreview.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomeSpecialPages from "@/components/home/HomeSpecialPages.astro";
import Comments from "@/components/Comments.astro";
import AboutCard from "@/components/shared/AboutCard.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE_DESCRIPTION, SITE_NAME, authorSchema, itemListSchema, publisherSchema, webPageSchema, webSiteSchema } from "@/utils/seo";

const posts = (await getCollection("post")).filter(post => !post.data.draft);
const courses = await getCollection("course");
const latestModified = [...posts.map(post => post.data.lastmod ?? post.data.date)].sort((a, b) => b.getTime() - a.getTime())[0];
const structuredData = [
	publisherSchema(),
	authorSchema(),
	webSiteSchema(),
	webPageSchema({ url: "/", title: SITE_NAME, description: SITE_DESCRIPTION, type: "WebPage", dateModified: latestModified }),
	itemListSchema(
		courses
			.sort((a, b) => a.data.displayOrder - b.data.displayOrder || a.data.title.localeCompare(b.data.title))
			.map(course => ({
				url: `/course/${course.id}/`,
				name: course.data.title
			})),
		"https://emtech.cc/#course-list"
	)
];
---

<Layout active="home" structuredData={structuredData} ogType="website">
	<main id="main-content" class="home-container" tabindex="-1">
		<HomeHero />
		<HomeArchive />
		<HomeCoursesPreview />
		<HomeSpecialPages />

		<section class="about-section">
			<AboutCard />
		</section>

		<section>
			<Comments pagePath={Astro.url.pathname} />
		</section>
	</main>
</Layout>

<style>
	.home-container {
		display: flex;
		flex-direction: column;
		gap: 7.5rem;
		width: min(var(--site-width), 100%);
		margin-inline: auto;
		padding: 0 2rem;
	}

	.about-section {
		display: flex;
		justify-content: center;
	}

	@media (max-width: 40rem) {
		.home-container {
			gap: 5.25rem;
			padding-inline: 0;
		}
	}
</style>
