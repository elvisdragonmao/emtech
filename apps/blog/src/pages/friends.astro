---
import { ArrowUpRight } from "@lucide/astro";
import Comments from "@/components/Comments.astro";
import friendsData from "@/content/post/friends/friends.json";
import Layout from "@/layouts/Layout.astro";
import { absoluteUrl, itemListSchema, publisherSchema, webPageSchema } from "@/utils/seo";

type Friend = {
	name: string;
	url: string;
	image?: string;
	description: string;
};

type FriendSection = {
	title: string;
	friends: Friend[];
};

const localFriendImages = import.meta.glob<{ default: ImageMetadata }>("/src/content/post/friends/*.{png,jpg,jpeg,webp,avif,gif}", { eager: true });
const collator = new Intl.Collator(["zh-Hant", "zh-Hans", "en"], { numeric: true, sensitivity: "base" });

const resolveImageSrc = (value?: string) => {
	if (!value) return undefined;
	if (/^(https?:)?\/\//i.test(value) || value.startsWith("/")) return value;

	const normalized = value.replace(/^\.\//, "");
	return localFriendImages[`/src/content/post/friends/${normalized}`]?.default.src;
};

const sections = (friendsData.sections as FriendSection[]).map(section => ({
	...section,
	friends: [...section.friends].sort((left, right) => collator.compare(left.name, right.name))
}));

const totalFriends = sections.reduce((total, section) => total + section.friends.length, 0);
const friendItems = sections.flatMap(section =>
	section.friends.map(friend => ({
		url: friend.url,
		name: friend.name,
		item: {
			"@type": "WebSite",
			name: friend.name,
			url: /^https?:\/\//i.test(friend.url) ? friend.url : absoluteUrl(friend.url),
			description: friend.description
		}
	}))
);
const structuredData = [
	publisherSchema(),
	webPageSchema({ url: "/friends/", title: "友情連結", description: "有朋自遠方來，不亦悅乎？這裡收藏毛哥EM的朋友們與他們的網站。", type: "CollectionPage" }),
	itemListSchema(friendItems, "https://emtech.cc/friends/#friend-list")
];
---

<Layout title="友情連結" description="有朋自遠方來，不亦悅乎？這裡收藏毛哥EM的朋友們與他們的網站。" canonicalPath="/friends/" ogType="website" structuredData={structuredData}>
	<main id="main-content" class="friends-page" tabindex="-1">
		<header class="friends-header" aria-labelledby="friends-title">
			<p class="eyebrow">朋友</p>
			<div class="header-grid">
				<div>
					<h1 id="friends-title">友情連結</h1>
					<p class="lede">有朋自遠方來，不亦悅乎？</p>
				</div>
				<div class="hero-note" aria-label={`目前收錄 ${totalFriends} 位朋友`}>
					<span>{totalFriends}</span>
					<p>位朋友<br />與他們的網站</p>
				</div>
			</div>
		</header>

		<div class="sections-stack">
			{
				sections.map(section => (
					<section class="friend-section" aria-labelledby={`section-${section.title}`}>
						<div class="section-heading">
							<h2 id={`section-${section.title}`}>{section.title}</h2>
							<p>{section.friends.length} 個連結</p>
						</div>
						<div class="friend-grid">
							{section.friends.map(friend => {
								const imageSrc = resolveImageSrc(friend.image);
								const isExternal = /^https?:\/\//i.test(friend.url);
								const host = isExternal ? new URL(friend.url).hostname.replace(/^www\./, "") : "emtech.cc";

								return (
									<a class="friend-card" href={friend.url} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noreferrer" : undefined}>
										<div class="avatar" aria-hidden={imageSrc ? undefined : "true"}>
											{imageSrc ? <img src={imageSrc} alt={`${friend.name} 頭像`} loading="lazy" decoding="async" /> : <span>{friend.name.slice(0, 1)}</span>}
										</div>
										<div class="friend-content">
											<h3>{friend.name}</h3>
											<p>{friend.description}</p>
											<span class="friend-url">{host}</span>
										</div>
										<ArrowUpRight class="card-arrow" size={19} stroke-width={1.8} aria-hidden="true" />
									</a>
								);
							})}
						</div>
					</section>
				))
			}
		</div>

		<section class="comments-panel" aria-label="友情連結留言區">
			<div class="comments-note">
				<p class="eyebrow">申請收錄</p>
				<p>如果你也想出現在這裡，或是想加我，歡迎在底下留言提供照片、網址、簡介等資訊給我嗷！</p>
			</div>
			<Comments pagePath="/friends/" />
		</section>
	</main>
</Layout>

<style>
	.friends-page {
		display: flex;
		flex-direction: column;
		gap: 4rem;
		width: min(var(--site-width), 100%);
		margin-inline: auto;
		padding: 5.5rem 2rem 1rem;
	}

	.friends-header {
		position: relative;
		padding-bottom: 4rem;
		border-bottom: 1px solid var(--color-border);
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.header-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 2rem;
	}

	.lede {
		max-width: 41rem;
		margin-top: 1.5rem;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.hero-note {
		display: grid;
		grid-template-columns: auto auto;
		align-items: center;
		gap: 1rem;
		justify-self: end;
		padding: 1.25rem;
		background: var(--color-surface);
		border: 1px solid var(--color-grid);
		box-shadow: 0.45rem 0.45rem 0 oklch(61% 0.17 232 / 10%);
	}

	.hero-note span {
		font-family: var(--font-mono);
		font-size: clamp(3rem, 8vw, 5.5rem);
		font-weight: 800;
		line-height: 0.9;
		letter-spacing: -0.08em;
		color: var(--color-accent-strong);
	}

	.hero-note p {
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-ink);
	}

	.sections-stack {
		display: grid;
		gap: 3rem;
	}

	.friend-section {
		display: grid;
		gap: 1.25rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--color-border);
	}

	.section-heading h2 {
		font-size: clamp(2rem, 5vw, 3.6rem);
		line-height: 1;
		letter-spacing: -0.08em;
		color: var(--color-ink);
	}

	.section-heading p {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.friend-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top: 1px solid var(--color-border);
		border-left: 1px solid var(--color-border);
	}

	.friend-card {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1rem;
		min-height: 11rem;
		padding: 1.3rem;
		background: var(--color-surface-glass-soft);
		border-right: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		transition:
			background 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	.friend-card::before {
		position: absolute;
		inset: 0;
		top: auto;
		height: 0.2rem;
		content: "";
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 180ms ease;
	}

	.friend-card:hover {
		z-index: 1;
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		transform: translateY(-0.15rem);
	}

	.friend-card:hover::before {
		transform: scaleX(1);
	}

	.avatar {
		display: grid;
		place-items: center;
		width: 4.25rem;
		height: 4.25rem;
		overflow: hidden;
		font-size: 1.6rem;
		font-weight: 800;
		color: var(--color-accent-strong);
		background: linear-gradient(135deg, var(--color-accent-soft), var(--color-surface)), radial-gradient(circle at 20% 20%, var(--color-accent) 0 0.4rem, transparent 0.45rem);
		border: 1px solid var(--color-border);
		border-radius: 999px;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.friend-content {
		min-width: 0;
		padding-right: 1.5rem;
	}

	.friend-content h3 {
		font-size: 1.35rem;
		line-height: 1.1;
		letter-spacing: -0.045em;
		color: var(--color-ink);
	}

	.friend-content p {
		margin-top: 0.65rem;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--color-muted);
	}

	.friend-url {
		display: inline-block;
		max-width: 100%;
		margin-top: 1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-accent-strong);
		overflow-wrap: anywhere;
	}

	.card-arrow {
		position: absolute;
		top: 1.2rem;
		right: 1.2rem;
		color: var(--color-faint);
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.friend-card:hover .card-arrow {
		color: var(--color-accent-strong);
		transform: translate(0.18rem, -0.18rem);
	}

	.comments-panel {
		display: grid;
		gap: 1.5rem;
	}

	.comments-note {
		width: min(57.5rem, 100%);
		margin-inline: auto;
		padding: 1rem 1.25rem;
		background: var(--color-surface-glass-soft);
		border: 1px solid var(--color-border);
		border-left: 0.3rem solid var(--color-accent-strong);
	}

	.comments-note p:not(.eyebrow) {
		margin-top: 0.4rem;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--color-muted);
	}

	@media (max-width: 80rem) {
		.friend-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 64rem) {
		.friend-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 46rem) {
		.friends-page {
			gap: 3rem;
			padding: 3.25rem 0 0;
		}

		.header-grid,
		.section-heading {
			display: grid;
			align-items: start;
		}

		.friends-header {
			padding-inline: 1rem;
			padding-bottom: 3rem;
		}

		.hero-note {
			width: fit-content;
			justify-self: start;
		}

		.friend-grid {
			grid-template-columns: 1fr;
		}

		.friend-card {
			min-height: auto;
			padding: 1.15rem;
		}

		.avatar {
			width: 3.75rem;
			height: 3.75rem;
		}
	}
</style>
