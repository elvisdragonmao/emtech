---
import { ArrowRight } from "@lucide/astro";
import { getCollection, render } from "astro:content";
import type { ImageMetadata } from "astro";
import AboutCard from "@/components/shared/AboutCard.astro";
import ArticleCard from "@/components/shared/ArticleCard.astro";
import Comments from "@/components/Comments.astro";
import PostBody from "@/components/shared/PostBody.astro";
import Layout from "@/layouts/Layout.astro";
import { extractExcerpt, extractTitle, formatDate, formatHashTags, normalizeTerms, readingTime, resolvePostThumbnail, wordCount, type ImageInput, type MetaItem } from "@/utils/content";
import { blogPostingSchema, breadcrumbSchema, publisherSchema, webPageSchema, wordCountNumber } from "@/utils/seo";

export async function getStaticPaths() {
	const posts = (await getCollection("post")).filter(post => !post.data.draft);
	return posts.map(post => ({ params: { postId: post.id } }));
}

const { postId } = Astro.params;
const posts = (await getCollection("post")).filter(post => !post.data.draft);
const entry = posts.find(p => p.id === postId);

if (!entry) return Astro.redirect("/404");

const { Content, headings } = await render(entry);

const thumbnails = import.meta.glob<{ default: ImageMetadata }>("/src/content/post/**/thumbnail.{avif,gif,jpeg,jpg,png,webp}", { eager: true });
const thumbnail: ImageInput = resolvePostThumbnail(entry, thumbnails);

const title = headings[0]?.text ?? postId;
const description = entry.data.description ?? extractExcerpt(entry.body);
const entryTags = normalizeTerms(entry.data.tags);
const entryCategories = normalizeTerms(entry.data.categories);
const tag = formatHashTags(entryTags.length > 0 ? entryTags : entryCategories);
const modifiedTime = entry.data.lastmod ?? entry.data.date;
const authors = [entry.data.authors].flat().filter((author): author is string => Boolean(author));
const displayAuthors = authors.map(author => (author === "elvismao" ? "毛哥EM" : author));
const breadcrumbId = `https://emtech.cc/p/${postId}/#breadcrumb`;
const structuredData = [
	publisherSchema(),
	breadcrumbSchema(
		[
			{ name: "首頁", url: "/" },
			{ name: "文章", url: "/archive/" },
			{ name: title, url: `/p/${postId}/` }
		],
		breadcrumbId
	),
	webPageSchema({ url: `/p/${postId}/`, title, description, image: thumbnail, type: "WebPage", breadcrumbId, dateModified: modifiedTime }),
	blogPostingSchema({
		url: `/p/${postId}/`,
		title,
		description,
		image: thumbnail,
		datePublished: entry.data.date,
		dateModified: modifiedTime,
		authors: displayAuthors,
		tags: entryTags,
		categories: entryCategories,
		wordCount: wordCountNumber(entry.body)
	})
];

const contentText = entry.body ?? "";
const meta: MetaItem[] = [
	{ label: "Date", value: formatDate(entry.data.date) },
	{ label: "Category", value: entryCategories[0] ?? "" },
	{ label: "Read Time", value: readingTime(contentText) },
	{ label: "Word", value: wordCount(contentText) },
	{ label: "Last Mod", value: formatDate(entry.data.date) }
];

const allPosts = posts;
const postsByDate = [...allPosts].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const currentPostIndex = postsByDate.findIndex(p => p.id === postId);
const previousPost = currentPostIndex > 0 ? postsByDate[currentPostIndex - 1] : null;
const nextPost = currentPostIndex >= 0 && currentPostIndex < postsByDate.length - 1 ? postsByDate[currentPostIndex + 1] : null;

type RelatedFilter = {
	type: "tag" | "category";
	value: string;
};

const relatedFilters: RelatedFilter[] = [...entryTags.slice(0, 2).map(value => ({ type: "tag" as const, value })), ...entryCategories.slice(0, 1).map(value => ({ type: "category" as const, value }))];

const getRelatedPosts = (filter: RelatedFilter) =>
	allPosts
		.filter(p => {
			if (p.id === postId || !filter.value) return false;
			const terms = filter.type === "tag" ? normalizeTerms(p.data.tags) : normalizeTerms(p.data.categories);
			return terms.includes(filter.value);
		})
		.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
		.slice(0, 10);

const relatedResult = relatedFilters.map(filter => ({ filter, posts: getRelatedPosts(filter) })).find(result => result.posts.length > 0);
const relatedFilterType = relatedResult?.filter.type ?? relatedFilters[0]?.type ?? "category";
const relatedFilterValue = relatedResult?.filter.value ?? relatedFilters[0]?.value ?? "";
const related = relatedResult?.posts ?? [];

const moreRelatedHref = relatedFilterValue ? `/?${relatedFilterType}=${encodeURIComponent(relatedFilterValue)}#archive` : "/#archive";

// Build related article card data (needs thumbnail discovery)
const relatedCards = related.map(p => {
	return {
		title: extractTitle(p.body) || p.id,
		href: `/p/${p.id}/`,
		image: resolvePostThumbnail(p, thumbnails),
		tag: formatHashTags(normalizeTerms(p.data.tags).length > 0 ? p.data.tags : p.data.categories),
		description: p.data.description ?? "",
		category: p.data.categories[0],
		date: formatDate(p.data.date)
	};
});
---

<Layout
	title={title}
	description={description}
	active="blog"
	canonicalPath={`/p/${postId}/`}
	image={thumbnail}
	imageAlt={title}
	ogType="article"
	publishedTime={entry.data.date}
	modifiedTime={modifiedTime}
	authors={displayAuthors}
	tags={entryTags}
	structuredData={structuredData}
>
	<main id="main-content" class="article-page" tabindex="-1">
		<PostBody
			tag={tag}
			title={title}
			image={thumbnail}
			meta={meta}
			tldr={description}
			headings={headings}
			previousHref={previousPost ? `/p/${previousPost.id}/` : undefined}
			previousTitle={previousPost ? extractTitle(previousPost.body) || previousPost.id : undefined}
			nextHref={nextPost ? `/p/${nextPost.id}/` : undefined}
			nextTitle={nextPost ? extractTitle(nextPost.body) || nextPost.id : undefined}
		>
			<Content />
		</PostBody>

		<section class="about-wrap">
			<AboutCard copyright />
		</section>

		<section class="comments-wrap">
			<Comments pagePath={Astro.url.pathname} />
		</section>

		{
			relatedCards.length > 0 && (
				<section class="related-wrap">
					<h2>相關文章</h2>
					<div class="related-grid">
						{relatedCards.map(related => (
							<ArticleCard article={related} />
						))}
						<a class="more-card card" href={moreRelatedHref}>
							想要更多？
							<ArrowRight size={18} stroke-width={1.8} aria-hidden="true" />
						</a>
					</div>
				</section>
			)
		}
	</main>
</Layout>

<style>
	.article-page {
		width: min(var(--site-width), 100%);
		margin-inline: auto;
		padding: 5.5rem 2rem 0;
	}

	.about-wrap,
	.related-wrap {
		width: 100%;
	}

	.about-wrap {
		display: flex;
		justify-content: center;
		margin-top: 5.75rem;
	}

	.related-wrap {
		margin-top: 5.75rem;
	}

	.comments-wrap {
		margin-top: 5.75rem;
	}

	.related-wrap > h2 {
		margin-bottom: 1.75rem;
		font-size: 3.25rem;
		line-height: 1;
		letter-spacing: -0.07em;
		color: var(--color-ink);
	}

	.related-grid {
		display: grid;
		grid-auto-columns: minmax(16.5rem, 20rem);
		grid-auto-flow: column;
		gap: 1.25rem;
		margin: -0.5rem -0.5rem 0;
		overflow-x: auto;
		padding: 0.5rem 0.5rem 0.75rem;
		scroll-padding-inline: 1px;
		scroll-snap-type: x proximity;
		-webkit-overflow-scrolling: touch;
	}

	.related-grid :global(.article-card),
	.more-card {
		scroll-snap-align: start;
	}

	.more-card {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 15rem;
		font-weight: 700;
		color: var(--color-text);
	}

	@media (max-width: 68.75rem) {
		.related-grid {
			grid-auto-columns: minmax(15.5rem, 72vw);
		}

		.about-wrap {
			margin-top: 0;
		}
	}

	@media (max-width: 40rem) {
		.article-page {
			padding: 3.25rem 1rem 0;
		}

		.related-grid {
			grid-auto-columns: unset;
			grid-auto-flow: row;
			grid-template-columns: minmax(0, 1fr);
			margin: 0;
			overflow-x: visible;
			padding: 0;
			scroll-snap-type: none;
		}

		.more-card {
			min-height: 7rem;
		}

		.related-wrap > h2 {
			font-size: 2.35rem;
		}

		.related-wrap {
			margin-top: 2rem;
		}

		.comments-wrap {
			margin-top: 2rem;
		}
	}
</style>
