{
	"name": "emtech-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"count:words": "node scripts/count-words.mjs",
		"dev": "pnpm --filter blog dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "pnpm -r typecheck",
		"new": "node scripts/new-post.mjs",
		"prepare": "sh -c 'if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi'",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"verify:file-sizes": "node scripts/verify-file-sizes.mjs",
		"verify:posts": "node scripts/verify-posts.mjs"
	},
	"devDependencies": {
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
	"engines": {
		"node": ">=22.12.0"
	}
}
