{
	"name": "emtech-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"count:words": "node scripts/count-words.mjs",
		"dev": "pnpm --filter blog dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:comment-emojis": "node scripts/generate-comment-emoji-data.mjs",
		"lint": "pnpm -r typecheck",
		"new": "node scripts/new-post.mjs",
		"prepare": "sh -c 'if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi'",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"verify:file-sizes": "node scripts/verify-file-sizes.mjs",
		"verify:posts": "node scripts/verify-posts.mjs"
	},
	"devDependencies": {
		"prettier": "^3.8.4",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^6.0.3",
		"wrangler": "^4.131.2"
	},
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
	"engines": {
		"node": ">=22.12.0"
	}
}
