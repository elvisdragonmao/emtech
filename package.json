{
	"name": "emtech",
	"type": "module",
	"scripts": {
		"build": "tsx emblog/src/cli/generate.ts",
		"dev": "CACHE=true SKIPPOST=true tsx emblog/src/cli/server.ts",
		"format": "prettier --write .",
