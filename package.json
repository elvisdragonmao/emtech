{
	"name": "emtech-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"count:words": "node scripts/count-words.mjs",
		"dev": "pnpm --filter blog dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "pnpm -r typecheck",
		"new": "node scripts/new-post.mjs",
		"prepare": "sh -c 'if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi'",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"verify:file-sizes": "node scripts/verify-file-sizes.mjs",
		"verify:posts": "node scripts/verify-posts.mjs"
	},
	"devDependencies": {
		"prettier": "^3.8.4",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
	"engines": {
		"node": ">=22.12.0"
	}
}
