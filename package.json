{
	"name": "emtech-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"count:words": "node scripts/count-words.mjs",
		"dev": "pnpm --filter blog dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:comment-emojis": "node scripts/generate-comment-emoji-data.mjs",
		"lint": "pnpm -r typecheck",
		"new": "node scripts/new-post.mjs",
		"prepare": "sh -c 'if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi'",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"verify:file-sizes": "node scripts/verify-file-sizes.mjs",
		"verify:posts": "node scripts/verify-posts.mjs"
	},
	"devDependencies": {
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.0.0",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^6.0.3",
		"wrangler": "^4.131.2"
	},
	"packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
	"engines": {
		"node": ">=22.12.0"
	}
}
