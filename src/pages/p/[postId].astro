---
import { ArrowRight } from "@lucide/astro";
import { getCollection, render } from "astro:content";
import type { ImageMetadata } from "astro";
import AboutCard from "../../components/shared/AboutCard.astro";
import ArticleCard from "../../components/shared/ArticleCard.astro";
import PostBody from "../../components/shared/PostBody.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, extractTitle, type MetaItem } from "../../utils/content";

export async function getStaticPaths() {
	const posts = await getCollection("post");
	return posts.map((post) => ({ params: { postId: post.id } }));
}

const { postId } = Astro.params;
const posts = await getCollection("post");
const entry = posts.find((p) => p.id === postId);

if (!entry) return Astro.redirect("/404");

const { Content, headings } = await render(entry);

// Discover co-located thumbnail via glob (supports image optimisation)
const thumbnails = import.meta.glob<{ default: ImageMetadata }>(
	"../../content/post/*/thumbnail.webp",
	{ eager: true }
);
const thumbKey = `../../content/post/${postId}/thumbnail.webp`;
const thumbnail: ImageMetadata | null = thumbnails[thumbKey]?.default ?? null;

const title = headings[0]?.text ?? postId;
const description = entry.data.description ?? "";
const tag = entry.data.tags[0] ? `#${entry.data.tags[0]}` : entry.data.categories[0] ?? "";

// Build body text for reading time (rough estimate from rendered content)
// We'll estimate from description + heading count as Astro doesn't expose raw text here
// For a more accurate count, wordCount helpers accept rendered html text — we use a simple heuristic
const meta: MetaItem[] = [
	{ label: "Date", value: formatDate(entry.data.date) },
	{ label: "Category", value: entry.data.categories[0] ?? "" },
	{ label: "Last Mod", value: formatDate(entry.data.date) }
];

// Related articles: 3 most-recent other posts in the same category
const allPosts = await getCollection("post");
const related = allPosts
	.filter(
		(p) =>
			p.id !== postId &&
			p.data.categories.some((c) => entry.data.categories.includes(c))
	)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);

// Build related article card data (needs thumbnail discovery)
const relatedCards = related.map((p) => {
	const rKey = `../../content/post/${p.id}/thumbnail.webp`;
	return {
		title: extractTitle(p.body) || p.id,
		href: `/p/${p.id}/`,
		image: thumbnails[rKey]?.default ?? null,
		tag: p.data.tags[0] ? `#${p.data.tags[0]}` : p.data.categories[0] ?? "",
		description: p.data.description ?? "",
		category: p.data.categories[0],
		date: formatDate(p.data.date)
	};
});
---

<Layout title={title} description={description} active="blog">
	<main class="article-page">
		<PostBody tag={tag} title={title} image={thumbnail} meta={meta} tldr={description} headings={headings}>
			<Content />
		</PostBody>

		<section class="about-wrap">
			<AboutCard copyright />
		</section>

		{
			relatedCards.length > 0 && (
				<section class="related-wrap">
					<h2>相關文章</h2>
					<div class="related-grid">
						{relatedCards.map((related) => (
							<ArticleCard article={related} />
						))}
						<a class="more-card card" href="/archive/">
							想要更多？
							<ArrowRight size={18} stroke-width={1.8} />
						</a>
					</div>
				</section>
			)
		}
	</main>
</Layout>

<style>
	.article-page {
		width: min(var(--site-width), 100%);
		margin-inline: auto;
		padding-top: 5.5rem;
	}

	.about-wrap,
	.related-wrap {
		width: 100%;
	}

	.about-wrap {
		display: flex;
		justify-content: center;
		margin-top: 5.75rem;
	}

	.related-wrap {
		margin-top: 5.75rem;
	}

	.related-wrap > h2 {
		margin-bottom: 1.75rem;
		font-size: 3.25rem;
		line-height: 1;
		letter-spacing: -0.07em;
		color: var(--color-ink);
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.more-card {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 15rem;
		font-weight: 700;
		color: var(--color-text);
	}

	@media (max-width: 68.75rem) {
		.related-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 40rem) {
		.article-page {
			padding-top: 3.25rem;
		}

		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
