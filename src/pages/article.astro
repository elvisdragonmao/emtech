---
import { ArrowRight } from "@lucide/astro";
import AboutCard from "../components/shared/AboutCard.astro";
import ArticleCard from "../components/shared/ArticleCard.astro";
import CommentArea from "../components/shared/CommentArea.astro";
import PostBody from "../components/shared/PostBody.astro";
import Layout from "../layouts/Layout.astro";
import { articleMeta, featuredArticles, relatedArticles } from "../data/prototype";

const article = featuredArticles[0];
---

<Layout title={article.title} description={article.description} active="blog">
	<main class="article-page">
		<PostBody tag={article.tag} title={article.title} image={article.image} meta={articleMeta} />

		<section class="about-wrap">
			<AboutCard copyright />
		</section>

		<section class="related-wrap">
			<h2>相關文章</h2>
			<div class="related-grid">
				{relatedArticles.map(related => <ArticleCard article={related} />)}
				<a class="more-card card" href="/">想要更多？<ArrowRight size={18} stroke-width={1.8} /></a>
			</div>
		</section>

		<section class="comments-wrap">
			<CommentArea />
		</section>
	</main>
</Layout>

<style>
	.article-page {
		width: min(var(--site-width), 100%);
		margin-inline: auto;
		padding-top: 5.5rem;
	}

	.about-wrap,
	.related-wrap,
	.comments-wrap {
		width: 100%;
	}

	.about-wrap {
		display: flex;
		justify-content: center;
		margin-top: 5.75rem;
	}

	.related-wrap {
		margin-top: 5.75rem;
	}

	.related-wrap > h2 {
		margin-bottom: 1.75rem;
		font-size: 3.25rem;
		line-height: 1;
		letter-spacing: -0.07em;
		color: var(--color-ink);
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.more-card {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 15rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.comments-wrap {
		margin-top: 5.75rem;
	}

	@media (max-width: 68.75rem) {
		.related-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 40rem) {
		.article-page {
			padding-top: 3.25rem;
		}

		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
