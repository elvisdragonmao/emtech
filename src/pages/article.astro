---
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import AboutCard from "../components/AboutCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CommentArea from "../components/CommentArea.astro";
import MetaTable from "../components/MetaTable.astro";
import Layout from "../layouts/Layout.astro";
import { articleMeta, featuredArticles, relatedArticles } from "../data/prototype";

const article = featuredArticles[0];
const tocItems = ["On This Page", "01 Title", "01 Title", "01 Title", "01 Title", "01 Title", "01 Title"];
---

<Layout title={article.title} description={article.description} active="blog">
	<main class="article-page">
		<section class="article-hero">
			<div></div>
			<div class="hero-main">
				<p class="tag">{article.tag}</p>
				<h1>{article.title}</h1>
				<MetaTable items={articleMeta} />
			</div>
			<aside class="hero-tldr">
				<p>TLDR</p>
				<span>HackMD 側邊欄設計教學與技巧分享。</span>
				<div class="side-nav">
					<a href="/"><ArrowLeft size={14} stroke-width={1.8} />上一篇</a>
					<a href="/course/javascript/">下一篇<ArrowRight size={14} stroke-width={1.8} /></a>
				</div>
			</aside>
		</section>

		<section class="article-shell">
			<aside class="toc" aria-label="文章目錄">
				{tocItems.map(item => <a href="#content">{item}</a>)}
			</aside>

			<article id="content" class="article-content">
				<img class="hero-image" src={article.image.src} width={article.image.width} height={article.image.height} alt={article.title} />
				<div class="callout">
					<strong>簡單來說</strong>
					<p>
						這也是為什麼我要在意「痕跡」：為什麼表單錯誤訊息要放在欄位下方？為什麼過個資料段要可以接受、另一個不行？為什麼藍色只能用在可互動元素，而不能拿來裝飾標題？這些決策如果沒有被寫下來，元件再完整，也只是一套安靜但脆弱的圖庫。
					</p>
					<span>TL;DR</span>
				</div>

				<h2>這是一個二級標題</h2>
				<p>
					很多團隊第一次建立設計系統時，會把力氣放在按鈕、輸入框、卡片與頁面範例。這些東西很重要，但它們通常不是系統失效的原因。系統真正失效的時刻，是一個新的產品情境出現，元件庫裡沒有剛好對應的選項，而團隊無法判斷該延伸、該重組，還是該拒絕需求。
				</p>

				<h3>三級標題</h3>
				<p>當一個 Prototype 只是看起來完整，卻沒有清楚的規則，就很容易在實作時分裂成不同方向。反過來，如果版面、間距、顏色與互動的意圖都被整理清楚，前端就能很快把設計翻譯成可維護的元件。</p>

				<h4>四級標題</h4>
				<p><a href="/course/">這是一個超連結</a> 什麼表單錯誤訊息要放在 <code>what frame</code> 錯誤訊息要放在欄位下方再完整，也只是一套安靜但脆弱的圖庫。</p>

				<ul>
					<li>你覺得遇到貼文有什麼問題？</li>
					<li>留言每年和人發文尊重。</li>
					<li>我才詢問。</li>
					<li>我不喜歡自己出現在文章上。</li>
				</ul>

				<figure class="code-figure">
					<div class="code-window">
						<span></span><span></span><span></span>
						<pre><code>const sidebar = document.querySelector(".summary");
sidebar?.classList.add("theme-sitcon");

const updateLayout = () =&gt; document.documentElement.style.setProperty("--rail", "18rem");</code></pre>
					</div>
					<figcaption>Fig. 02 一同一套繪圖系統可以容納獨立文章、課程文章與閱讀筆記。</figcaption>
				</figure>

				<div class="notice-box">
					<h5>六級標題</h5>
					<p>這也是為什麼我要在意「痕跡」：為什麼表單錯誤訊息要放在欄位下方？這些決策如果有被寫下來，就能讓每一個 Prototype 看起來像同一個產品。</p>
				</div>
			</article>

			<div></div>
		</section>

		<section class="about-wrap">
			<AboutCard />
		</section>

		<section class="related-wrap">
			<h2>相關文章</h2>
			<div class="related-grid">
				{relatedArticles.map(related => <ArticleCard article={related} />)}
				<a class="more-card" href="/">想要更多？<ArrowRight size={18} stroke-width={1.8} /></a>
			</div>
		</section>

		<section class="comments-wrap">
			<CommentArea />
		</section>
	</main>
</Layout>

<style>
	.article-page {
		padding-top: 88px;
	}

	.article-hero,
	.article-shell,
	.related-wrap,
	.about-wrap,
	.comments-wrap {
		width: min(var(--site-width), calc(100% - 32px));
		margin-inline: auto;
	}

	.article-hero {
		display: grid;
		grid-template-columns: 200px minmax(0, 930px) 230px;
		gap: 44px;
		align-items: start;
	}

	.hero-main {
		min-width: 0;
	}

	.hero-tldr {
		position: relative;
		margin-top: 118px;
		color: var(--color-muted);
	}

	.hero-tldr::before {
		position: absolute;
		top: -106px;
		left: -76px;
		z-index: -1;
		width: 260px;
		height: 260px;
		content: "";
		border: 1px solid color-mix(in oklch, var(--color-accent) 48%, transparent);
		border-radius: 50%;
	}

	.hero-tldr p {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-text);
	}

	.hero-tldr span {
		display: block;
		margin-top: 12px;
		font-size: 14px;
		line-height: 1.8;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	h1 {
		margin: 20px 0 32px;
		font-size: clamp(46px, 6.2vw, 76px);
		line-height: 1.02;
		letter-spacing: -0.085em;
		color: var(--color-ink);
	}

	.article-shell {
		display: grid;
		grid-template-columns: 200px minmax(0, 930px) 230px;
		gap: 44px;
		align-items: start;
		margin-top: 42px;
	}

	.toc,
	.article-side {
		position: sticky;
		top: 96px;
		padding-top: 18px;
	}

	.toc a {
		display: block;
		padding: 8px 0;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		color: var(--color-muted);
	}

	.article-side {
		color: var(--color-muted);
	}

	.article-side p {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-text);
	}

	.article-side span {
		display: block;
		margin-top: 12px;
		font-size: 14px;
		line-height: 1.8;
	}

	.side-nav {
		display: grid;
		gap: 9px;
		margin-top: 18px;
	}

	.side-nav a {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 13px;
		color: var(--color-accent-strong);
	}

	.article-content {
		font-size: 17px;
		line-height: 2;
		color: var(--color-text);
	}

	.hero-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		object-fit: cover;
		margin-bottom: 42px;
		box-shadow: var(--shadow-card);
	}

	.article-content h2,
	.article-content h3,
	.article-content h4,
	.article-content h5 {
		line-height: 1.15;
		letter-spacing: -0.06em;
		color: var(--color-ink);
	}

	.article-content h2 {
		margin: 72px 0 24px;
		font-size: clamp(34px, 5vw, 52px);
	}

	.article-content h3 {
		margin: 44px 0 16px;
		font-size: 32px;
	}

	.article-content h4 {
		margin: 34px 0 14px;
		font-size: 25px;
	}

	.article-content h5 {
		font-size: 20px;
	}

	.article-content p + p,
	.article-content p + ul {
		margin-top: 18px;
	}

	.article-content a {
		color: var(--color-accent-strong);
		border-bottom: 1px solid currentColor;
	}

	.article-content code {
		padding: 3px 7px;
		font-family: var(--font-mono);
		font-size: 0.86em;
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
	}

	.article-content ul {
		padding-left: 1.2em;
	}

	.callout {
		position: relative;
		padding: 34px 42px;
		overflow: hidden;
		background: color-mix(in oklch, var(--color-accent-soft) 62%, var(--color-surface));
		border: 1px solid var(--color-accent);
	}

	.callout strong {
		display: block;
		margin-bottom: 18px;
		font-size: 18px;
		color: var(--color-ink);
	}

	.callout p {
		position: relative;
		z-index: 1;
		max-width: 620px;
	}

	.callout span {
		position: absolute;
		right: 22px;
		bottom: -12px;
		font-size: 76px;
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.08em;
		color: color-mix(in oklch, var(--color-accent) 42%, transparent);
	}

	.code-figure {
		margin: 52px 0;
	}

	.code-window {
		position: relative;
		padding: 48px 24px 24px;
		background: var(--color-code-bg);
		border: 1px solid color-mix(in oklch, var(--color-code-bg) 65%, var(--color-border));
		box-shadow: var(--shadow-card);
	}

	.code-window > span {
		position: absolute;
		top: 18px;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	.code-window > span:nth-child(1) {
		left: 18px;
	}

	.code-window > span:nth-child(2) {
		left: 34px;
	}

	.code-window > span:nth-child(3) {
		left: 50px;
	}

	pre {
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.8;
		color: var(--color-code-ink);
	}

	figcaption {
		margin-top: 12px;
		font-size: 13px;
		text-align: center;
		color: var(--color-muted);
	}

	.notice-box {
		margin-top: 48px;
		padding: 30px 34px;
		background: color-mix(in oklch, var(--color-paper) 65%, var(--color-surface));
		border: 1px solid var(--color-yellow);
	}

	.notice-box p {
		margin-top: 14px;
	}

	.about-wrap {
		display: flex;
		justify-content: center;
		margin-top: 92px;
	}

	.related-wrap {
		margin-top: 92px;
	}

	.related-wrap > h2 {
		margin-bottom: 26px;
		font-size: clamp(34px, 5vw, 50px);
		line-height: 1;
		letter-spacing: -0.07em;
		color: var(--color-ink);
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 18px;
	}

	.more-card {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 240px;
		font-weight: 700;
		color: var(--color-text);
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
		border: 1px solid var(--color-border);
	}

	.comments-wrap {
		margin-top: 92px;
	}

	@media (max-width: 1100px) {
		.article-hero,
		.article-shell {
			grid-template-columns: minmax(0, 1fr);
			max-width: 820px;
		}

		.toc,
		.article-side,
		.hero-tldr,
		.article-hero > div:first-child {
			display: none;
		}

		.related-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.article-page {
			padding-top: 52px;
		}

		.callout,
		.notice-box {
			padding: 24px;
		}

		.callout span {
			font-size: 52px;
		}

		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
