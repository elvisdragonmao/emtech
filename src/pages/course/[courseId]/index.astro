---
import { BookOpen, Clock, Users } from "@lucide/astro";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import CourseModuleRow from "../../../components/course/CourseModuleRow.astro";
import Layout from "../../../layouts/Layout.astro";
import { extractExcerpt, extractTitle, formatDate, readingTime } from "../../../utils/content";

export async function getStaticPaths() {
	const courses = await getCollection("course");
	return courses.map(course => ({ params: { courseId: course.id } }));
}

const { courseId } = Astro.params;
const courses = await getCollection("course");
const courseEntry = courses.find(c => c.id === courseId);

if (!courseEntry) return Astro.redirect("/404");

const allLessons = (await getCollection("lesson")).filter(lesson => !lesson.data.draft);
const lessons = allLessons
	.filter(l => l.id.startsWith(`${courseId}/`))
	.sort((a, b) => {
		const order = courseEntry.data.order;
		const aId = a.id.replace(`${courseId}/`, "");
		const bId = b.id.replace(`${courseId}/`, "");
		return order.indexOf(aId) - order.indexOf(bId);
	});

// Discover thumbnails for lessons
const allThumbs = import.meta.glob<{ default: ImageMetadata }>("../../../content/course/*/*/thumbnail.webp", { eager: true });

// Course-level thumbnail
const courseThumbKey = `../../../content/course/${courseId}/${courseEntry.data.thumbnail}`;
const courseThumbnail: ImageMetadata | null = allThumbs[courseThumbKey]?.default ?? null;

// Most-recent lesson update date
const latestDate = lessons.reduce((acc, l) => {
	return l.data.date > acc ? l.data.date : acc;
}, new Date(0));

const totalModules = lessons.length;

const courseData = courseEntry.data;
const outcomes = courseData.outcomes ?? [];
---

<Layout title={courseData.title} description={courseData.description} active="course">
	<main class="course-page">
		<section class="course-hero">
			<div class="hero-copy">
				<p class="eyebrow">Course</p>
				<h1>{courseData.title}</h1>
				<p class="lead">{courseData.description}</p>
				{
					outcomes.length > 0 && (
						<div class="outcomes">
							{outcomes.map((item, i) => (
								<article>
									<span>Outcome {String(i + 1).padStart(2, "0")}</span>
									<h2>{item.title}</h2>
									<p>{item.text}</p>
								</article>
							))}
						</div>
					)
				}
			</div>
			<article class="overview-card">
				<span>Course overview</span>
				<h2>{totalModules} 單元</h2>
				<p>Target audience: {courseData.meta ?? "所有學習者"}</p>
				<div class="progress">
					<strong>Reading path</strong>
					<i></i>
				</div>
				{courseThumbnail && <img class="overview-thumb" src={courseThumbnail.src} width={courseThumbnail.width} height={courseThumbnail.height} alt={courseData.title} />}
				<div class="quick-stats">
					<div><BookOpen size={18} stroke-width={1.8} /><span>{totalModules} 章節</span></div>
					<div>
						<Clock size={18} stroke-width={1.8} />
						<span>最後更新 {formatDate(latestDate)}</span>
					</div>
					<div><Users size={18} stroke-width={1.8} /><span>適合<br>所有學習者</span></div>
				</div>
			</article>
		</section>

		<section class="curriculum">
				{
					lessons.map((lesson, i) => {
						const lessonId = lesson.id.replace(`${courseId}/`, "");
						const thumbKey = `../../../content/course/${courseId}/${lessonId}/thumbnail.webp`;
						const thumb = allThumbs[thumbKey]?.default ?? null;
						return (
							<CourseModuleRow
								module={{
									number: `Module ${String(i + 1).padStart(2, "0")}`,
									title: extractTitle(lesson.body) || lesson.data.description || lessonId,
									description: lesson.data.description ?? extractExcerpt(lesson.body),
									duration: readingTime(lesson.body ?? lesson.data.description ?? ""),
									image: thumb,
									href: `/course/${courseId}/${lessonId}/`
								}}
							/>
						);
					})
				}
		</section>
	</main>
</Layout>

<style>
	.course-page {
		padding-top: 5.5rem;
	}

	.course-hero,
	.curriculum {
		width: min(var(--site-width), calc(100% - 2rem));
		margin-inline: auto;
	}

	.course-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 24.5rem;
		gap: 2rem;
		align-items: flex-end;
		padding-bottom: 2rem;
	}

	.hero-copy {
		padding-top: 0.75rem;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h1 {
		max-width: 61.25rem;
		margin-top: 1.5rem;
		font-size: 6.5rem;
		line-height: 0.95;
		letter-spacing: -0.09em;
		color: var(--color-ink);
	}

	.lead {
		max-width: 57.5rem;
		margin-top: 2rem;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.5;
		color: var(--color-text);
	}

	.overview-card {
		position: relative;
		padding: 2.25rem;
		margin-top: 2rem;
		background: oklch(100% 0 0 / 88%);
		border: 1px solid var(--color-border);
	}

	.overview-card::after {
		position: absolute;
		right: -5.5rem;
		bottom: -4rem;
		z-index: -1;
		width: 13.75rem;
		height: 13.75rem;
		content: "";
		border: 1px solid oklch(71% 0.15 225 / 48%);
		border-radius: 50%;
	}

	.overview-card > span {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--color-accent-strong);
	}

	.overview-card h2 {
		margin-top: 1.25rem;
		font-size: 3rem;
		line-height: 1;
		letter-spacing: -0.07em;
		color: var(--color-ink);
	}

	.overview-card p {
		margin-top: 1.5rem;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.progress {
		margin-top: 2.75rem;
	}

	.progress strong {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.progress i {
		display: block;
		width: 100%;
		height: 0.5rem;
		margin-top: 1rem;
		background: var(--color-border);
	}

	.overview-thumb {
		width: 100%;
		aspect-ratio: 2 / 1;
		height: auto;
		margin-top: 1.75rem;
		object-fit: cover;
		background: var(--color-paper);
	}

	.quick-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.quick-stats div {
		display: grid;
		place-items: center;
		text-align: center;
		gap: 0.5rem;
		padding: 1rem 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--color-muted);
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
	}

	.quick-stats svg {
		color: var(--color-accent-strong);
	}

	.outcomes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 3.75rem;
		background: color-mix(in oklch, var(--color-surface) 58%, transparent);
		border: 1px solid var(--color-border);
	}

	.outcomes article {
		padding: 2rem;
		border-right: 1px solid var(--color-border);
	}

	.outcomes article:last-child {
		border-right: none;
	}

	.outcomes span {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.outcomes h2 {
		margin-top: 1.25rem;
		font-size: 1.25rem;
		line-height: 1.35;
		color: var(--color-ink);
	}

	.outcomes p {
		margin-top: 0.75rem;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.curriculum {
		background: color-mix(in oklch, var(--color-surface) 58%, transparent);
		border: 1px solid var(--color-border);
		border-left: 0;
		border-top-color: var(--color-ink);
	}

	@media (max-width: 57.5rem) {
		.course-hero {
			grid-template-columns: 1fr;
		}

		.outcomes {
			grid-template-columns: 1fr;
		}

		.outcomes article {
			border-right: none;
			border-bottom: 1px solid var(--color-border);
		}

		.outcomes article:last-child {
			border-bottom: none;
		}

		.overview-card {
			margin-top: 1.25rem;
		}
	}

	@media (max-width: 38.75rem) {
		.course-page {
			padding-top: 3.25rem;
		}

		.quick-stats {
			grid-template-columns: 1fr;
		}

		.overview-card {
			padding: 1.5rem;
		}
	}
</style>
