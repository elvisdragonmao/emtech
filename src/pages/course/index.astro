---
import { BookOpen, Clock, Users } from "@lucide/astro";
import CourseModuleRow from "../../components/course/CourseModuleRow.astro";
import CommentArea from "../../components/shared/CommentArea.astro";
import Layout from "../../layouts/Layout.astro";
import { courseModules, courses } from "../../data/prototype";

const course = courses[0];
const outcomes = [
	{ label: "Outcome 01", title: "讀懂 HTML 語意結構", text: "能把內容建立穩定骨架，讓瀏覽器和人都知道這份文件在說什麼。" },
	{ label: "Outcome 02", title: "用 CSS Grid / Flex 做出可維護的出版版面", text: "從間距、對齊、響應式到可讀性，建立系統化排版直覺。" },
	{ label: "Outcome 03", title: "理解 JavaScript 互動、狀態與可及性", text: "知道什麼時候需要 JS，並讓互動不只是會動而是好用。" }
];
---

<Layout title="前端網頁開發入門" description={course.description} active="course">
	<main class="course-page">
		<section class="course-hero">
			<div class="hero-copy">
				<p class="eyebrow">Coding</p>
				<h1>前端網頁開發入門</h1>
				<p class="lead">給想從零建立完整前端心智模型的學習者。不是只背語法，而是理解文件結構、排版系統、互動狀態與部署流程如何連在一起。</p>
				<div class="outcomes">
					{
						outcomes.map(item => (
							<article>
								<>
									<span>{item.label}</span>
									<h2>{item.title}</h2>
									<p>{item.text}</p>
								</>
							</article>
						))
					}
				</div>
			</div>
			<article class="overview-card">
				<span>Course overview</span>
				<h2>10 單元 / 6.5 小時</h2>
				<p>Target audience: 初學者、轉職工程師、需要補齊前端基礎的設計師。</p>
				<div class="progress">
					<strong>Reading path progress: 42%</strong>
					<i></i>
				</div>
				<img class="overview-thumb" src={course.image.src} width={course.image.width} height={course.image.height} alt={course.title} />
				<div class="quick-stats">
					<div><BookOpen size={18} stroke-width={1.8} /><span>10 modules</span></div>
					<div><Clock size={18} stroke-width={1.8} /><span>6.5 hours</span></div>
					<div><Users size={18} stroke-width={1.8} /><span>Beginner</span></div>
				</div>
			</article>
		</section>

		<section class="curriculum">
			<div class="module-list">
				{courseModules.map(module => <CourseModuleRow module={module} />)}
			</div>
		</section>

		<section class="comments-wrap">
			<CommentArea />
		</section>
	</main>
</Layout>

<style>
	.course-page {
		padding-top: 5.5rem;
	}

	.course-hero,
	.curriculum,
	.comments-wrap {
		width: min(var(--site-width), calc(100% - 2rem));
		margin-inline: auto;
	}

	.course-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 24.5rem;
		gap: 2rem;
		align-items: start;
		padding-bottom: 2rem;
	}

	.hero-copy {
		padding-top: 0.75rem;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h1 {
		max-width: 61.25rem;
		margin-top: 1.5rem;
		font-size: 6.5rem;
		line-height: 0.95;
		letter-spacing: -0.09em;
		color: var(--color-ink);
	}

	.lead {
		max-width: 57.5rem;
		margin-top: 2rem;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.5;
		color: var(--color-text);
	}

	.overview-card {
		background: oklch(100% 0 0 / 88%);
		border: 1px solid var(--color-border);
	}

	.overview-card {
		position: relative;
		padding: 2.25rem;
		margin-top: 2rem;
	}

	.overview-card::after {
		position: absolute;
		right: -5.5rem;
		bottom: -4rem;
		z-index: -1;
		width: 13.75rem;
		height: 13.75rem;
		content: "";
		border: 1px solid oklch(71% 0.15 225 / 48%);
		border-radius: 50%;
	}

	.overview-card > span {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--color-accent-strong);
	}

	.overview-card h2 {
		margin-top: 1.25rem;
		font-size: 3rem;
		line-height: 1;
		letter-spacing: -0.07em;
		color: var(--color-ink);
	}

	.overview-card p {
		margin-top: 1.5rem;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.progress {
		margin-top: 2.75rem;
	}

	.progress strong {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.progress i {
		display: block;
		width: 100%;
		height: 0.5rem;
		margin-top: 1rem;
		background: var(--color-border);
	}

	.progress i::before {
		display: block;
		width: 42%;
		height: 100%;
		content: "";
		background: var(--color-accent);
	}

	.overview-thumb {
		width: 100%;
		aspect-ratio: 2 / 1;
		height: auto;
		margin-top: 1.75rem;
		object-fit: cover;
		background: var(--color-paper);
	}

	.quick-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.quick-stats div {
		display: grid;
		place-items: center;
		gap: 0.5rem;
		padding: 1rem 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--color-muted);
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
	}

	.quick-stats svg {
		color: var(--color-accent-strong);
	}

	.outcomes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 3.75rem;
		background: color-mix(in oklch, var(--color-surface) 58%, transparent);
		border: 1px solid var(--color-border);
	}

	.outcomes article {
		padding: 2rem;
		border-right: 1px solid var(--color-border);
	}

	.outcomes article:last-child {
		border-right: none;
	}

	.outcomes span {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.outcomes h2 {
		margin-top: 1.25rem;
		font-size: 1.25rem;
		line-height: 1.35;
		color: var(--color-ink);
	}

	.outcomes p {
		margin-top: 0.75rem;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.curriculum {
		background: color-mix(in oklch, var(--color-surface) 58%, transparent);
		border: 1px solid var(--color-border);
		border-top-color: var(--color-ink);
	}

	.comments-wrap {
		margin-top: 5.75rem;
	}

	@media (max-width: 57.5rem) {
		.course-hero {
			grid-template-columns: 1fr;
		}

		.outcomes {
			grid-template-columns: 1fr;
		}

		.outcomes article {
			border-right: none;
			border-bottom: 1px solid var(--color-border);
		}

		.outcomes article:last-child {
			border-bottom: none;
		}

		.overview-card {
			margin-top: 1.25rem;
		}
	}

	@media (max-width: 38.75rem) {
		.course-page {
			padding-top: 3.25rem;
		}

		.quick-stats {
			grid-template-columns: 1fr;
		}

		.overview-card {
			padding: 1.5rem;
		}
	}
</style>
