---
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import AboutCard from "../../components/shared/AboutCard.astro";
import CommentArea from "../../components/shared/CommentArea.astro";
import PostBody from "../../components/shared/PostBody.astro";
import Layout from "../../layouts/Layout.astro";
import { courseModules } from "../../data/prototype";

const lesson = courseModules[3];
const meta = [
	{ label: "Date", value: "2026.05.09" },
	{ label: "Category", value: "軟體開發" },
	{ label: "Read", value: "42 min" },
	{ label: "Word", value: "8.6k" },
	{ label: "Last Mod", value: "2026.05.09" }
];
---

<Layout title={lesson.title} description={lesson.description} active="course">
	<main class="lesson-page">
		<PostBody tag="#JavaScript" title={lesson.title} image={lesson.image} meta={meta} tldr={lesson.description} previousHref="/course/" nextHref="/course/" />

		<nav class="lesson-nav" aria-label="課程上下篇">
			<a href="/course/"><span>Previous</span><strong>CSS 基礎</strong><ArrowLeft size={16} stroke-width={1.8} /></a>
			<a class="current" href="/course/javascript/"><span>Current Course</span><strong>前端網頁開發入門</strong></a>
			<a href="/course/"><span>Next</span><strong>非同步的非同步</strong><ArrowRight size={16} stroke-width={1.8} /></a>
		</nav>

		<section class="about-wrap">
			<AboutCard copyright />
		</section>

		<section class="comments-wrap">
			<CommentArea />
		</section>
	</main>
</Layout>

<style>
	.lesson-page {
		width: min(var(--site-width), 100%);
		margin-inline: auto;
		padding-top: 5.5rem;
	}

	.about-wrap,
	.comments-wrap {
		width: 100%;
	}

	.about-wrap {
		display: flex;
		justify-content: center;
		margin-top: 5.75rem;
	}

	.lesson-nav {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		width: min(58.25rem, 100%);
		margin: 5.75rem auto 0;
		border: 1px solid var(--color-border);
	}

	.lesson-nav a {
		position: relative;
		display: grid;
		min-height: 7rem;
		padding: 1.5rem;
		color: var(--color-text);
		background: oklch(100% 0 0 / 84%);
		border-left: 1px solid var(--color-border);
	}

	.lesson-nav a:first-child {
		border-left: 0;
	}

	.lesson-nav span {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.lesson-nav strong {
		align-self: end;
		font-size: 1.25rem;
		line-height: 1.25;
		letter-spacing: -0.04em;
		color: var(--color-ink);
	}

	.lesson-nav svg {
		position: absolute;
		right: 1.25rem;
		bottom: 1.5rem;
		color: var(--color-accent-strong);
	}

	.lesson-nav .current {
		border-top: 3px solid var(--color-accent);
	}

	.comments-wrap {
		margin-top: 5.75rem;
	}

	@media (max-width: 40rem) {
		.lesson-page {
			padding-top: 3.25rem;
		}

		.lesson-nav {
			grid-template-columns: 1fr;
		}

		.lesson-nav a,
		.lesson-nav a:first-child {
			border-top: 1px solid var(--color-border);
			border-left: 0;
		}

		.lesson-nav a:first-child {
			border-top: 0;
		}
	}
</style>
