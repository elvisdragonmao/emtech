---
import { ArrowRight, ChevronDown } from "@lucide/astro";
import AboutCard from "../components/AboutCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CommentArea from "../components/CommentArea.astro";
import CourseCard from "../components/CourseCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Layout from "../layouts/Layout.astro";
import { archiveArticles, courses, featuredArticles, stats } from "../data/prototype";

const categories = ["精選文章", "軟體開發", "生活", "程式教學", "生活駭客"];
const tags = [
	"標籤",
	"三個字",
	"標籤",
	"標籤",
	"標籤",
	"三個字",
	"標籤",
	"標籤",
	"標籤",
	"三個字",
	"標籤",
	"標籤",
	"三個字",
	"標籤",
	"三個字",
	"三個字",
	"四個字",
	"三個字",
	"三個字",
	"三個字",
	"三個字",
	"三個字",
	"三個字"
];
const specialPages = [
	{ title: "交個朋友", description: "打開我的電子報" },
	{ title: "友情連結", description: "我的好朋友們" },
	{ title: "關於本站", description: "伴隨我們開始？" },
	{ title: "RSS", description: "從海量內容中控管" }
];
---

<Layout active="home">
	<main>
		<section class="hero">
			<div class="hero-copy">
				<p class="eyebrow">EMTECH.CC / ELVIS DRAGON MAO</p>
				<h1>毛哥EM<br />資訊密技</h1>
				<p class="hero-subtitle">科技、設計、毛茸茸</p>
				<div class="stats-panel" aria-label="網站統計">
					{
						stats.map(stat => (
							<div>
								<span>{stat.label}</span>
								<strong>{stat.value}</strong>
							</div>
						))
					}
				</div>
			</div>

			<div class="hero-gallery" aria-label="精選內容">
				<img class="dragon" src="/img/dragon.webp" alt="毛哥EM 角色插圖" />
				<div class="circle circle-one"></div>
				<div class="circle circle-two"></div>
				{
					featuredArticles.map((article, index) => (
						<a class:list={["feature-note", `note-${index + 1}`]} href={article.href}>
							<img src={article.image.src} width={article.image.width} height={article.image.height} alt={article.title} />
							<div>
								<span>{article.category}</span>
								<strong>{article.title}</strong>
								<small>{article.description}</small>
							</div>
						</a>
					))
				}
			</div>
		</section>

		<section id="archive" class="section-block">
			<SectionTitle eyebrow="Archive / Content Index" title="單篇文章分類" sideLabel="Specialists" />
			<div class="archive-layout">
				<div class="archive-main">
					<div class="category-tabs" aria-label="文章分類">
						{categories.map(category => <button type="button">{category}</button>)}
					</div>
					<div class="article-grid">
						{archiveArticles.map(article => <ArticleCard article={article} />)}
					</div>
				</div>
				<aside class="archive-side">
					<article class="discord-card">
						<span>Discord</span>
						<h3>遇到問題嗎？</h3>
						<p>歡迎加入 Discord 與我們一起討論喔！</p>
					</article>
					<div class="tag-cloud" aria-label="標籤雲">
						{tags.map(tag => <a href="/article/">{tag}</a>)}
					</div>
				</aside>
			</div>
			<a class="more-link" href="/article/">
				想要更多？
				<ChevronDown size={18} stroke-width={1.8} />
			</a>
		</section>

		<section class="section-block courses-preview">
			<SectionTitle eyebrow="Course" title="一筆像廢文，系列看起來就挺有道理。" description="鎖入套系列文章與詳細的程式開發與設計教學。" />
			<div class="course-grid">
				{courses.map(course => <CourseCard course={course} />)}
			</div>
		</section>

		<section class="section-block special-pages">
			<SectionTitle eyebrow="Special Pages" title="疑，這是什麼？" />
			<div class="special-grid">
				{
					specialPages.map(page => (
						<a href="/article/">
							<h3>{page.title}</h3>
							<p>{page.description}</p>
							<ArrowRight size={17} stroke-width={1.8} />
						</a>
					))
				}
			</div>
		</section>

		<section class="about-section">
			<AboutCard />
		</section>

		<section class="comments-section">
			<CommentArea />
		</section>
	</main>
</Layout>

<style>
	main {
		padding-bottom: 24px;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1.08fr);
		align-items: center;
		width: min(var(--site-width), calc(100% - 32px));
		min-height: 720px;
		margin: 0 auto;
		padding: 78px 0 48px;
	}

	.hero::before {
		position: absolute;
		top: 152px;
		left: 0;
		width: min(520px, 46vw);
		height: 1px;
		content: "";
		background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
		transform: rotate(-8deg);
		transform-origin: left center;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.09em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h1 {
		margin-top: 24px;
		font-size: clamp(72px, 12vw, 166px);
		line-height: 0.9;
		letter-spacing: -0.12em;
		color: var(--color-ink);
	}

	.hero-subtitle {
		margin-top: 24px;
		font-size: clamp(18px, 2.3vw, 28px);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--color-text);
	}

	.stats-panel {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		max-width: 560px;
		margin-top: 116px;
		border: 1px solid var(--color-border);
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
	}

	.stats-panel div {
		padding: 18px 20px;
		border-left: 1px solid var(--color-border);
	}

	.stats-panel div:first-child {
		border-left: 0;
	}

	.stats-panel span {
		display: block;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.stats-panel strong {
		display: block;
		margin-top: 8px;
		font-size: 26px;
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--color-ink);
	}

	.hero-gallery {
		position: relative;
		min-height: 560px;
	}

	.dragon {
		position: absolute;
		top: 34px;
		right: 38px;
		z-index: 2;
		width: min(330px, 38vw);
		filter: drop-shadow(0 30px 36px color-mix(in oklch, var(--color-accent) 20%, transparent));
	}

	.circle {
		position: absolute;
		border: 1px solid color-mix(in oklch, var(--color-accent) 48%, transparent);
		border-radius: 999px;
	}

	.circle-one {
		right: 40px;
		bottom: 72px;
		width: 236px;
		height: 236px;
	}

	.circle-two {
		bottom: 146px;
		left: 30px;
		width: 220px;
		height: 220px;
	}

	.feature-note {
		position: absolute;
		z-index: 3;
		display: grid;
		grid-template-columns: 170px 1fr;
		gap: 18px;
		width: min(440px, 92vw);
		padding: 14px;
		background: color-mix(in oklch, var(--color-surface) 88%, transparent);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-card);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.feature-note:hover {
		transform: translateY(-4px);
		border-color: var(--color-accent);
	}

	.note-1 {
		right: 22px;
		bottom: 118px;
	}

	.note-2 {
		right: 6px;
		bottom: -14px;
	}

	.feature-note img {
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		object-fit: cover;
	}

	.feature-note span,
	.feature-note small {
		display: block;
		font-size: 12px;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.feature-note span {
		font-family: var(--font-mono);
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	.feature-note strong {
		display: block;
		margin: 6px 0;
		font-size: 17px;
		line-height: 1.25;
		letter-spacing: -0.04em;
		color: var(--color-ink);
	}

	.section-block {
		margin-top: 120px;
	}

	.category-tabs,
	.archive-layout,
	.course-grid,
	.special-grid,
	.about-section,
	.comments-section {
		width: min(var(--site-width), calc(100% - 32px));
		margin-inline: auto;
	}

	.category-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
		margin-bottom: 26px;
	}

	.category-tabs button {
		padding: 8px 14px;
		font-size: 13px;
		font-weight: 700;
		color: var(--color-text);
		background: color-mix(in oklch, var(--color-surface) 84%, transparent);
		border: 1px solid var(--color-border);
	}

	.category-tabs button:first-child {
		color: var(--color-accent-strong);
		border-color: var(--color-accent);
	}

	.archive-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 310px;
		gap: 28px;
		align-items: start;
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.archive-side {
		display: grid;
		gap: 28px;
		padding-top: 58px;
	}

	.discord-card,
	.tag-cloud {
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
		border: 1px solid var(--color-border);
	}

	.discord-card {
		min-height: 150px;
		padding: 28px 30px;
	}

	.discord-card span {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	.discord-card h3 {
		margin-top: 26px;
		font-size: 22px;
		line-height: 1;
		letter-spacing: -0.05em;
		color: var(--color-ink);
	}

	.discord-card p {
		margin-top: 12px;
		font-size: 13px;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		padding: 26px;
	}

	.tag-cloud a {
		padding: 7px 12px;
		font-size: 12px;
		font-weight: 700;
		color: var(--color-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.more-link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: min(var(--site-width), calc(100% - 32px));
		min-height: 74px;
		margin: 28px auto 0;
		font-weight: 700;
		color: var(--color-text);
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
		border: 1px solid var(--color-border);
	}

	.course-grid {
		display: grid;
		grid-template-columns: 1.18fr 0.91fr 0.91fr;
		gap: 18px;
	}

	.course-grid :global(.course-card:first-child) {
		grid-row: span 2;
	}

	.course-grid :global(.course-card:first-child .visual) {
		aspect-ratio: 16 / 9;
	}

	.special-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border: 1px solid var(--color-border);
	}

	.special-grid a {
		position: relative;
		min-height: 136px;
		padding: 28px;
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
		border-left: 1px solid var(--color-border);
	}

	.special-grid a:first-child {
		border-left: 0;
	}

	.special-grid h3 {
		font-size: 28px;
		line-height: 1;
		letter-spacing: -0.055em;
		color: var(--color-ink);
	}

	.special-grid p {
		margin-top: 12px;
		font-size: 14px;
		color: var(--color-muted);
	}

	.special-grid svg {
		position: absolute;
		right: 24px;
		bottom: 24px;
		color: var(--color-accent-strong);
	}

	.about-section {
		display: flex;
		justify-content: center;
		margin-top: 100px;
	}

	.comments-section {
		margin-top: 100px;
	}

	@media (max-width: 980px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.hero-gallery {
			min-height: 500px;
			margin-top: 36px;
		}

		.stats-panel {
			margin-top: 52px;
		}

		.archive-layout,
		.course-grid {
			grid-template-columns: 1fr;
		}

		.article-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.archive-side {
			grid-template-columns: 1fr 1fr;
			padding-top: 0;
		}

		.course-grid :global(.course-card:first-child) {
			grid-row: auto;
		}

		.special-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.special-grid a:nth-child(odd) {
			border-left: 0;
		}

		.special-grid a:nth-child(n + 3) {
			border-top: 1px solid var(--color-border);
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 52px;
		}

		.stats-panel,
		.article-grid,
		.archive-side,
		.course-grid,
		.special-grid {
			grid-template-columns: 1fr;
		}

		.stats-panel div,
		.special-grid a {
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.stats-panel div:first-child,
		.special-grid a:first-child {
			border-top: 0;
		}

		.hero-gallery {
			min-height: 560px;
		}

		.dragon {
			right: 0;
			width: 260px;
		}

		.feature-note {
			grid-template-columns: 1fr;
			right: auto;
			left: 0;
			width: 100%;
		}

		.note-1 {
			bottom: 154px;
		}

		.note-2 {
			bottom: 0;
		}

		.section-block {
			margin-top: 84px;
		}
	}
</style>
