---
import { ArrowRight, ChevronDown } from "@lucide/astro";
import AboutCard from "../components/AboutCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CommentArea from "../components/CommentArea.astro";
import CourseCard from "../components/CourseCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Layout from "../layouts/Layout.astro";
import { archiveArticles, courses, featuredArticles, stats } from "../data/prototype";

const categories = ["精選文章", "軟體開發", "生活", "程式教學", "生活駭客"];
const tags = [
	"標籤",
	"三個字",
	"標籤",
	"標籤",
	"標籤",
	"三個字",
	"標籤",
	"標籤",
	"標籤",
	"三個字",
	"標籤",
	"標籤",
	"三個字",
	"標籤",
	"三個字",
	"三個字",
	"四個字",
	"三個字",
	"三個字",
	"三個字",
	"三個字",
	"三個字",
	"三個字"
];
const specialPages = [
	{ title: "交個朋友", description: "打開我的電子報" },
	{ title: "友情連結", description: "我的好朋友們" },
	{ title: "關於本站", description: "伴隨我們開始？" },
	{ title: "RSS", description: "從海量內容中控管" }
];
---

<Layout active="home">
	<main>
		<div class="home-container">
			<section class="hero">
				<div class="hero-copy">
					<div class="hero-heading">
						<p class="eyebrow">EMTECH.CC / ELVIS DRAGON MAO</p>
						<h1>毛哥EM<br />資訊密技</h1>
						<p class="hero-subtitle">科技、設計、毛茸茸</p>
					</div>
					<div class="stats-panel" aria-label="網站統計">
						{
							stats.map(stat => (
								<div>
									<span>{stat.label}</span>
									<strong>{stat.value}</strong>
								</div>
							))
						}
					</div>
				</div>

				<div class="hero-gallery" aria-label="精選內容">
					<img class="dragon" src="/img/dragon.webp" alt="毛哥EM 角色插圖" />
					<div class="circle circle-one"></div>
					<div class="circle circle-two"></div>
					{
						featuredArticles.map((article, index) => (
							<a class:list={["feature-note", `note-${index + 1}`]} href={article.href}>
								<img src={article.image.src} width={article.image.width} height={article.image.height} alt={article.title} />
								<div>
									<span>{article.category}</span>
									<strong>{article.title}</strong>
									<small>{article.description}</small>
								</div>
							</a>
						))
					}
				</div>
			</section>

			<section id="archive" class="section-block">
				<SectionTitle eyebrow="Archive / Content Index" title="單篇文章分類" sideLabel="Specialists" />
				<div class="archive-layout">
					<div class="archive-main">
						<div class="category-tabs" aria-label="文章分類">
							{categories.map(category => <button type="button">{category}</button>)}
						</div>
						<div class="article-grid">
							{archiveArticles.map(article => <ArticleCard article={article} />)}
						</div>
					</div>
					<aside class="archive-side">
						<article class="discord-card">
							<span>Discord</span>
							<h3>遇到問題嗎？</h3>
							<p>歡迎加入 Discord 與我們一起討論喔！</p>
						</article>
						<div class="tag-cloud" aria-label="標籤雲">
							{tags.map(tag => <a href="/article/">{tag}</a>)}
						</div>
					</aside>
				</div>
				<a class="more-link" href="/article/">
					想要更多？
					<ChevronDown size={18} stroke-width={1.8} />
				</a>
			</section>

			<section class="section-block courses-preview">
				<SectionTitle eyebrow="Course" title="一筆像廢文，系列看起來就挺有道理。" description="鎖入套系列文章與詳細的程式開發與設計教學。" />
				<div class="course-grid">
					{courses.map(course => <CourseCard course={course} />)}
				</div>
			</section>

			<section class="section-block special-pages">
				<SectionTitle eyebrow="Special Pages" title="疑，這是什麼？" />
				<div class="special-grid">
					{
						specialPages.map(page => (
							<a href="/article/">
								<h3>{page.title}</h3>
								<p>{page.description}</p>
								<ArrowRight size={17} stroke-width={1.8} />
							</a>
						))
					}
				</div>
			</section>

			<section class="about-section">
				<AboutCard />
			</section>

			<section class="comments-section">
				<CommentArea />
			</section>
		</div>
	</main>
</Layout>

<style>
	main {
		padding-bottom: 1.5rem;
	}

	.home-container {
		display: flex;
		flex-direction: column;
		gap: 7.5rem;
		width: 100%;
		max-width: calc(var(--site-width) + 4rem);
		margin-inline: auto;
		padding-inline: 2rem;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(22.5rem, 1.08fr);
		gap: 4rem;
		align-items: flex-end;
		min-height: min(calc(100svh - 4.25rem), 70rem);
		padding: 2rem 0 10rem;
	}

	.hero::before {
		position: absolute;
		top: 9.5rem;
		left: 0;
		width: min(32.5rem, 46vw);
		content: "";
		border-top: 1px solid var(--color-accent);
		transform: rotate(-8deg);
		transform-origin: left center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 6rem;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h1 {
		margin-top: 1.5rem;
		font-size: 8rem;
		line-height: 1;
		letter-spacing: -0.05em;
		color: var(--color-ink);
	}

	.hero-subtitle {
		margin-top: 1.5rem;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--color-text);
	}

	.stats-panel {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		max-width: 35rem;
		border: 1px solid var(--color-border);
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
	}

	.stats-panel div {
		padding: 1.25rem 1.25rem;
		border-left: 1px solid var(--color-border);
	}

	.stats-panel div:first-child {
		border-left: 0;
	}

	.stats-panel span {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.stats-panel strong {
		display: block;
		margin-top: 0.5rem;
		font-size: 1.75rem;
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--color-ink);
	}

	.hero-gallery {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.dragon {
		z-index: 2;
		width: 40rem;
		height: auto;
		filter: drop-shadow(0 2rem 2.25rem color-mix(in oklch, var(--color-accent) 20%, transparent));
		transform: translateX(9rem) rotate(-4deg);
	}

	.circle {
		position: absolute;
		border: 1px solid color-mix(in oklch, var(--color-accent) 48%, transparent);
		border-radius: 62.5rem;
	}

	.circle-one {
		right: 2.5rem;
		bottom: 4.5rem;
		width: 14.75rem;
		height: 14.75rem;
	}

	.circle-two {
		bottom: 9.25rem;
		left: 2rem;
		width: 13.75rem;
		height: 13.75rem;
	}

	.feature-note {
		z-index: 3;
		display: grid;
		grid-template-columns: 10.75rem 1fr;
		gap: 1.25rem;
		width: min(30rem, 100%);
		padding: 1rem;
		background: color-mix(in oklch, var(--color-surface) 88%, transparent);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-card);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.feature-note:hover {
		transform: translateY(-0.25rem);
		border-color: var(--color-accent);
	}

	.feature-note img {
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		object-fit: cover;
	}

	.feature-note span,
	.feature-note small {
		display: block;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.feature-note span {
		font-family: var(--font-mono);
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	.feature-note strong {
		display: block;
		margin: 0.5rem 0;
		font-size: 1rem;
		line-height: 1.25;
		letter-spacing: -0.04em;
		color: var(--color-ink);
	}

	.section-block {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.category-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}

	.category-tabs button {
		padding: 0.5rem 1rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-text);
		background: color-mix(in oklch, var(--color-surface) 84%, transparent);
		border: 1px solid var(--color-border);
	}

	.category-tabs button:first-child {
		color: var(--color-accent-strong);
		border-color: var(--color-accent);
	}

	.archive-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 19.5rem;
		gap: 1.75rem;
		align-items: start;
	}

	.archive-main {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.archive-side {
		display: grid;
		gap: 1.75rem;
		padding-top: 3.75rem;
	}

	.discord-card,
	.tag-cloud {
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
		border: 1px solid var(--color-border);
	}

	.discord-card {
		min-height: 9.5rem;
		padding: 1.75rem 2rem;
	}

	.discord-card span {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	.discord-card h3 {
		margin-top: 1.75rem;
		font-size: 1.5rem;
		line-height: 1;
		letter-spacing: -0.05em;
		color: var(--color-ink);
	}

	.discord-card p {
		margin-top: 0.75rem;
		font-size: 0.75rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 1.75rem;
	}

	.tag-cloud a {
		padding: 0.5rem 0.75rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.more-link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 4.75rem;
		font-weight: 700;
		color: var(--color-text);
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
		border: 1px solid var(--color-border);
	}

	.course-grid {
		display: grid;
		grid-template-columns: 1.18fr 0.91fr 0.91fr;
		gap: 1.25rem;
	}

	.course-grid :global(.course-card:first-child) {
		grid-row: span 2;
	}

	.course-grid :global(.course-card:first-child .visual) {
		aspect-ratio: 16 / 9;
	}

	.special-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border: 1px solid var(--color-border);
	}

	.special-grid a {
		position: relative;
		min-height: 8.5rem;
		padding: 1.75rem;
		background: color-mix(in oklch, var(--color-surface) 82%, transparent);
		border-left: 1px solid var(--color-border);
	}

	.special-grid a:first-child {
		border-left: 0;
	}

	.special-grid h3 {
		font-size: 1.75rem;
		line-height: 1;
		letter-spacing: -0.055em;
		color: var(--color-ink);
	}

	.special-grid p {
		margin-top: 0.75rem;
		font-size: 1rem;
		color: var(--color-muted);
	}

	.special-grid svg {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		color: var(--color-accent-strong);
	}

	.about-section {
		display: flex;
		justify-content: center;
	}

	@media (max-width: 61.25rem) {
		.hero {
			grid-template-columns: 1fr;
		}

		.hero-gallery {
			align-items: flex-start;
			justify-content: flex-start;
		}

		.archive-layout,
		.course-grid {
			grid-template-columns: 1fr;
		}

		.article-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.archive-side {
			grid-template-columns: 1fr 1fr;
			padding-top: 0;
		}

		.course-grid :global(.course-card:first-child) {
			grid-row: auto;
		}

		.special-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.special-grid a:nth-child(odd) {
			border-left: 0;
		}

		.special-grid a:nth-child(n + 3) {
			border-top: 1px solid var(--color-border);
		}
	}

	@media (max-width: 40rem) {
		.hero {
			padding-top: 3.25rem;
		}

		.stats-panel,
		.article-grid,
		.archive-side,
		.course-grid,
		.special-grid {
			grid-template-columns: 1fr;
		}

		.stats-panel div,
		.special-grid a {
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.stats-panel div:first-child,
		.special-grid a:first-child {
			border-top: 0;
		}

		.hero-gallery {
			align-items: stretch;
		}

		.dragon {
			width: 16.25rem;
		}

		.feature-note {
			grid-template-columns: 1fr;
			width: 100%;
		}

		.home-container {
			gap: 5.25rem;
			padding-inline: 1rem;
		}
	}
</style>
