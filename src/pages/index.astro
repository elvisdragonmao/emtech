---
import HomeArchive from "../components/home/HomeArchive.astro";
import HomeCoursesPreview from "../components/home/HomeCoursesPreview.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeSpecialPages from "../components/home/HomeSpecialPages.astro";
import AboutCard from "../components/shared/AboutCard.astro";
import CommentArea from "../components/shared/CommentArea.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout active="home">
	<main>
		<div class="home-container">
			<HomeHero />
			<HomeArchive />
			<HomeCoursesPreview />
			<HomeSpecialPages />

			<section class="about-section">
				<AboutCard />
			</section>

			<section>
				<CommentArea />
			</section>
		</div>
	</main>
</Layout>

<style>
	main {
		padding-bottom: 1.5rem;
	}

	.home-container {
		display: flex;
		flex-direction: column;
		gap: 7.5rem;
		width: 100%;
		max-width: calc(var(--site-width) + 4rem);
		margin-inline: auto;
		padding-inline: 2rem;
	}

	.about-section {
		display: flex;
		justify-content: center;
	}

	@media (max-width: 40rem) {
		.home-container {
			gap: 5.25rem;
			padding-inline: 1rem;
		}
	}
</style>
