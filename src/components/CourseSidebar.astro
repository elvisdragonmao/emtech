---
import { ArrowLeft, CircleCheck } from "@lucide/astro";
import { courseModules } from "../data/prototype";

interface Props {
	current?: string;
}

const { current = "04" } = Astro.props;
---

<aside class="course-sidebar">
	<a class="back-link" href="/course/"><ArrowLeft size={15} stroke-width={1.8} />Back to course overview</a>
	<nav aria-label="課程章節">
		{
			courseModules.map(module => {
				const number = module.number.replace("Module ", "");
				return (
					<a class:list={[{ active: current === number }]} href={module.href}>
						<span>{number}</span>
						{module.title}
						{current === number && <CircleCheck size={15} stroke-width={1.8} />}
					</a>
				);
			})
		}
		<a href="/course/">
			<span>05</span>
			非同步的非同步
		</a>
		<a href="/course/">
			<span>06</span>
			搜尋引擎最佳化 SEO
		</a>
	</nav>
</aside>

<style>
	.course-sidebar {
		position: sticky;
		top: 96px;
		align-self: start;
		padding: 26px 24px;
		background: color-mix(in oklch, var(--color-surface) 80%, transparent);
		border: 1px solid var(--color-border);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 22px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	nav {
		display: grid;
	}

	nav a {
		display: grid;
		grid-template-columns: 28px 1fr auto;
		align-items: center;
		gap: 8px;
		min-height: 48px;
		padding: 10px 0;
		font-size: 13px;
		font-weight: 700;
		color: var(--color-muted);
		border-top: 1px solid var(--color-border);
	}

	nav a.active {
		color: var(--color-ink);
	}

	nav a span {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-muted);
	}

	nav a svg {
		color: var(--color-accent-strong);
	}

	@media (max-width: 980px) {
		.course-sidebar {
			position: static;
		}
	}
</style>
