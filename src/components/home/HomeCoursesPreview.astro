---
import { courses } from "../../data/prototype";
import CourseCard from "../shared/CourseCard.astro";
import SectionTitle from "../shared/SectionTitle.astro";

const topCourses = courses.slice(0, 3);
const featuredCourses = courses.slice(3);
---

<section class="section-block courses-preview">
	<SectionTitle eyebrow="Course" title="一篇像廢文<br>一系列看起來就挺有道理。" description="鐵人賽系列文章<br>和詳細的程式開發與設計教學" />
	<div class="course-grid-top">
		{topCourses.map(course => <CourseCard course={course} />)}
	</div>
	{
		featuredCourses.length > 0 && (
			<div class="course-grid-featured">
				{featuredCourses.map(course => (
					<CourseCard course={course} featured={true} />
				))}
			</div>
		)
	}
</section>

<style>
	.section-block {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	/* Row 1: 3 cards, no gap, leftmost 1.3x wider, borders collapse */
	.course-grid-top {
		display: grid;
		grid-template-columns: 1.3fr 1fr 1fr;
		gap: 0;
	}

	/* first card larger h3 */
	.course-grid-top :global(.course-card:first-child h3) {
		font-size: 3rem;
	}

	.course-grid-top :global(.course-card:not(:hover)) {
		border-right: none;
	}

	.course-grid-top :global(.course-card:last-child:not(:hover)) {
		border-right: 1px solid var(--color-border);
	}

	.course-grid-featured {
		display: flex;
	}
</style>
