---
import { ArrowRight } from "@lucide/astro";
import type { ArticleCard as ArticleCardData } from "../data/prototype";

interface Props {
	article: ArticleCardData;
	compact?: boolean;
}

const { article, compact = false } = Astro.props;
---

<a class:list={["article-card", { compact }]} href={article.href}>
	<figure>
		<img src={article.image.src} width={article.image.width} height={article.image.height} alt={article.title} loading="lazy" />
	</figure>
	<div class="card-body">
		<p class="tag">{article.tag}</p>
		<h3>{article.title}</h3>
		<p class="description">{article.description}</p>
		<div class="meta">
			<span>{article.category}</span>
			<span>{article.readTime}</span>
			<ArrowRight size={16} stroke-width={1.8} />
		</div>
	</div>
</a>

<style>
	.article-card {
		display: grid;
		grid-template-rows: auto 1fr;
		min-height: 100%;
		color: var(--color-text);
		background: color-mix(in oklch, var(--color-surface) 92%, transparent);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 0 0 0.0625rem color-mix(in oklch, var(--color-surface) 60%, transparent);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			border-color 180ms ease;
	}

	.article-card:hover {
		transform: translateY(-0.25rem);
		border-color: color-mix(in oklch, var(--color-accent) 55%, var(--color-border));
		box-shadow: var(--shadow-card);
	}

	figure {
		position: relative;
		aspect-ratio: 16 / 9;
		margin: 0.75rem 0.75rem 0;
		overflow: hidden;
		background: var(--color-surface-soft);
	}

	figure::after {
		position: absolute;
		inset: 0;
		content: "";
		border: 1px solid color-mix(in oklch, var(--color-surface) 32%, transparent);
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 260ms ease;
	}

	.article-card:hover img {
		transform: scale(1.04);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		padding: 1.125rem 1.25rem 1.25rem;
	}

	.tag {
		margin-bottom: 0.875rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-muted);
	}

	h3 {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		line-height: 1.22;
		letter-spacing: -0.045em;
		color: var(--color-ink);
	}

	.description {
		display: none;
		margin: 0.8125rem 0 1.5rem;
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-top: auto;
		padding-top: 1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
		border-top: 1px solid var(--color-border);
	}

	.meta svg {
		margin-left: auto;
		color: var(--color-accent-strong);
	}

	.compact {
		grid-template-columns: 10.25rem 1fr;
		grid-template-rows: auto;
		align-items: stretch;
	}

	.compact figure {
		height: 100%;
		min-height: 7.375rem;
		margin: 0.625rem 0 0.625rem 0.625rem;
	}

	.compact .card-body {
		padding: 0.875rem 1rem;
	}

	.compact h3 {
		font-size: 1.125rem;
	}

	.compact .description {
		display: none;
	}

	.compact .meta {
		padding-top: 0.75rem;
	}

	@media (max-width: 35rem) {
		.compact {
			grid-template-columns: 1fr;
		}

		.compact figure {
			margin: 0.75rem 0.75rem 0;
		}
	}
</style>
