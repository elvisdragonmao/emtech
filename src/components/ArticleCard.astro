---
import { ArrowRight } from "@lucide/astro";
import type { ArticleCard as ArticleCardData } from "../data/prototype";

interface Props {
	article: ArticleCardData;
	compact?: boolean;
}

const { article, compact = false } = Astro.props;
---

<a class:list={["article-card", { compact }]} href={article.href}>
	<figure>
		<img src={article.image.src} width={article.image.width} height={article.image.height} alt={article.title} loading="lazy" />
	</figure>
	<div class="card-body">
		<p class="tag">{article.tag}</p>
		<h3>{article.title}</h3>
		<p class="description">{article.description}</p>
		<div class="meta">
			<span>{article.category}</span>
			<span>{article.readTime}</span>
			<ArrowRight size={16} stroke-width={1.8} />
		</div>
	</div>
</a>

<style>
	.article-card {
		display: grid;
		grid-template-rows: auto 1fr;
		min-height: 100%;
		color: var(--color-text);
		background: color-mix(in oklch, var(--color-surface) 92%, transparent);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-surface) 60%, transparent);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			border-color 180ms ease;
	}

	.article-card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in oklch, var(--color-accent) 55%, var(--color-border));
		box-shadow: var(--shadow-card);
	}

	figure {
		position: relative;
		aspect-ratio: 16 / 9;
		margin: 12px 12px 0;
		overflow: hidden;
		background: var(--color-surface-soft);
	}

	figure::after {
		position: absolute;
		inset: 0;
		content: "";
		border: 1px solid color-mix(in oklch, var(--color-surface) 32%, transparent);
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 260ms ease;
	}

	.article-card:hover img {
		transform: scale(1.04);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		padding: 18px 20px 20px;
	}

	.tag {
		margin-bottom: 14px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		color: var(--color-muted);
	}

	h3 {
		font-size: clamp(20px, 2vw, 28px);
		line-height: 1.22;
		letter-spacing: -0.045em;
		color: var(--color-ink);
	}

	.description {
		display: none;
		margin: 13px 0 24px;
		font-size: 14px;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: auto;
		padding-top: 16px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
		border-top: 1px solid var(--color-border);
	}

	.meta svg {
		margin-left: auto;
		color: var(--color-accent-strong);
	}

	.compact {
		grid-template-columns: 164px 1fr;
		grid-template-rows: auto;
		align-items: stretch;
	}

	.compact figure {
		height: 100%;
		min-height: 118px;
		margin: 10px 0 10px 10px;
	}

	.compact .card-body {
		padding: 14px 16px;
	}

	.compact h3 {
		font-size: 18px;
	}

	.compact .description {
		display: none;
	}

	.compact .meta {
		padding-top: 12px;
	}

	@media (max-width: 560px) {
		.compact {
			grid-template-columns: 1fr;
		}

		.compact figure {
			margin: 12px 12px 0;
		}
	}
</style>
