---
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import type { MetaItem, TocHeading } from "../../utils/content";
import MetaTable from "./MetaTable.astro";

interface Props {
	tag: string;
	title: string;
	image?: ImageMetadata | null;
	meta: MetaItem[];
	tldr?: string;
	headings?: TocHeading[];
	previousHref?: string;
	previousTitle?: string;
	nextHref?: string;
	nextTitle?: string;
}

const {
	tag,
	title,
	image,
	meta,
	tldr,
	headings = [],
	previousHref,
	previousTitle,
	nextHref,
	nextTitle
} = Astro.props;

// Only show TOC headings at depth 2 and 3
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<section class="article-hero">
	<div></div>
	<div class="hero-main">
		<p class="tag">{tag}</p>
		<h1>{title}</h1>
		<MetaTable items={meta} />
	</div>
	<aside class="hero-tldr">
		<p>TLDR</p>
		<span>{tldr ?? ""}</span>
		{
			(previousHref || nextHref) && (
				<div class="side-nav">
					{previousHref && (
						<a href={previousHref}>
							<ArrowLeft size={14} stroke-width={1.8} />
							{previousTitle ?? "上一篇"}
						</a>
					)}
					{nextHref && (
						<a href={nextHref}>
							{nextTitle ?? "下一篇"}
							<ArrowRight size={14} stroke-width={1.8} />
						</a>
					)}
				</div>
			)
		}
	</aside>
</section>

<section class="article-shell">
	<aside class="toc" aria-label="文章目錄">
		{
			tocItems.length > 0 ? (
				<>
					<span class="toc-label">On This Page</span>
					{tocItems.map((item) => (
						<a
							href={`#${item.slug}`}
							class:list={[{ "toc-h3": item.depth === 3 }]}
						>
							{item.text}
						</a>
					))}
				</>
			) : null
		}
	</aside>

	<article id="content" class="article-content">
		{
			image && (
				<img
					class="hero-image"
					src={image.src}
					width={image.width}
					height={image.height}
					alt={title}
				/>
			)
		}
		<slot />
	</article>

	<div></div>
</section>

<style>
	.article-hero,
	.article-shell {
		width: 100%;
	}

	.article-hero {
		display: grid;
		grid-template-columns: 12.5rem minmax(0, 58.25rem) 12.5rem;
		gap: 2.75rem;
		align-items: start;
	}

	.hero-main {
		min-width: 0;
	}

	.hero-tldr {
		position: relative;
		margin-top: 7.5rem;
		color: var(--color-muted);
	}

	.hero-tldr::before {
		position: absolute;
		top: -6.75rem;
		left: -4.75rem;
		z-index: -1;
		width: 16.25rem;
		height: 16.25rem;
		content: "";
		border: 1px solid oklch(71% 0.15 225 / 48%);
		border-radius: 50%;
	}

	.hero-tldr p {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-text);
	}

	.hero-tldr span {
		display: block;
		margin-top: 0.75rem;
		font-size: 1rem;
		line-height: 1.8;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 400;
		color: var(--color-accent-strong);
	}

	h1 {
		margin: 1.25rem 0 2rem;
		font-size: 4rem;
		line-height: 1.2;
		letter-spacing: -0.05em;
		color: var(--color-ink);
	}

	.article-shell {
		display: grid;
		grid-template-columns: 12.5rem minmax(0, 58.25rem) 12.5rem;
		gap: 2.75rem;
		align-items: start;
		margin-top: 2.75rem;
	}

	.toc {
		position: sticky;
		top: 6rem;
		padding-top: 1.25rem;
	}

	.toc-label {
		display: block;
		padding: 0.5rem 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--color-ink);
	}

	.toc a {
		display: block;
		padding: 0.4rem 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-muted);
	}

	.toc a.toc-h3 {
		padding-left: 0.75rem;
	}

	.side-nav {
		display: grid;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.side-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: var(--color-accent-strong);
	}

	.article-content {
		font-size: 1rem;
		line-height: 2;
		color: var(--color-text);
	}

	.hero-image {
		width: 100%;
		aspect-ratio: 2 / 1;
		height: auto;
		object-fit: cover;
		margin-bottom: 2.75rem;
		box-shadow: var(--shadow-card);
	}

	/* ── Article typography ─────────────────────────── */
	.article-content :global(h2),
	.article-content :global(h3),
	.article-content :global(h4),
	.article-content :global(h5) {
		line-height: 1.15;
		letter-spacing: -0.06em;
		color: var(--color-ink);
	}

	.article-content :global(h2) {
		margin: 4.5rem 0 1.5rem;
		font-size: 3.25rem;
	}

	.article-content :global(h3) {
		margin: 2.75rem 0 1rem;
		font-size: 2rem;
	}

	.article-content :global(h4) {
		margin: 2.25rem 0 1rem;
		font-size: 1.5rem;
	}

	.article-content :global(h5) {
		font-size: 1.25rem;
	}

	.article-content :global(p + p),
	.article-content :global(p + ul),
	.article-content :global(p + ol) {
		margin-top: 1.25rem;
	}

	.article-content :global(a) {
		color: var(--color-accent-strong);
		border-bottom: 1px solid currentColor;
	}

	.article-content :global(code) {
		padding: 0.25rem 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.86em;
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		padding-left: 1.2em;
		margin-top: 0.75rem;
	}

	.article-content :global(li + li) {
		margin-top: 0.4rem;
	}

	.article-content :global(img) {
		max-width: 100%;
		height: auto;
		display: block;
		margin: 2rem auto;
	}

	/* code blocks — wrapped by rehype-code-window if present */
	.article-content :global(pre) {
		overflow-x: auto;
		padding: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.92rem;
		line-height: 1.8;
		color: var(--color-code-ink);
		background: var(--color-code-bg);
		border: 1px solid var(--color-border-strong);
		box-shadow: var(--shadow-card);
		margin: 2.5rem 0;
	}

	.article-content :global(pre code) {
		padding: 0;
		font-size: inherit;
		background: none;
		border: none;
	}

	/* figcaption */
	.article-content :global(figcaption) {
		margin-top: 0.75rem;
		font-size: 0.75rem;
		text-align: center;
		color: var(--color-muted);
	}

	/* ── Callout blocks ──────────────────────────────── */

	/* > [!TLDR] / > [!SUMMARY] → prominent accent callout */
	.article-content :global(.callout-tldr) {
		position: relative;
		padding: 2.25rem 2.75rem;
		overflow: hidden;
		background: oklch(93% 0.045 220 / 55%);
		border: 1px solid var(--color-accent);
		margin: 2rem 0;
	}

	.article-content :global(.callout-tldr > strong) {
		display: block;
		margin-bottom: 1.25rem;
		font-size: 1.25rem;
		color: var(--color-ink);
	}

	.article-content :global(.callout-tldr > p) {
		position: relative;
		z-index: 1;
		max-width: 38.75rem;
	}

	/* watermark span */
	.article-content :global(.callout-tldr > span[aria-hidden]) {
		position: absolute;
		right: 1.5rem;
		bottom: -0.75rem;
		font-size: 4.75rem;
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.08em;
		color: oklch(71% 0.15 225 / 42%);
		pointer-events: none;
	}

	/* > [!NOTE] / > [!TIP] → warm notice box */
	.article-content :global(.callout-note),
	.article-content :global(.callout-tip) {
		margin: 2rem 0;
		padding: 2rem 2.25rem;
		background: oklch(97.2% 0.02 78 / 70%);
		border: 1px solid var(--color-yellow);
	}

	.article-content :global(.callout-note > strong),
	.article-content :global(.callout-tip > strong) {
		display: block;
		margin-bottom: 0.75rem;
		font-size: 1rem;
		color: var(--color-ink);
	}

	/* > [!WARNING] → red-tinted warning */
	.article-content :global(.callout-warning) {
		margin: 2rem 0;
		padding: 2rem 2.25rem;
		background: oklch(97% 0.02 20 / 70%);
		border: 1px solid oklch(65% 0.15 20);
	}

	.article-content :global(.callout-warning > strong) {
		display: block;
		margin-bottom: 0.75rem;
		font-size: 1rem;
		color: oklch(40% 0.12 20);
	}

	/* ── Responsive ──────────────────────────────────── */
	@media (max-width: 68.75rem) {
		.article-hero,
		.article-shell {
			grid-template-columns: minmax(0, 1fr);
			max-width: 51.25rem;
			margin-inline: auto;
		}

		.toc,
		.hero-tldr,
		.article-hero > div:first-child {
			display: none;
		}
	}

	@media (max-width: 40rem) {
		.article-content :global(.callout-tldr),
		.article-content :global(.callout-note),
		.article-content :global(.callout-tip),
		.article-content :global(.callout-warning) {
			padding: 1.5rem;
		}

		.article-content :global(.callout-tldr > span[aria-hidden]) {
			font-size: 3.25rem;
		}
	}
</style>
