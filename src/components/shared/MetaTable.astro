---
type MetaItem = {
	label: string;
	value: string;
};

interface Props {
	items: MetaItem[];
}

const { items } = Astro.props;
---

<dl class="meta-table">
	{
		items.map(item => (
			<div>
				<dt>{item.label}</dt>
				<dd>{item.value}</dd>
			</div>
		))
	}
</dl>

<style>
	.meta-table {
		display: grid;
		grid-template-columns: repeat(var(--meta-columns, 5), minmax(0, 1fr));
		border: 1px solid var(--color-border);
		background: oklch(100% 0 0 / 76%);
	}

	.meta-table div {
		min-width: 0;
		min-height: 4.75rem;
		padding: 0.75rem 1rem;
		border-left: 1px solid var(--color-border);
	}

	.meta-table div:first-child {
		border-left: 0;
	}

	dt {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-muted);
	}

	dd {
		margin-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-text);
		overflow-wrap: anywhere;
	}

	@media (max-width: 48.75rem) {
		.meta-table {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.meta-table div:nth-child(odd) {
			border-left: 0;
		}

		.meta-table div {
			border-top: 1px solid var(--color-border);
		}

		.meta-table div:nth-child(-n + 2) {
			border-top: 0;
		}
	}

	@media (max-width: 30rem) {
		.meta-table {
			grid-template-columns: 1fr;
		}

		.meta-table div,
		.meta-table div:nth-child(odd),
		.meta-table div:nth-child(-n + 2) {
			border-top: 1px solid var(--color-border);
			border-left: 0;
		}

		.meta-table div:first-child {
			border-top: 0;
		}
	}
</style>
