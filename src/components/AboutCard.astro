---
import { Camera, GitBranch, Globe } from "@lucide/astro";

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class:list={["about-card", { compact }]}>
	<div>
		<p class="eyebrow">About me</p>
		<h2>毛哥EM</h2>
		<p class="bio">一隻生病腦袋還有英文辯士，熱愛開源、音樂、設計、獸迷文化，專研人機互動與人工智慧。本部落格持續累積從實作到踩坑的筆記。</p>
		<div class="links" aria-label="社群連結">
			<a href="https://elvismao.com" aria-label="個人網站"><Globe size={22} stroke-width={1.7} /></a>
			<a href="https://github.com/" aria-label="GitHub"><GitBranch size={22} stroke-width={1.7} /></a>
			<a href="https://instagram.com/" aria-label="Instagram"><Camera size={22} stroke-width={1.7} /></a>
		</div>
	</div>
	<img class="dragon" src="/img/avatar_faier.webp" alt="毛哥EM 角色插圖" loading="lazy" />
</section>

<style>
	.about-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 14.375rem;
		align-items: end;
		width: min(57.5rem, 100%);
		min-height: 18.75rem;
		padding: 2.625rem 2.625rem 1.875rem;
		overflow: hidden;
		background: color-mix(in oklch, var(--color-surface) 84%, transparent);
		border: 1px solid var(--color-accent);
		box-shadow: var(--shadow-card);
	}

	.about-card::before {
		position: absolute;
		inset: 1.125rem;
		content: "";
		border: 1px solid color-mix(in oklch, var(--color-border) 70%, transparent);
		pointer-events: none;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	h2 {
		margin-top: 0.875rem;
		font-size: clamp(2.375rem, 7vw, 4.625rem);
		line-height: 0.9;
		letter-spacing: -0.08em;
		color: var(--color-ink);
	}

	.bio {
		max-width: 28.75rem;
		margin-top: 1.375rem;
		font-size: 0.9375rem;
		line-height: 1.9;
		color: var(--color-muted);
	}

	.links {
		display: flex;
		gap: 1.125rem;
		margin-top: 1.75rem;
	}

	.links a {
		color: var(--color-muted);
		transition: color 160ms ease;
	}

	.links a:hover {
		color: var(--color-accent-strong);
	}

	.dragon {
		position: absolute;
		right: 2.25rem;
		bottom: -1.625rem;
		z-index: 1;
		width: auto;
		height: 18.75rem;
		filter: drop-shadow(0 1.5rem 1.5rem color-mix(in oklch, var(--color-accent) 18%, transparent));
	}

	.compact {
		width: 100%;
		grid-template-columns: 1fr 13.125rem;
		min-height: 14.375rem;
		padding: 1.875rem;
	}

	.compact h2 {
		font-size: 2.625rem;
	}

	.compact .bio {
		font-size: 0.875rem;
	}

	.compact .dragon {
		right: 2.125rem;
		bottom: -1.5rem;
		width: auto;
		height: 13.625rem;
	}

	@media (max-width: 40rem) {
		.about-card,
		.compact {
			grid-template-columns: 1fr;
			padding: 1.875rem 1.5rem 0;
		}

		.dragon,
		.compact .dragon {
			position: relative;
			right: auto;
			bottom: auto;
			width: auto;
			height: 15.625rem;
			margin: 0.625rem auto -2.125rem;
			justify-self: center;
		}
	}
</style>
