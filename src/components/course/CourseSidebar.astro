---
import { ArrowLeft, CircleCheck } from "@lucide/astro";

interface Props {
	courseId: string;
	courseTitle: string;
	lessons: Array<{ id: string; title: string; href: string }>;
	currentId: string;
}

const { courseId, lessons, currentId } = Astro.props;
const progressStorageKey = `emtech:course-progress:${courseId}`;
---

<aside class="course-sidebar" data-course-progress-key={progressStorageKey}>
	<a class="back-link" href={`/course/${courseId}/`}><ArrowLeft size={15} stroke-width={1.8} />Back to course overview</a>
	<nav aria-label="課程章節">
		{
			lessons.map((lesson, i) => {
				const isActive = lesson.id === currentId;
				const number = String(i + 1).padStart(2, "0");
				return (
					<a class:list={[{ active: isActive }]} href={lesson.href} data-lesson-id={lesson.id}>
						<span>{number}</span>
						{lesson.title}
						<CircleCheck size={15} stroke-width={1.8} />
					</a>
				);
			})
		}
	</nav>
</aside>

<script>
	const sidebar = document.querySelector<HTMLElement>("[data-course-progress-key]");
	const progressKey = sidebar?.dataset.courseProgressKey;
	const lessonLinks = Array.from(sidebar?.querySelectorAll<HTMLAnchorElement>("[data-lesson-id]") ?? []);

	const parseProgress = (value: string | null) => {
		if (!value) return [];
		try {
			const parsed = JSON.parse(value);
			return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === "string") : [];
		} catch {
			return [];
		}
	};

	const renderProgress = (completed: string[]) => {
		const completedSet = new Set(completed);
		for (const link of lessonLinks) {
			link.classList.toggle("completed", completedSet.has(link.dataset.lessonId ?? ""));
		}
	};

	if (progressKey) {
		renderProgress(parseProgress(window.localStorage.getItem(progressKey)));
		window.addEventListener("emtech:course-progress", event => {
			const detail = (event as CustomEvent<{ storageKey?: string; completed?: string[] }>).detail;
			if (detail?.storageKey === progressKey && Array.isArray(detail.completed)) renderProgress(detail.completed);
		});
	}
</script>

<style>
	.course-sidebar {
		position: sticky;
		top: 6rem;
		align-self: start;
		padding: 1.75rem 1.5rem;
		background: oklch(100% 0 0 / 80%);
		border: 1px solid var(--color-border);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	nav {
		display: grid;
	}

	nav a {
		display: grid;
		grid-template-columns: 1.75rem 1fr auto;
		align-items: center;
		gap: 0.5rem;
		min-height: 3rem;
		padding: 0.75rem 0;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-muted);
		border-top: 1px solid var(--color-border);
	}

	nav a.active {
		color: var(--color-accent-strong);
	}

	nav a span {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	nav a svg {
		display: none;
		color: var(--color-accent-strong);
	}

	nav a.completed svg {
		display: block;
	}

	@media (max-width: 61.25rem) {
		.course-sidebar {
			position: static;
		}
	}
</style>
