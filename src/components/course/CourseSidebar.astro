---
import { ArrowLeft, CircleCheck } from "@lucide/astro";

interface Props {
	courseId: string;
	courseTitle: string;
	lessons: Array<{ id: string; title: string; href: string }>;
	currentId: string;
}

const { courseId, lessons, currentId } = Astro.props;
---

<aside class="course-sidebar">
	<a class="back-link" href={`/course/${courseId}/`}><ArrowLeft size={15} stroke-width={1.8} />Back to course overview</a>
	<nav aria-label="課程章節">
		{
			lessons.map((lesson, i) => {
				const isActive = lesson.id === currentId;
				const number = String(i + 1).padStart(2, "0");
				return (
					<a class:list={[{ active: isActive }]} href={lesson.href}>
						<span>{number}</span>
						{lesson.title}
						{isActive && <CircleCheck size={15} stroke-width={1.8} />}
					</a>
				);
			})
		}
	</nav>
</aside>

<style>
	.course-sidebar {
		position: sticky;
		top: 6rem;
		align-self: start;
		padding: 1.75rem 1.5rem;
		background: oklch(100% 0 0 / 80%);
		border: 1px solid var(--color-border);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--color-accent-strong);
	}

	nav {
		display: grid;
	}

	nav a {
		display: grid;
		grid-template-columns: 1.75rem 1fr auto;
		align-items: center;
		gap: 0.5rem;
		min-height: 3rem;
		padding: 0.75rem 0;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-muted);
		border-top: 1px solid var(--color-border);
	}

	nav a.active {
		color: var(--color-ink);
	}

	nav a span {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	nav a svg {
		color: var(--color-accent-strong);
	}

	@media (max-width: 61.25rem) {
		.course-sidebar {
			position: static;
		}
	}
</style>
