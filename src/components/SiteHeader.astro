---
import { Search } from "@lucide/astro";

interface Props {
	active?: "home" | "blog" | "course";
}

const { active = "home" } = Astro.props;

const navItems = [
	{ label: "首頁", href: "/", key: "home" },
	{ label: "歸檔", href: "/#archive", key: "blog" },
	{ label: "課程", href: "/course/", key: "course" }
];
---

<header class="site-header">
	<a class="brand" href="/" aria-label="回到首頁">
		<img src="/img/logo.svg" alt="" width="32" height="37" />
		<span>毛哥EM資訊密技</span>
	</a>

	<nav class="main-nav" aria-label="主要導覽">
		{
			navItems.map(item => (
				<a href={item.href} class:list={[{ active: active === item.key }]}>
					{item.label}
				</a>
			))
		}
	</nav>

	<button class="search-button" type="button" aria-label="搜尋文章">
		<Search size={15} stroke-width={1.8} />
		<span>Search</span>
		<kbd>/</kbd>
		<kbd>⌘K</kbd>
	</button>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: min(var(--site-width), calc(100% - 32px));
		min-height: 66px;
		margin: 0 auto;
		padding: 0 8px;
		border-bottom: 1px solid var(--color-border);
		background: color-mix(in oklch, var(--color-bg) 88%, transparent);
		backdrop-filter: blur(18px);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		width: fit-content;
		font-size: 15px;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--color-ink);
	}

	.brand img {
		width: 28px;
		height: auto;
		filter: saturate(0.65);
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: 30px;
		font-size: 14px;
		color: var(--color-muted);
	}

	.main-nav a {
		position: relative;
		padding: 24px 0;
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.main-nav a::after {
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		height: 2px;
		content: "";
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.main-nav a:hover,
	.main-nav a.active {
		color: var(--color-ink);
	}

	.main-nav a:hover::after,
	.main-nav a.active::after {
		transform: scaleX(1);
	}

	.search-button {
		display: inline-flex;
		justify-self: end;
		align-items: center;
		gap: 8px;
		min-width: 126px;
		padding: 8px 10px;
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1;
		color: var(--color-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-surface) 55%, transparent);
	}

	.search-button kbd {
		padding: 2px 4px;
		font-family: inherit;
		font-size: 10px;
		color: var(--color-faint);
		border: 1px solid var(--color-border);
	}

	@media (max-width: 760px) {
		.site-header {
			grid-template-columns: 1fr auto;
			min-height: auto;
			padding: 12px 0;
		}

		.main-nav {
			grid-column: 1 / -1;
			justify-content: space-between;
			order: 3;
			width: 100%;
			padding-top: 10px;
			gap: 0;
			border-top: 1px solid var(--color-border);
		}

		.main-nav a {
			padding: 10px 0 0;
		}

		.search-button span,
		.search-button kbd {
			display: none;
		}

		.search-button {
			min-width: auto;
			padding: 9px;
		}
	}
</style>
