---
import { Search } from "@lucide/astro";

interface Props {
	active?: "home" | "blog" | "course";
}

const { active = "home" } = Astro.props;

const navItems = [
	{ label: "首頁", href: "/", key: "home" },
	{ label: "歸檔", href: "/#archive", key: "blog" },
	{ label: "課程", href: "/course/", key: "course" }
];
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="brand" href="/" aria-label="回到首頁">
			<img src="/img/logo.svg" alt="" width="32" height="37" />
			<span>毛哥EM資訊密技</span>
		</a>

		<nav class="main-nav" aria-label="主要導覽">
			{
				navItems.map(item => (
					<a href={item.href} class:list={[{ active: active === item.key }]}>
						{item.label}
					</a>
				))
			}
		</nav>

		<button class="search-button" type="button" aria-label="搜尋文章">
			<Search size={15} stroke-width={1.8} />
			<span>Search</span>
			<kbd>/</kbd>
			<kbd>⌘K</kbd>
		</button>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		width: 100%;
		border-bottom: 1px solid var(--color-border);
		background: color-mix(in oklch, var(--color-bg) 88%, transparent);
		backdrop-filter: blur(1.25rem);
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: min(var(--site-width), calc(100% - 2rem));
		min-height: 4.25rem;
		margin: 0 auto;
		padding: 0 0.5rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		width: fit-content;
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--color-ink);
	}

	.brand img {
		width: 1.75rem;
		height: auto;
		filter: saturate(0.65);
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		font-size: 1rem;
		color: var(--color-muted);
	}

	.main-nav a {
		position: relative;
		padding: 1.5rem 0;
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.main-nav a::after {
		position: absolute;
		right: 0;
		bottom: 0rem;
		left: 0;
		height: 0.25rem;
		content: "";
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.main-nav a:hover,
	.main-nav a.active {
		color: var(--color-ink);
	}

	.main-nav a:hover::after,
	.main-nav a.active::after {
		transform: scaleX(1);
	}

	.search-button {
		display: inline-flex;
		justify-self: end;
		align-items: center;
		gap: 0.5rem;
		min-width: 8rem;
		padding: 0.5rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1;
		color: var(--color-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 0 0 0rem color-mix(in oklch, var(--color-surface) 55%, transparent);
	}

	.search-button kbd {
		padding: 0.25rem 0.25rem;
		font-family: inherit;
		font-size: 0.75rem;
		color: var(--color-faint);
		border: 1px solid var(--color-border);
	}

	@media (max-width: 47.5rem) {
		.site-header__inner {
			grid-template-columns: 1fr auto;
			min-height: auto;
			padding: 0.75rem 0;
		}

		.main-nav {
			grid-column: 1 / -1;
			justify-content: space-between;
			order: 3;
			width: 100%;
			padding-top: 0.75rem;
			gap: 0;
			border-top: 1px solid var(--color-border);
		}

		.main-nav a {
			padding: 0.75rem 0 0;
		}

		.search-button span,
		.search-button kbd {
			display: none;
		}

		.search-button {
			min-width: auto;
			padding: 0.5rem;
		}
	}
</style>
