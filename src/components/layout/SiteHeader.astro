---
import { Search } from "@lucide/astro";

interface Props {
	active?: "home" | "blog" | "course";
}

const { active } = Astro.props;

const navItems = [
	{ label: "首頁", href: "/", key: "home" },
	{ label: "文章", href: "/archive/", key: "blog" },
	{ label: "課程", href: "/course/", key: "course" }
];
---

<header class="site-header-container">
	<div class="site-header">
		<a class="brand" href="/" aria-label="回到首頁">
			<img src="/img/logo.svg" alt="" width="32" height="37" />
			<span>毛哥EM資訊密技</span>
		</a>

		<nav class="main-nav" aria-label="主要導覽">
			{
				navItems.map(item => (
					<a href={item.href} class:list={[{ active: active === item.key }]}>
						{item.label}
					</a>
				))
			}
		</nav>

		<button class="search-button" type="button" aria-label="搜尋文章">
			<Search size={15} stroke-width={1.8} />
			<span>Search</span>
			<kbd>/</kbd>
			<kbd>⌘K</kbd>
		</button>
	</div>
</header>

<style>
	.site-header-container {
		position: sticky;
		top: 0;
		z-index: 20;
		margin-inline: calc(var(--page-padding, 0rem) * -1);
		padding-inline: var(--page-padding, 0rem);
		border-bottom: 1px solid var(--color-border);
		background: oklch(99% 0.004 235 / 88%);
		backdrop-filter: blur(1.25rem);
	}

	.site-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: var(--site-width);
		margin: auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		width: fit-content;
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--color-ink);
	}

	.brand img {
		width: 1.75rem;
		height: auto;
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		font-size: 1rem;
		color: var(--color-muted);
	}

	.main-nav a {
		position: relative;
		padding: 1rem 0;
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.main-nav a::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 0.25rem;
		content: "";
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.main-nav a:hover,
	.main-nav a.active {
		color: var(--color-ink);
	}

	.main-nav a:hover::after,
	.main-nav a.active::after {
		transform: scaleX(1);
	}

	.search-button {
		display: inline-flex;
		justify-self: end;
		align-items: center;
		gap: 0.5rem;
		min-width: 8rem;
		padding: 0.5rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1;
		color: var(--color-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 0 0 1px oklch(100% 0 0 / 55%);
	}

	.search-button kbd {
		padding: 0.25rem 0.25rem;
		font-family: inherit;
		font-size: 0.75rem;
		color: var(--color-faint);
		border: 1px solid var(--color-border);
	}
</style>
