---
import { Menu, Search, X } from "@lucide/astro";

interface Props {
	active?: "home" | "blog" | "course";
}

const { active } = Astro.props;

const navItems = [
	{ label: "首頁", href: "/", key: "home" },
	{ label: "文章", href: "/archive/", key: "blog" },
	{ label: "課程", href: "/course/", key: "course" }
];
---

<header class="site-header-container">
	<div class="site-header">
		<a class="brand" href="/" aria-label="回到首頁">
			<img src="/img/logo.svg" alt="" width="32" height="37" />
			<span>毛哥EM資訊密技</span>
		</a>

		<nav id="site-main-nav" class="main-nav" aria-label="主要導覽">
			{
				navItems.map(item => (
					<a href={item.href} class:list={[{ active: active === item.key }]}>
						{item.label}
					</a>
				))
			}
		</nav>

		<button class="search-button" type="button" aria-label="搜尋文章與課程" aria-controls="site-search" data-search-open>
			<Search size={15} stroke-width={1.8} />
			<span>Search</span>
			<kbd>/</kbd>
			<kbd>⌘K</kbd>
		</button>

		<button class="menu-button" type="button" aria-label="開啟導覽選單" aria-controls="site-main-nav" aria-expanded="false" data-menu-toggle>
			<Menu class="menu-icon" size={18} stroke-width={1.8} />
			<X class="close-icon" size={18} stroke-width={1.8} />
		</button>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const nav = document.querySelector<HTMLElement>(".main-nav");
	const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const mobileMenu = window.matchMedia("(max-width: 43rem)");

	const setMenuOpen = (isOpen: boolean) => {
		if (!header || !nav || !menuToggle) return;
		header.classList.toggle("is-menu-open", isOpen);
		menuToggle.setAttribute("aria-expanded", String(isOpen));
		menuToggle.setAttribute("aria-label", isOpen ? "關閉導覽選單" : "開啟導覽選單");
		nav.toggleAttribute("inert", mobileMenu.matches && !isOpen);
		nav.setAttribute("aria-hidden", String(mobileMenu.matches && !isOpen));
	};

	menuToggle?.addEventListener("click", () => {
		setMenuOpen(!header?.classList.contains("is-menu-open"));
	});

	nav?.addEventListener("click", event => {
		if (event.target instanceof HTMLAnchorElement) setMenuOpen(false);
	});

	window.addEventListener("keydown", event => {
		if (event.key === "Escape") setMenuOpen(false);
	});

	mobileMenu.addEventListener("change", event => {
		if (!event.matches) setMenuOpen(false);
		else setMenuOpen(header?.classList.contains("is-menu-open") ?? false);
	});

	setMenuOpen(false);
</script>

<style>
	.site-header-container {
		position: sticky;
		top: 0;
		z-index: 20;
		margin-inline: calc(var(--page-padding, 0rem) * -1);
		padding-inline: var(--page-padding, 0rem);
		border-bottom: 1px solid var(--color-border);
		background: oklch(99% 0.004 235 / 88%);
		backdrop-filter: blur(1.25rem);
	}

	.site-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: var(--site-width);
		margin: auto;
		min-height: 4rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		width: fit-content;
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--color-ink);
	}

	.brand img {
		width: 1.75rem;
		height: auto;
	}

	.main-nav {
		display: flex;
		align-items: stretch;
		gap: 2rem;
		font-size: 1rem;
		color: var(--color-muted);
		height: 100%;
	}

	.main-nav a {
		position: relative;
		display: flex;
		align-items: center;
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.main-nav a::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 0.25rem;
		content: "";
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.main-nav a:hover,
	.main-nav a.active {
		color: var(--color-ink);
	}

	.main-nav a:hover::after,
	.main-nav a.active::after {
		transform: scaleX(1);
	}

	.search-button {
		display: inline-flex;
		justify-self: end;
		align-items: center;
		gap: 0.5rem;
		min-width: 8rem;
		padding: 0.5rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1;
		color: var(--color-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 0 0 1px oklch(100% 0 0 / 55%);
	}

	.search-button kbd {
		padding: 0.25rem 0.25rem;
		font-family: inherit;
		font-size: 0.75rem;
		color: var(--color-faint);
		border: 1px solid var(--color-border);
	}

	.menu-button {
		display: none;
		position: relative;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		overflow: hidden;
		color: var(--color-ink);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.menu-button svg {
		position: absolute;
		transition:
			opacity 140ms ease,
			transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.menu-button .close-icon {
		opacity: 0;
		transform: scale(0.45);
	}

	@media (max-width: 56rem) {
		.site-header {
			grid-template-columns: auto minmax(0, 1fr) auto;
			column-gap: 1rem;
		}

		.main-nav {
			justify-content: center;
			gap: 1.25rem;
		}
	}

	@media (max-width: 43rem) {
		.site-header-container {
			overflow: visible;
		}

		.site-header {
			position: relative;
			grid-template-columns: 1fr auto auto;
			column-gap: 0.5rem;
			row-gap: 0;
			min-height: auto;
			padding-block: 0.65rem;
		}

		.brand {
			min-width: 0;
			gap: 0.55rem;
			font-size: 0.95rem;
		}

		.brand span {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.main-nav {
			position: fixed;
			top: calc(100% + 1px);
			right: 0;
			left: 0;
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0;
			height: auto;
			padding: 0.35rem;
			font-size: 1rem;
			background: oklch(99% 0.004 235 / 94%);
			border: 1px solid var(--color-border);
			box-shadow: 0 1rem 2rem oklch(17% 0.022 255 / 8%);
			backdrop-filter: blur(1.25rem);
			opacity: 0;
			pointer-events: none;
			transform: translateY(-0.85rem);
			transition:
				opacity 180ms ease,
				transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
		}

		.site-header.is-menu-open .main-nav {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.main-nav a {
			justify-content: center;
			min-height: 2.75rem;
			padding-inline: 0.75rem;
		}

		.main-nav a::after {
			right: 0.75rem;
			bottom: 0;
			left: 0;
			height: 0.2rem;
			transform: scaleX(0);
			transform-origin: center;
		}

		.main-nav a:hover::after,
		.main-nav a.active::after {
			transform: scaleX(1);
		}

		.search-button {
			min-width: 2.5rem;
			padding: 0.65rem;
		}

		.search-button span,
		.search-button kbd {
			display: none;
		}

		.menu-button {
			display: inline-flex;
		}

		.site-header.is-menu-open .menu-button .menu-icon {
			opacity: 0;
			transform: scale(0.45);
		}

		.site-header.is-menu-open .menu-button .close-icon {
			opacity: 1;
			transform: scale(1);
			transition-delay: 80ms;
		}

		.site-header:not(.is-menu-open) .menu-button .menu-icon {
			transition-delay: 80ms;
		}
	}
</style>
