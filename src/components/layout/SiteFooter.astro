---
import { MessageSquare } from "@lucide/astro";
import { siGithub, siRss } from "simple-icons";
import SimpleIcon from "../shared/SimpleIcon.astro";
---

<footer class="site-footer">
	<a class="footer-action" href="/#comments" aria-label="留言"><img src="/img/logo.svg" alt="Logo" class="footer-logo" width="32" height="37" /></a>
	<div class="footer-brand">
		<p>©2021 - 2026 By 毛哥EM</p>
		<p>原創文章採 <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a> 授權，轉載請註明來源。</p>
	</div>
	<a class="footer-action" href="/#comments" aria-label="留言"><MessageSquare size={21} stroke-width={1.7} /></a>
	<a class="footer-action" href="https://github.com/" aria-label="GitHub"><SimpleIcon icon={siGithub} size={21} /></a>
	<a class="footer-action" href="/rss.xml" aria-label="RSS"><SimpleIcon icon={siRss} size={21} /></a>
</footer>

<style>
	.site-footer {
		display: flex;
		gap: 1rem;
		width: calc(100% + 2.5rem);
		margin: 4rem 0 0 -1.25rem;
		padding-inline: 1rem;
		backdrop-filter: blur(0.75rem);
		border-inline: none;
		margin-bottom: 2rem;
		color: var(--color-muted);
		font-size: 0.75rem;
		border-block: 1px solid var(--color-border);
	}

	.site-footer > * {
		border-inline: 1px solid var(--color-border);
	}

	.footer-logo {
		width: 2rem;
	}

	.footer-brand {
		flex: 1;
		padding: 1.25rem;
		line-height: 1;
	}

	.footer-brand p:first-child {
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 0.75rem;
	}

	.footer-brand a {
		color: var(--color-accent-strong);
		transition: color 160ms ease;
	}

	.footer-action {
		display: grid;
		place-items: center;
		color: var(--color-muted);
		transition:
			color 160ms ease,
			background 160ms ease;
		width: 5rem;
	}

	.footer-action:hover {
		color: var(--color-accent-strong);
		background: var(--color-accent-soft);
	}
</style>
