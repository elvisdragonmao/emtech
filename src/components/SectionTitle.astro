---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	sideLabel?: string;
}

const { eyebrow, title, description, sideLabel } = Astro.props;
---

<section class="section-title">
	{sideLabel && <span class="side-label">{sideLabel}</span>}
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<div class="title-row">
		<h2>{title}</h2>
		{description && <p>{description}</p>}
	</div>
</section>

<style>
	.section-title {
		position: relative;
		width: min(var(--site-width), calc(100% - 2rem));
		margin: 0 auto 1.75rem;
	}

	.eyebrow {
		margin-bottom: 0.5625rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.title-row {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(15rem, 0.7fr);
		align-items: end;
		gap: 2rem;
	}

	h2 {
		max-width: 51.25rem;
		font-size: clamp(2.125rem, 6vw, 4.25rem);
		line-height: 0.96;
		letter-spacing: -0.08em;
		color: var(--color-ink);
	}

	.title-row p {
		max-width: 33.75rem;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-muted);
	}

	.side-label {
		position: absolute;
		top: 0.75rem;
		left: -5.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: var(--color-accent-strong);
		text-transform: uppercase;
		writing-mode: vertical-rl;
	}

	@media (max-width: 56.25rem) {
		.title-row {
			grid-template-columns: 1fr;
			gap: 0.875rem;
		}

		.side-label {
			display: none;
		}
	}
</style>
